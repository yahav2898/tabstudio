<app:AppWindow x:Class="ContactBook.ContactDialog"
               xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Edit Contact" Width="380" SizeToContent="Height" CanResize="False"
               WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:app="using:ContactBook.Porting">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Content="_Name" Target="NameBox"/>
        <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Name}"/>
        <Label Grid.Row="1" Content="_Company" Target="CompanyBox"/>
        <TextBox x:Name="CompanyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Company}"/>
        <TextBlock Grid.Row="2" Text="Email" Padding="5"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Email}"/>
        <TextBlock Grid.Row="3" Text="Phone" Padding="5"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Phone}"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Classes="PrimaryButton"/>
            <Button Content="Cancel" IsCancel="True" Margin="0"/>
        </StackPanel>
    </Grid>
</app:AppWindow>
