<Project>

  <!--
    Central package management: every NuGet version used in the repository is pinned here,
    so all projects agree on one version of each dependency.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <!-- Loads the XAML of Avalonia apps written in TabStudio at run time, for the app preview. -->
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="11.4.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.4" />
  </ItemGroup>

  <ItemGroup Label="Compiler">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.0.0" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.13" />
  </ItemGroup>

  <ItemGroup Label="Packages">
    <!-- NuGet's own version-range and target-framework logic, used by TabStudio.Packages to restore on the device. -->
    <PackageVersion Include="NuGet.Frameworks" Version="6.14.0" />
    <PackageVersion Include="NuGet.Versioning" Version="6.14.0" />
  </ItemGroup>

  <ItemGroup Label="Android">
    <!--
      Avalonia 11 ships with SkiaSharp 2.88, whose native library is not aligned for Android devices with 16 KB
      memory pages (Android 15 and later). The Android head references SkiaSharp 3, which is, as Avalonia
      recommends. Uno and Avalonia use that same version on desktop and in tests as well.
    -->
    <PackageVersion Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup Label="Link">
    <!-- Reads QR codes from camera frames for TabStudio Link pairing, and checks TabStudio's own QR encoder in tests. -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Source control">
    <!-- Reads GitHub Actions workflow files, for the inputs of "Run workflow". Only its representation model is used. -->
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup Label="Databases">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- The 7.0 Unix build contains only managed SNI. 7.1's unified build initializes Windows SNI on Mono. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.3" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Native Skia for libraries using Avalonia alone; the IDE and Uno tests override it to match SkiaSharp 3. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Only referenced so the test runner's tests can compile NUnit and MSTest projects in memory. -->
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup Label="WPF">
    <!-- The interfaces of MSBuild tasks, for running OpenSilver's XAML compiler task inside TabStudio. -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.13.26" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="17.13.26" />
  </ItemGroup>

  <ItemGroup Label="Uno Platform">
    <!-- Uno and Avalonia share SkiaSharp 3 and the matching HarfBuzz runtime. -->
    <PackageVersion Include="HarfBuzzSharp" Version="8.3.1.1" />
  </ItemGroup>

</Project>
