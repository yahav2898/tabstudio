+/* Linux permits waiting for ptracees owned by a sibling thread unless
+ * __WNOTHREAD is set. Ptrace requests themselves remain thread-specific. */
+static bool can_wait_for(const Tracee *waiter, const Tracee *owner, word_t options)
+{
+	return owner != NULL && (waiter == owner
+		|| (!(options & __WNOTHREAD) && waiter->tgid == owner->tgid));
+}
+
+/* Find a blocked waiter without changing which thread owns the ptracee. */
+Tracee *get_waiting_ptracer(const Tracee *ptracee)
+{
+	Tracee *waiter;
+	LIST_FOREACH(waiter, &tracees, link) {
+		if (waiter->as_ptracer.wait_pid != -1 && waiter->as_ptracer.wait_pid != ptracee->pid)
+			continue;
+		if (can_wait_for(waiter, ptracee->as_ptracee.ptracer, waiter->as_ptracer.wait_options)
+		    && EXPECTED_WAIT_CLONE(waiter->as_ptracer.wait_options, ptracee))
+			return waiter;
+	}
+	return NULL;
 }
 
