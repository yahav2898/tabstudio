# The runtime environment of the GC stress workflow's "serial" build (.github/workflows/gc-stress.yml): Mono's
# mark-and-sweep collector (SGen) without its concurrent mark, verifying the whole heap after every major collection.
# Next to the concurrent build it tells a broken heap (both builds fail) from a bug of the concurrent collector
# (only the concurrent one fails).
#
# Build it yourself with:
#   dotnet publish src/TabStudio.Android -c Release -f net10.0-android -p:TabStudioAndroidEnvironment=build/android/gc-stress/serial.env
#
# A 1 MB nursery (the default is 4 MB) makes minor collections, promotions and major collections more frequent.
MONO_GC_PARAMS=major=marksweep,nursery-size=1m

# check-mark-bits  after marking, before sweeping, every reference from a live object must point to an object that
#                  is marked live: a reference the collector cannot see, a dangling one, or a broken object header
#                  aborts there, before anything is freed.
# clear-at-gc      clears the nursery at each collection, so a stale pointer reads zeros.
MONO_GC_DEBUG=check-mark-bits,clear-at-gc
