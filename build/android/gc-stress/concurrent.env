# The runtime environment of the GC stress workflow's "concurrent" build (.github/workflows/gc-stress.yml): the
# garbage collector release builds use, Mono's concurrent mark-and-sweep (SGen), checking its own work while the
# self test runs, so a broken heap is caught where it breaks with a message naming the check, instead of as a
# random abort much later.
#
# Build it yourself with:
#   dotnet publish src/TabStudio.Android -c Release -f net10.0-android -p:TabStudioAndroidEnvironment=build/android/gc-stress/concurrent.env
#
# MONO_GC_PARAMS replaces the SDK's default (major=marksweep-conc, from AndroidEnableSGenConcurrent), so the major
# collector is named again. A 1 MB nursery (the default is 4 MB) makes minor collections four times as frequent,
# and with them promotions and the concurrent major collections that mark beside the app's own threads.
MONO_GC_PARAMS=major=marksweep-conc,nursery-size=1m

# check-concurrent             checks the nursery around every concurrent collection, and clears it at each one.
# mod-union-consistency-check  before a concurrent collection finishes, every reference stored into an object the
#                              collector already marked must be in its mod-union cards, or it would be missed;
#                              a failure names the object's class and the reference's offset.
# clear-at-gc                  clears the nursery at each collection, so a stale pointer reads zeros.
# (check-mark-bits is in serial.env: with the concurrent collector it aborts at the first major collection on its
# own, because the nursery's pins are cleared before it asserts they are set. verify-before-collections searches
# the heap's blocks linearly for every reference, hours for an IDE's heap. xdomain-checks no longer exists.)
MONO_GC_DEBUG=check-concurrent,mod-union-consistency-check,clear-at-gc
