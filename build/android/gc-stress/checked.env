# The runtime environment of the GC stress workflow's "checked" build (.github/workflows/gc-stress.yml): the
# collector TabStudio ships with, Mono's mark-and-sweep (SGen) marking while the app is stopped (see
# AndroidEnableSGenConcurrent in src/TabStudio.Android/TabStudio.Android.csproj), verifying the whole heap after
# every major collection while the self test runs, so a broken heap aborts where it breaks, with a message naming
# the check, instead of as a random crash much later.
#
# Build it yourself with:
#   dotnet publish src/TabStudio.Android -c Release -f net10.0-android -p:TabStudioAndroidEnvironment=build/android/gc-stress/checked.env
#
# MONO_GC_PARAMS replaces the SDK's default, so the major collector is named again. A 1 MB nursery (the default is
# 4 MB) makes minor collections four times as frequent, and with them promotions and major collections.
MONO_GC_PARAMS=major=marksweep,nursery-size=1m

# check-mark-bits  after marking, before sweeping, every reference from a live object must point to an object that
#                  is marked live: a reference the collector cannot see, a dangling one, or a broken object header
#                  aborts there, before anything is freed.
# clear-at-gc      clears the nursery at each collection, so a stale pointer reads zeros.
# (verify-before-collections searches the heap's blocks linearly for every reference: hours for an IDE's heap.
# xdomain-checks no longer exists in .NET's Mono.)
MONO_GC_DEBUG=check-mark-bits,clear-at-gc
