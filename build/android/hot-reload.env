# Read by Android's native host BEFORE Mono starts, including release-packaged IDEs running user Debug apps.
DOTNET_MODIFIABLE_ASSEMBLIES=debug
# Use the interpreter's debugger mode (no optimizations). The optimized Mono 10 interpreter corrupts scalar
# PIDs across GC between native spawn and handle construction; post-update process stress guards this boundary.
MONO_INTERPRETER_OPTIONS=-all
