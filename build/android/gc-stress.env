# The runtime environment of the GC stress build (.github/workflows/gc-stress.yml): Mono's garbage collector
# (SGen) checks its own heap while the self test runs, so heap corruption is caught soon after it happens,
# with a message that names the check, instead of as a random abort much later.
#
# Build it yourself with:
#   dotnet publish src/TabStudio.Android -c Release -f net10.0-android -p:TabStudioAndroidEnvironment=build/android/gc-stress.env
#
# MONO_GC_PARAMS replaces the SDK's default (major=marksweep-conc, from AndroidEnableSGenConcurrent), so the
# major collector is named again: the concurrent mark-and-sweep collector that release builds use.
# A 1 MB nursery (the default is 4 MB) makes minor collections four times as frequent, and with them promotions
# and the concurrent major collections that run beside the app's own threads.
MONO_GC_PARAMS=major=marksweep-conc,nursery-size=1m

# check-mark-bits             after every major collection, every reference from a live object must point to
#                             an object that is marked live: catches broken references, vtables and array lengths.
# check-concurrent            checks the nursery around every concurrent collection (and clears it at each GC).
# mod-union-consistency-check every reference stored during a concurrent mark must be in the mod-union cards.
# clear-at-gc                 clears the nursery at each collection, so a stale pointer reads zeros.
# (verify-before-collections checks every reference before every collection by searching the heap's blocks
# linearly: hours for an IDE's heap, so it is left out. xdomain-checks no longer exists in .NET's Mono.)
MONO_GC_DEBUG=check-mark-bits,check-concurrent,mod-union-consistency-check,clear-at-gc

# One line per collection in logcat (GC_MINOR, GC_MAJOR_CONCURRENT_START, ...), to see what the collector was
# doing when a check failed.
MONO_LOG_LEVEL=debug
MONO_LOG_MASK=gc
