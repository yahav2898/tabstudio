# With -p:GcBridgeRaceChecks=true: the default concurrent collector, checking before each concurrent collection
# finishes that every reference stored into an object it already marked has its mod-union card. The race shows as
# "major->major reference ... not found in remsets", naming the object's class.
MONO_GC_PARAMS=major=marksweep-conc
MONO_GC_DEBUG=mod-union-consistency-check
