<Window x:Class="SpikeWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spike WPF" Width="560" Height="400" Left="16" Top="16" WindowStartupLocation="Manual">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ClickButton" Content="Click me" Width="180" Height="48" Click="OnClick" />
            <Button x:Name="OpenButton" Content="Open a window" Width="180" Height="48" Margin="16,0,0,0" Click="OnOpen" />
        </StackPanel>
        <TextBlock x:Name="Status" Grid.Row="1" Text="Not clicked yet" FontSize="20" Margin="0,16,0,0" Foreground="{StaticResource Accent}" />
        <Canvas Grid.Row="2" x:Name="Stage" Background="White" Margin="0,16,0,0">
            <Rectangle x:Name="Spinner" Width="80" Height="80" Fill="SteelBlue" Canvas.Left="40" Canvas.Top="30" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="Rotation" Angle="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
    </Grid>
</Window>
