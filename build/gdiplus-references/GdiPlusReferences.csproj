<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Draws the reference pictures of the Forms layer's drawing tests with GDI+ itself, on Windows: the scenes in
    tests/TabStudio.Forms.Tests/Drawing/DrawingScenes.cs, compiled here against System.Drawing. See README.md.
    Not part of the solution: it only builds on Windows.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\TabStudio.Forms.Tests\Drawing\DrawingScenes.cs" Link="DrawingScenes.cs" />
  </ItemGroup>

</Project>
