<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows Forms designer: reads a form's Form1.Designer.cs or Form1.Designer.vb with Roslyn, builds the form from
    it on a design surface without running any of the app's code, and writes the InitializeComponent the changes make
    back as Visual Studio does, in C# or Visual Basic. Its canvas is an Avalonia control the IDE hosts with the toolbox
    and the properties.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TabStudio.Forms.Design</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabStudio.Forms\TabStudio.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabStudio.Forms.Design.Tests" />
    <InternalsVisibleTo Include="TabStudio.App" />
    <InternalsVisibleTo Include="TabStudio.App.Tests" />
  </ItemGroup>

</Project>
