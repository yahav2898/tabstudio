<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TabStudio.Debugging</RootNamespace>
    <Description>The TabStudio debugger: instruments C# and Visual Basic programs so they can be paused, stepped and inspected while they run inside the IDE.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabStudio.Core\TabStudio.Core.csproj" />
    <ProjectReference Include="..\TabStudio.Compilation\TabStudio.Compilation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabStudio.Debugging.Tests" />
    <!-- Live Unit Testing instruments for coverage in the same way, with its own hooks. -->
    <InternalsVisibleTo Include="TabStudio.LiveTesting" />
  </ItemGroup>

</Project>
