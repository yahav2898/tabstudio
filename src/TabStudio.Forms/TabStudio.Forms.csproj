<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TabStudio's cross-platform Windows Forms layer: the System.Windows.Forms and System.Drawing API that Windows Forms
    apps use, implemented on Avalonia, so a WinForms project runs on the tablet in the app preview and its forms open
    in the touch designer. See README.md for what it supports.

    WinForms projects compile against this assembly's reference assembly, which TabStudio.App embeds.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <Description>A cross-platform Windows Forms layer on Avalonia: forms, controls, layout, painting and a message loop of their own.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Shapes are drawn with Skia, through Avalonia's Skia renderer, on windows and on bitmaps alike. -->
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <!-- The IDE hosts the runtime, and the designer draws forms, through the layer's internals, which apps never see. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TabStudio.Forms.Tests" />
    <InternalsVisibleTo Include="TabStudio.Forms.Design" />
    <InternalsVisibleTo Include="TabStudio.Forms.Design.Tests" />
    <InternalsVisibleTo Include="TabStudio.App" />
    <InternalsVisibleTo Include="TabStudio.App.Tests" />
    <!-- TabStudio's Microsoft.VisualBasic.Forms runs Visual Basic's application framework, MsgBox and InputBox on the
         app's UI thread, which it finds through the runtime. -->
    <InternalsVisibleTo Include="Microsoft.VisualBasic.Forms" />
    <InternalsVisibleTo Include="TabStudio.VisualBasic.Forms.Tests" />
  </ItemGroup>

</Project>
