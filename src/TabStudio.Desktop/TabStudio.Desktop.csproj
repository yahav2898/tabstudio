<Project Sdk="Microsoft.NET.Sdk">

  <!-- A desktop window around the IDE, so contributors can work on TabStudio from any computer. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TabStudio.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" VersionOverride="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabStudio.App\TabStudio.App.csproj" />
    <ProjectReference Include="..\TabStudio.WindowsBridge.Windows\TabStudio.WindowsBridge.Windows.csproj" />
  </ItemGroup>

</Project>
