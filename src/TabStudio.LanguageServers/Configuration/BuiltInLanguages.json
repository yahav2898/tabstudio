{
  "languages": {
    "dart": {
      "name": "Dart",
      "extensions": [
        ".dart"
      ]
    },
    "python": {
      "name": "Python",
      "extensions": [
        ".py",
        ".pyi",
        ".pyw"
      ]
    },
    "typescript": {
      "name": "TypeScript",
      "extensions": [
        ".ts",
        ".mts",
        ".cts"
      ]
    },
    "typescriptreact": {
      "name": "TypeScript React",
      "extensions": [
        ".tsx"
      ]
    },
    "javascript": {
      "name": "JavaScript",
      "extensions": [
        ".js",
        ".mjs",
        ".cjs"
      ]
    },
    "javascriptreact": {
      "name": "JavaScript React",
      "extensions": [
        ".jsx"
      ]
    },
    "c": {
      "name": "C",
      "extensions": [
        ".c",
        ".h"
      ]
    },
    "cpp": {
      "name": "C++",
      "extensions": [
        ".cpp",
        ".cc",
        ".cxx",
        ".c++",
        ".hpp",
        ".hh",
        ".hxx",
        ".h++",
        ".ipp",
        ".inl"
      ]
    },
    "rust": {
      "name": "Rust",
      "extensions": [
        ".rs"
      ]
    },
    "go": {
      "name": "Go",
      "extensions": [
        ".go"
      ]
    },
    "java": {
      "name": "Java",
      "extensions": [
        ".java"
      ]
    },
    "html": {
      "name": "HTML",
      "extensions": [
        ".html",
        ".htm"
      ]
    },
    "css": {
      "name": "CSS",
      "extensions": [
        ".css"
      ]
    },
    "scss": {
      "name": "SCSS",
      "extensions": [
        ".scss"
      ]
    },
    "less": {
      "name": "Less",
      "extensions": [
        ".less"
      ]
    },
    "jsonc": {
      "name": "JSON",
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "kotlin": {
      "name": "Kotlin",
      "extensions": [
        ".kt",
        ".kts"
      ]
    },
    "php": {
      "name": "PHP",
      "extensions": [
        ".php",
        ".phtml"
      ]
    },
    "swift": {
      "name": "Swift",
      "extensions": [
        ".swift"
      ]
    }
  },
  "languageServers": {
    "dart-analysis-server": {
      "name": "Dart analysis server",
      "languages": [
        "dart"
      ],
      "command": "dart",
      "args": [
        "language-server",
        "--protocol=lsp"
      ],
      "package": "dart-analysis-server",
      "rootMarkers": [
        "pubspec.yaml",
        "analysis_options.yaml"
      ]
    },
    "pyright": {
      "name": "Pyright",
      "languages": [
        "python"
      ],
      "command": "pyright-langserver",
      "args": [
        "--stdio"
      ],
      "package": "pyright",
      "rootMarkers": [
        "pyproject.toml",
        "pyrightconfig.json",
        "setup.py",
        "setup.cfg",
        "requirements.txt",
        "Pipfile"
      ],
      "settings": {
        "python": {
          "analysis": {
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
            "diagnosticMode": "openFilesOnly"
          }
        }
      }
    },
    "typescript-language-server": {
      "name": "TypeScript",
      "languages": [
        "typescript",
        "typescriptreact",
        "javascript",
        "javascriptreact"
      ],
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "package": "typescript-language-server",
      "rootMarkers": [
        "tsconfig.json",
        "jsconfig.json",
        "package.json"
      ],
      "initializationOptions": {
        "tsserver": {
          "path": "${packageFile:typescript/lib/tsserver.js}"
        },
        "preferences": {
          "includeInlayParameterNameHints": "literals",
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayVariableTypeHints": false,
          "includeCompletionsWithSnippetText": true,
          "includeCompletionsForModuleExports": true
        }
      },
      "settings": {
        "typescript": {
          "inlayHints": {
            "includeInlayParameterNameHints": "literals",
            "includeInlayFunctionLikeReturnTypeHints": true
          }
        },
        "javascript": {
          "inlayHints": {
            "includeInlayParameterNameHints": "literals",
            "includeInlayFunctionLikeReturnTypeHints": true
          }
        }
      }
    },
    "clangd": {
      "name": "clangd",
      "languages": [
        "c",
        "cpp"
      ],
      "command": "clangd",
      "args": [
        "--background-index",
        "--header-insertion=never"
      ],
      "package": "clangd",
      "rootMarkers": [
        "compile_commands.json",
        "compile_flags.txt",
        ".clangd",
        "CMakeLists.txt",
        "Makefile"
      ]
    },
    "rust-analyzer": {
      "name": "rust-analyzer",
      "languages": [
        "rust"
      ],
      "command": "rust-analyzer",
      "package": "rust-analyzer",
      "rootMarkers": [
        "Cargo.toml"
      ]
    },
    "gopls": {
      "name": "gopls",
      "languages": [
        "go"
      ],
      "command": "gopls",
      "package": "gopls",
      "rootMarkers": [
        "go.work",
        "go.mod"
      ]
    },
    "jdtls": {
      "name": "Eclipse JDT",
      "languages": [
        "java"
      ],
      "command": "jdtls",
      "args": [
        "-data",
        "${serverStorage}"
      ],
      "initializationOptions": {
        "bundles": [
          "${env:TABSTUDIO_JAVA_DEBUG_BUNDLE:/opt/tabstudio/java/java-debug/extension/server/com.microsoft.java.debug.plugin-0.53.2.jar}"
        ]
      },
      "package": "jdtls",
      "clientProcessId": false,
      "rootMarkers": [
        "pom.xml",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        ".project",
        "settings.gradle.kts"
      ]
    },
    "vscode-html-language-server": {
      "name": "HTML Language Server",
      "languages": [
        "html"
      ],
      "command": "vscode-html-language-server",
      "args": [
        "--stdio"
      ],
      "package": "vscode-html-language-server",
      "initializationOptions": {
        "provideFormatter": true,
        "embeddedLanguages": {
          "css": true,
          "javascript": true
        }
      },
      "settings": {
        "html": {
          "validate": {
            "styles": true,
            "scripts": true
          }
        },
        "css": {
          "validate": true
        }
      }
    },
    "vscode-css-language-server": {
      "name": "CSS Language Server",
      "languages": [
        "css",
        "scss",
        "less"
      ],
      "command": "vscode-css-language-server",
      "args": [
        "--stdio"
      ],
      "package": "vscode-css-language-server",
      "initializationOptions": {
        "provideFormatter": true
      },
      "settings": {
        "css": {
          "validate": true
        },
        "scss": {
          "validate": true
        },
        "less": {
          "validate": true
        }
      }
    },
    "vscode-json-language-server": {
      "name": "JSON Language Server",
      "languages": [
        "jsonc"
      ],
      "command": "vscode-json-language-server",
      "args": [
        "--stdio"
      ],
      "package": "vscode-json-language-server",
      "initializationOptions": {
        "provideFormatter": true
      },
      "settings": {
        "json": {
          "validate": {
            "enable": true
          }
        }
      }
    },
    "kotlin-lsp": {
      "name": "Kotlin by JetBrains",
      "languages": [
        "kotlin"
      ],
      "command": "kotlin-lsp",
      "args": [
        "--stdio"
      ],
      "package": "kotlin-lsp",
      "rootMarkers": [
        "settings.gradle.kts",
        "settings.gradle",
        "build.gradle.kts",
        "build.gradle",
        "pom.xml"
      ]
    },
    "kotlin-language-server": {
      "name": "Kotlin language server",
      "languages": [
        "kotlin"
      ],
      "command": "kotlin-language-server",
      "package": "kotlin-language-server",
      "rootMarkers": [
        "settings.gradle.kts",
        "settings.gradle",
        "build.gradle.kts",
        "build.gradle"
      ]
    },
    "phpactor": {
      "name": "Phpactor",
      "languages": [
        "php"
      ],
      "command": "phpactor",
      "args": [
        "language-server"
      ],
      "package": "phpactor",
      "rootMarkers": [
        "composer.json"
      ],
      "initializationOptions": {
        "language_server_phpstan.enabled": false,
        "language_server_psalm.enabled": false,
        "indexer.exclude_patterns": [
          "/vendor/**/Tests/**/*",
          "/vendor/**/tests/**/*",
          "/node_modules/**/*",
          "/storage/**/*"
        ]
      }
    },
    "sourcekit-lsp": {
      "name": "SourceKit-LSP",
      "languages": [
        "swift"
      ],
      "command": "sourcekit-lsp",
      "package": "sourcekit-lsp",
      "rootMarkers": [
        "Package.swift"
      ]
    }
  },
  "debugAdapters": {
    "java": {
      "name": "Java (java-debug)",
      "languages": [
        "java",
        "kotlin"
      ],
      "command": "jdtls",
      "package": "java-debug",
      "terminalDefaults": {
        "console": "integratedTerminal"
      }
    },
    "flutter": {
      "name": "Flutter",
      "languages": [
        "dart"
      ],
      "command": "flutter",
      "args": [
        "debug-adapter"
      ],
      "package": "flutter-dap"
    },
    "dart": {
      "name": "Dart",
      "languages": [
        "dart"
      ],
      "command": "dart",
      "args": [
        "debug_adapter"
      ],
      "package": "flutter-dap"
    },
    "debugpy": {
      "name": "Python (debugpy)",
      "aliases": [
        "python"
      ],
      "languages": [
        "python"
      ],
      "command": "python3",
      "alternativeCommands": [
        "python"
      ],
      "args": [
        "-m",
        "debugpy.adapter"
      ],
      "package": "debugpy",
      "defaults": {
        "console": "internalConsole",
        "justMyCode": true,
        "redirectOutput": true,
        "showReturnValue": true
      },
      "terminalDefaults": {
        "console": "integratedTerminal",
        "redirectOutput": false
      }
    },
    "lldb-dap": {
      "name": "LLDB",
      "aliases": [
        "lldb",
        "lldb-vscode"
      ],
      "languages": [
        "c",
        "cpp",
        "rust",
        "swift"
      ],
      "command": "lldb-dap",
      "alternativeCommands": [
        "lldb-vscode"
      ],
      "package": "lldb-dap"
    },
    "go": {
      "name": "Delve",
      "aliases": [
        "dlv"
      ],
      "languages": [
        "go"
      ],
      "command": "dlv",
      "args": [
        "dap",
        "--listen",
        "127.0.0.1:${port}"
      ],
      "transport": "tcp",
      "package": "delve",
      "usesProcessInput": true,
      "defaults": {
        "outputMode": "remote"
      }
    },
    "pwa-node": {
      "name": "Node.js (js-debug)",
      "aliases": [
        "node"
      ],
      "languages": [
        "javascript",
        "typescript"
      ],
      "command": "js-debug-adapter",
      "args": [
        "${port}",
        "127.0.0.1"
      ],
      "transport": "tcp",
      "package": "js-debug",
      "defaults": {
        "console": "internalConsole",
        "sourceMaps": true
      },
      "terminalDefaults": {
        "console": "integratedTerminal"
      }
    },
    "embedded-probe-rs": {
      "name": "On-chip probe-rs",
      "languages": [],
      "command": "probe-rs",
      "args": [
        "dap-server"
      ],
      "package": "probe-rs"
    },
    "embedded-gdb": {
      "name": "On-chip GDB (OpenOCD)",
      "languages": [],
      "command": "gdb-multiarch",
      "args": [
        "--quiet",
        "--nx",
        "--interpreter=dap"
      ],
      "package": "embedded-debug"
    },
    "gpsim": {
      "name": "PIC18 simulator (gpsim)",
      "languages": [
        "c"
      ],
      "command": "python3",
      "args": [
        "/opt/tabstudio/microchip/gpsim_dap.py"
      ],
      "package": "gpsim",
      "defaults": {
        "stopOnEntry": true
      }
    },
    "php": {
      "name": "PHP (Xdebug)",
      "languages": [
        "php"
      ],
      "command": "php-debug-adapter",
      "package": "php-debug"
    }
  }
}
