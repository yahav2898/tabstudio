        "transport": "tcp",
        "type": "pwa-node",
        "languages": [ "javascript", "typescript" ]
      },
      "problemPatterns": [
        { "pattern": "\\((?<file>/[^()]+?):(?<line>\\d+):(?<column>\\d+)\\)" },
