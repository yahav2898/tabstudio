      "host": { "commands": [ "python3", "python" ], "versionArguments": [ "--version" ], "versionPattern": "Python (?<version>\\S+)" },
      "fileExtensions": [ ".py", ".pyw" ],
      "projectFiles": [ "pyproject.toml", "requirements.txt", "setup.py", "Pipfile" ],
      "run": {
        "file": [ "{python}", "-u", "{file}" ],
        "entries": [
          { "file": "__main__.py", "command": [ "{python}", "-u", "__main__.py" ] },
          { "file": "main.py", "command": [ "{python}", "-u", "main.py" ] },
          { "file": "app.py", "command": [ "{python}", "-u", "app.py" ] }
        ],
        "environment": { "PYTHONUNBUFFERED": "1", "PYTHONIOENCODING": "utf-8", "PIP_ROOT_USER_ACTION": "ignore" }
      },
      "projectEnvironment": {
        "directory": ".venv",
        "create": [ "python3", "-m", "venv", ".venv" ],
        "variables": { "python": ".venv/bin/python" },
        "defaults": { "python": "python3" },
        "path": ".venv/bin"
      },
      "dependencies": [
        {
          "manifest": "requirements.txt",
          "name": "pip install -r requirements.txt",
          "description": "Installs the packages requirements.txt lists into the project's virtual environment, .venv.",
          "command": [ ".venv/bin/python", "-m", "pip", "install", "--disable-pip-version-check", "-r", "requirements.txt" ],
          "installed": ".venv"
        },
        {
          "manifest": "pyproject.toml",
          "name": "pip install -e .",
          "description": "Installs the project and its dependencies from pyproject.toml into .venv, in editable mode.",
          "command": [ ".venv/bin/python", "-m", "pip", "install", "--disable-pip-version-check", "-e", "." ],
          "installed": ".venv"
        }
      ],
      "setup": [
        {
          "name": "debugpy",
          "description": "The debug adapter for Python, from its universal wheel.",
          "archive": {
            "url": "https://files.pythonhosted.org/packages/56/3d/c7dc9f35bc9e22cdb53679f844bee40fd5cff871862f60595869a433400d/debugpy-1.8.22-py2.py3-none-any.whl",
            "sha256": "a9e9d3550e15ca479c59333e90845029190531f0cacfedab3b815a57bd913947",
            "size": 5374857,
            "destination": "/opt/tabstudio/python/debugpy"
          }
        }
      ],
      "languageServer": { "command": [ "pylsp" ], "languages": [ "python" ] },
