            "path": "/opt/tabstudio/android/setup-sdk",
            "content": "#!/bin/sh\nset -eu\nsdk=/opt/tabstudio/android/sdk\nmkdir -p \"$sdk/cmdline-tools\" \"$sdk/platforms\" \"$sdk/build-tools\"\nrm -rf \"$sdk/cmdline-tools/latest\" \"$sdk/platforms/android-35\" \"$sdk/build-tools/35.0.0\"\ncp -a /opt/tabstudio/android/commandline/cmdline-tools \"$sdk/cmdline-tools/latest\"\ncp -a /opt/tabstudio/android/platform/* \"$sdk/platforms/android-35\"\ncp -a /opt/tabstudio/android/buildtools/* \"$sdk/build-tools/35.0.0\"\n# Replace every native SDK executable that Gradle uses; d8 and apksigner run on the JVM.\nif [ -d /opt/tabstudio/android/native/build-tools ]; then\n  for tool in aapt aapt2 aidl zipalign dexdump split-select; do\n    [ ! -f \"/opt/tabstudio/android/native/build-tools/$tool\" ] || cp \"/opt/tabstudio/android/native/build-tools/$tool\" \"$sdk/build-tools/35.0.0/$tool\"\n  done\nfi\nchmod +x \"$sdk\"/cmdline-tools/latest/bin/* \"$sdk\"/build-tools/35.0.0/* 2>/dev/null || true\nchmod +x /opt/tabstudio/android/gradle/gradle-8.9/bin/gradle\n# This command runs only after the Store has shown Google's SDK license and the user accepts it.\nyes | \"$sdk/cmdline-tools/latest/bin/sdkmanager\" --sdk_root=\"$sdk\" --licenses >/dev/null\n\"$sdk/build-tools/35.0.0/aapt2\" version\njava -cp \"$sdk/build-tools/35.0.0/lib/d8.jar\" com.android.tools.r8.D8 --version\n",
            "executable": true
