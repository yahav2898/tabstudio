      "aarch64": { "file": "alpine-minirootfs-3.24.3-aarch64.tar.gz", "sha256": "4d3f80afaebd447c5591a63a73bde380a149fe8b2d85488cafabb2ff97551f50", "size": 4029999 },
      "armv7": { "file": "alpine-minirootfs-3.24.3-armv7.tar.gz", "sha256": "dc1ddfaf03ede4be79ad7475490f6b7859dbcbbbbb85150aa1ee013b4bc2f0c1", "size": 3183009 }
