<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Android app: the activity, manifest, launcher icon, splash screen and signing around TabStudio's
    Avalonia UI. Build it with:

      dotnet publish src/TabStudio.Android -c Release -f net10.0-android

    The IDE itself lives in TabStudio.App; this project only adds what is Android's: the activity, device
    status (memory, thermal state, memory pressure) and packaging.
  -->

  <PropertyGroup Label="Android">
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>TabStudio.Android</RootNamespace>
    <!-- Android 9. Keeps entry-level and school tablets in, see the README's requirements. -->
    <SupportedOSPlatformVersion>28</SupportedOSPlatformVersion>
    <!--
      64-bit and 32-bit ARM, including 32-bit Android on a 64-bit chip. For an x86_64 emulator, build with
      -p:TabStudioRuntimeIdentifiers=android-x64: overriding RuntimeIdentifiers itself on the command line would
      also apply it to the referenced libraries and break their build.
    -->
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(TabStudioRuntimeIdentifiers)' != ''">$(TabStudioRuntimeIdentifiers)</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Set at build time as well: SqlClient has linker substitutions for this feature switch. -->
    <RuntimeHostConfigurationOption Include="Switch.Microsoft.Data.SqlClient.UseManagedNetworkingOnWindows" Value="true" />
  </ItemGroup>

  <PropertyGroup Label="Identity">
    <ApplicationId>com.tabstudio.ide</ApplicationId>
    <ApplicationTitle>TabStudio</ApplicationTitle>
    <!-- versionName follows the repository version in Directory.Build.props. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!--
      versionCode must never go down between builds a device should accept as updates. CI passes the minutes
      since 2026-01-01 (-p:TabStudioBuildNumber=...), so every nightly and release is newer than the builds
      before it; local builds are 1.
    -->
    <TabStudioBuildNumber Condition="'$(TabStudioBuildNumber)' == ''">1</TabStudioBuildNumber>
    <ApplicationVersion>$(TabStudioBuildNumber)</ApplicationVersion>
  </PropertyGroup>

  <PropertyGroup Label="Runtime">
    <!-- Keep the IDE, Roslyn and editor on Mono's JIT. The Android SDK's interpreter switch replaces the
         JIT globally; there is no supported per-user-assembly interpreter setting in this SDK. -->
    <AndroidUseInterpreter>false</AndroidUseInterpreter>
    <AndroidUseInterpreter Condition="'$(TabStudioInterpreterBenchmark)' == 'true'">true</AndroidUseInterpreter>
    <!--
      Roslyn composes its services with MEF and the programs TabStudio runs bind to the framework by reflection,
      so nothing may be trimmed away. Mono AOT is off for now: it multiplies build time and APK size, and
      startup is not yet the bottleneck.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- The IDE is in English; leaving out Roslyn's and the framework's translations saves megabytes. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Android creates the activity through a Java callable wrapper, so the head's entry types stay public. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!--
      Mono's garbage collector marks the major heap on its own thread unless this is off, and that concurrent mark
      races with the Java GC bridge in .NET 10's runtime: while a minor collection runs the Tarjan bridge, the
      bridge tags the header of every object it walks (in a minor collection that is everything reachable from a
      dead Java peer, here most of the IDE's heap), and two places in the concurrent mark read such a header
      without untagging it. They then treat a large array as a small object, read a block header that does not
      exist and lose or misplace mark and card bits, which frees arrays still in use. On a tablet that is a random
      abort in the collector ("How can an object and a reference inside it not be in the same block?", a broken
      free chunk map in sgen-los.c, or SIGSEGV on the SGen worker thread). The serial collector marks while the
      app is stopped, after the bridge has restored every header. The GC stress workflow (.github/workflows/
      gc-stress.yml) reproduces the race with build/android/gc-stress/concurrent.env; turn this back on once the
      runtime untags those headers.
    -->
    <AndroidEnableSGenConcurrent>false</AndroidEnableSGenConcurrent>
  </PropertyGroup>

  <!-- The old global interpreter configuration is retained only for the controlled CI comparison. -->
  <ItemGroup Condition="'$(TabStudioInterpreterBenchmark)' == 'true'">
    <AndroidEnvironment Include="..\..\build\android\hot-reload.env" />
  </ItemGroup>

  <!--
    Release builds are signed with the repository's development key, so every build, local or CI, has the
    same signature and installs as an update over the previous one.

    This key is PUBLIC on purpose: the keystore and its password are committed so anyone can reproduce the
    nightly build. It proves nothing about who built an APK. A store release must be signed with a private
    key kept out of the repository (pass AndroidSigningKeyStore and the passwords on the command line).
  -->
  <PropertyGroup Label="Signing" Condition="'$(Configuration)' == 'Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'build', 'android', 'tabstudio-dev.keystore'))</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>tabstudio</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>tabstudio-dev</AndroidSigningKeyPass>
    <AndroidSigningStorePass>tabstudio-dev</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The Android SDK's implicit usings import Android.App and Android.Widget everywhere, whose Application and
      Orientation clash with Avalonia's. Files that need Android APIs import them explicitly.
    -->
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <!-- 16 KB page-aligned native Skia; see Directory.Packages.props. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabStudio.App\TabStudio.App.csproj" />
  </ItemGroup>

  <!-- PRoot and its loader, which run toolchains; see the file. -->
  <Import Project="Toolchains.targets" />

  <!--
    Extra environment variables for the runtime, for diagnostic builds only: the GC stress workflow
    (.github/workflows/gc-stress.yml) builds with -p:TabStudioAndroidEnvironment=build/android/gc-stress/checked.env
    (or concurrent.env) so that Mono checks its heap while the self test runs. Release builds pass nothing.
  -->
  <ItemGroup Condition="'$(TabStudioAndroidEnvironment)' != ''">
    <AndroidEnvironment Include="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', '$(TabStudioAndroidEnvironment)'))" />
  </ItemGroup>

</Project>
