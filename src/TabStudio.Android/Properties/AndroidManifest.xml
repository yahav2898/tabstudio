<?xml version="1.0" encoding="utf-8"?>
<!--
  The parts of the manifest that are not generated. The build adds the package name, versions and label from
  the project file, and the activity from MainActivity's [Activity] attribute.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Downloads, Git remotes, the agent and TabStudio Link. Everything else works offline. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!--
    TabStudio Link: the camera scans a host's QR code, asked for only when the user taps Scan. Devices without a
    camera install too, and pair by typing the code.
  -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera.any" android:required="false" />

  <!-- The network security config lets the web preview load apps served on the device over plain HTTP. -->
  <application
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:networkSecurityConfig="@xml/network_security_config"
    android:supportsRtl="true" />
</manifest>
