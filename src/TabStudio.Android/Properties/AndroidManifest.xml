<?xml version="1.0" encoding="utf-8"?>
<!--
  The parts of the manifest that are not generated. The build adds the package name, versions and label from
  the project file, and the activity from MainActivity's [Activity] attribute.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Downloads, Git remotes, the agent and TabStudio Link. Everything else works offline. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Notifications when a GitHub Actions run finishes; Android 13 and later ask the user the first time. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!--
    Long operations (toolchain installs, builds, project setup, downloads) run in a data-sync foreground service, with
    their progress in its notification, so they finish while TabStudio is in the background; a partial wake lock keeps
    the processor on while the screen is off.
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- User-built APKs are installed through a session with Android's normal confirmation. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Find the launch activity of a newly installed app under Android 11+ package visibility rules. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <!--
    TabStudio Link: the camera scans a host's QR code, asked for only when the user taps Scan. Devices without a
    camera install too, and pair by typing the code.
  -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera.any" android:required="false" />
  <uses-feature android:name="android.hardware.usb.host" android:required="false" />

  <!-- The network security config lets the web preview load apps served on the device over plain HTTP. -->
  <!--
    extractNativeLibs: the toolchain runtime (PRoot) is executed from the native library folder, the one place
    Android lets an app execute files from, so the installer must extract the APK's libraries there.
  -->
  <application
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:networkSecurityConfig="@xml/network_security_config"
    android:fullBackupContent="@xml/backup_rules"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:extractNativeLibs="true"
    android:supportsRtl="true" />
</manifest>
