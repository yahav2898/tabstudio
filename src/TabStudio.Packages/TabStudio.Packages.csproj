<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TabStudio.Packages</RootNamespace>
    <Description>NuGet restore on the device: resolves package references the way NuGet does, downloads them from V3 feeds or local folders and selects the assemblies a project compiles and runs with. Needs neither MSBuild nor the .NET SDK.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Frameworks" />
    <PackageReference Include="NuGet.Versioning" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabStudio.Core\TabStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabStudio.Packages.Tests" />
  </ItemGroup>

</Project>
