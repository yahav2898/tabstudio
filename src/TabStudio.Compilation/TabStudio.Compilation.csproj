<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TabStudio.Compilation</RootNamespace>
    <Description>Roslyn inside TabStudio: live diagnostics, in-memory compilation and running programs on the device.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" />
  </ItemGroup>

  <!--
    The Razor compiler of the .NET SDK 10.0.1xx, built against the Roslyn version above. No stable NuGet package
    carries it, so the SDK's own build lives in the repository; see Razor/Compiler/NOTICE.txt for its origin and license.
  -->
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis.Razor.Compiler" HintPath="Razor\Compiler\Microsoft.CodeAnalysis.Razor.Compiler.dll" />
    <Reference Include="Microsoft.AspNetCore.Razor.Utilities.Shared" HintPath="Razor\Compiler\Microsoft.AspNetCore.Razor.Utilities.Shared.dll" />
    <Reference Include="Microsoft.Extensions.ObjectPool" HintPath="Razor\Compiler\Microsoft.Extensions.ObjectPool.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabStudio.Core\TabStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabStudio.Compilation.Tests" />
  </ItemGroup>

  <!-- What WPF has that OpenSilver does not, which names unsupported API in WPF projects; made by TabStudio.Wpf.Tests. -->
  <ItemGroup>
    <EmbeddedResource Include="Wpf\MissingInOpenSilver.txt" LogicalName="Wpf/MissingInOpenSilver.txt" />
  </ItemGroup>

</Project>
