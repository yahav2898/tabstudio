<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TabStudio.Wpf</RootNamespace>
    <Description>WPF on the device through OpenSilver: WPF projects compile against OpenSilver, their XAML goes through OpenSilver's own XAML compiler, and the app runs in the web preview on .NET for WebAssembly.</Description>
  </PropertyGroup>

  <!--
    OpenSilver's XAML compiler is an MSBuild task in the OpenSilver package. TabStudio runs it in its own process, so
    it carries the MSBuild interfaces the task is written against (MIT, managed code only).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabStudio.Core\TabStudio.Core.csproj" />
    <ProjectReference Include="..\TabStudio.Compilation\TabStudio.Compilation.csproj" />
    <ProjectReference Include="..\TabStudio.Packages\TabStudio.Packages.csproj" />
    <ProjectReference Include="..\TabStudio.Web\TabStudio.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabStudio.Wpf.Tests" />
  </ItemGroup>

</Project>
