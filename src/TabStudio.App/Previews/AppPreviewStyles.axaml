<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    TabStudio sizes a few built-in controls for its own UI (Theme/Controls.axaml), and those styles reach every
    control in its window, an app's views included. Inside the app preview and the XAML designer, these put
    Fluent's own values back, so an app looks as it does on a device. The app's own styles come after these.
  -->

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <Style Selector="Menu">
    <Setter Property="Height" Value="{DynamicResource MenuBarHeight}" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Padding" Value="{DynamicResource MenuBarItemPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!--
    The IDE's touch targets (Theme/Accessibility.axaml): an app's controls keep the sizes Fluent gives them, and the
    resources those sizes come from are Fluent's again inside an app's views (AppTheme.cs).
  -->
  <Style Selector="Button, DropDownButton, ToggleSwitch, ListBoxItem, ComboBoxItem, TabItem, TreeViewItem, ComboBox, NumericUpDown, AutoCompleteBox, CheckBox, RadioButton, DataGridRow">
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button, DropDownButton, CheckBox, RadioButton, Menu > MenuItem">
  </Style>
  <Style Selector="Button, DropDownButton">
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource ComboBoxMinHeight}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="{DynamicResource CheckBoxMinHeight}" />
  </Style>
  <Style Selector="RadioButton">
    <Setter Property="MinHeight" Value="{DynamicResource RadioButtonMinHeight}" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="{DynamicResource TreeViewItemMinHeight}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="MinHeight" Value="{DynamicResource TabItemMinHeight}" />
  </Style>
  <Style Selector="NumericUpDown, AutoCompleteBox">
    <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource SystemAltMediumLowColor}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ListBoxBorderThemeThickness}" />
  </Style>
</Styles>
