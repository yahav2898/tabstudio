<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    GitHub Actions and CI: the status icons of runs, jobs, steps and checks, the window's icons, and the colors
    of job logs. Icons are stroke paths on a 24×24 grid, like Icons.axaml.
  -->

  <!-- Run, job, step and check states, as GitHub draws them -->
  <StreamGeometry x:Key="Icon.RunPassed">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M8 12.5 L11 15.5 L16.5 9.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunFailed">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M9 9 L15 15 M15 9 L9 15</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunRunning">M12 3 A9 9 0 1 1 3 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunQueued">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M12 7.5 L12 12 L15.5 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunCancelled">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M5.7 18.3 L18.3 5.7</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunNeutral">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M8.5 12 L15.5 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.RunNone">M7 12 A5 5 0 1 0 17 12 A5 5 0 1 0 7 12</StreamGeometry>

  <!-- The window and its actions -->
  <StreamGeometry x:Key="Icon.Actions">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M10 8.5 L15.5 12 L10 15.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Workflow">M4 4 L10 4 L10 10 L4 10 Z M14 14 L20 14 L20 20 L14 20 Z M7 10 L7 13 A4 4 0 0 0 11 17 L14 17</StreamGeometry>
  <StreamGeometry x:Key="Icon.Rerun">M4 12 A8 8 0 1 0 7 5.8 M4 4 L4 9 L9 9</StreamGeometry>
  <StreamGeometry x:Key="Icon.CancelRun">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M9 9 L15 9 L15 15 L9 15 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Bell">M6 16 L6 11 A6 6 0 0 1 18 11 L18 16 L20 18 L4 18 Z M10 21 L14 21</StreamGeometry>
  <StreamGeometry x:Key="Icon.Log">M6 3 L15 3 L19 7 L19 21 L6 21 Z M15 3 L15 7 L19 7 M9 11 L16 11 M9 14.5 L16 14.5 M9 18 L13 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.NextError">M12 4 L12 15 M7.5 10.5 L12 15 L16.5 10.5 M6 20 L18 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.PreviousError">M12 20 L12 9 M7.5 13.5 L12 9 L16.5 13.5 M6 4 L18 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.UnfoldAll">M7 9 L12 4 L17 9 M7 15 L12 20 L17 15</StreamGeometry>
  <StreamGeometry x:Key="Icon.FoldAll">M7 4 L12 9 L17 4 M7 20 L12 15 L17 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Timestamp">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M12 7 L12 12 L15.5 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.GoToLine">M4 6 L20 6 M4 12 L14 12 M4 18 L20 18 M17 9 L20 12 L17 15</StreamGeometry>
  <StreamGeometry x:Key="Icon.Repository">M5 4 L17 4 A2 2 0 0 1 19 6 L19 18 L7 18 A2 2 0 0 0 5 20 Z M5 20 A2 2 0 0 0 7 22 L19 22 L19 18 M9 8 L15 8</StreamGeometry>

  <!-- State colors -->
  <SolidColorBrush x:Key="Brush.Run.Passed" Color="#6FD6A0" />
  <SolidColorBrush x:Key="Brush.Run.Failed" Color="#F47067" />
  <SolidColorBrush x:Key="Brush.Run.Running" Color="#E3B341" />
  <SolidColorBrush x:Key="Brush.Run.Queued" Color="#C69026" />
  <SolidColorBrush x:Key="Brush.Run.Muted" Color="#9AA1AE" />
  <SolidColorBrush x:Key="Brush.Run.FailedSoft" Color="#3A2326" />
  <SolidColorBrush x:Key="Brush.Run.PassedSoft" Color="#1C2E28" />
  <SolidColorBrush x:Key="Brush.Run.RunningSoft" Color="#352E1C" />

  <!-- Job logs: workflow commands, step headings and terminal colors, in GitHub's dark palette -->
  <SolidColorBrush x:Key="Brush.Log.Error" Color="#F47067" />
  <SolidColorBrush x:Key="Brush.Log.ErrorBackground" Color="#33F47067" />
  <SolidColorBrush x:Key="Brush.Log.Warning" Color="#E3B341" />
  <SolidColorBrush x:Key="Brush.Log.WarningBackground" Color="#26E3B341" />
  <SolidColorBrush x:Key="Brush.Log.Notice" Color="#6CB6FF" />
  <SolidColorBrush x:Key="Brush.Log.Debug" Color="#8B949E" />
  <SolidColorBrush x:Key="Brush.Log.Command" Color="#8FB8FF" />
  <SolidColorBrush x:Key="Brush.Log.Step" Color="#E8ECF2" />
  <SolidColorBrush x:Key="Brush.Log.StepBackground" Color="#262A33" />
  <SolidColorBrush x:Key="Brush.Log.Group" Color="#C5CAD3" />
  <SolidColorBrush x:Key="Brush.Log.Omitted" Color="#9AA1AE" />
  <SolidColorBrush x:Key="Brush.Ansi.Gray" Color="#8B949E" />
  <SolidColorBrush x:Key="Brush.Ansi.Red" Color="#FF7B72" />
  <SolidColorBrush x:Key="Brush.Ansi.Green" Color="#7EE787" />
  <SolidColorBrush x:Key="Brush.Ansi.Yellow" Color="#E3B341" />
  <SolidColorBrush x:Key="Brush.Ansi.Blue" Color="#79C0FF" />
  <SolidColorBrush x:Key="Brush.Ansi.Magenta" Color="#D2A8FF" />
  <SolidColorBrush x:Key="Brush.Ansi.Cyan" Color="#56D4DD" />
  <SolidColorBrush x:Key="Brush.Ansi.White" Color="#F0F6FC" />

</ResourceDictionary>
