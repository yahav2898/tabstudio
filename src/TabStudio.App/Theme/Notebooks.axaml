<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The notebook editor's icons (its colors are in Colors.axaml, for both themes). Icons follow Icons.axaml: stroke paths on a 24×24 grid.
  -->

  <!-- Icons -->
  <StreamGeometry x:Key="Icon.RunAll">M3 5 L11 12 L3 19 Z M12 5 L20 12 L12 19 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M12 5 L12 19 M5 12 L19 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.ArrowUp">M12 19 L12 5 M6 11 L12 5 L18 11</StreamGeometry>
  <StreamGeometry x:Key="Icon.ArrowDown">M12 5 L12 19 M6 13 L12 19 L18 13</StreamGeometry>
  <StreamGeometry x:Key="Icon.Trash">M4 7 L20 7 M9 7 L9 4 L15 4 L15 7 M6 7 L7 20 L17 20 L18 7 M10 11 L10 16 M14 11 L14 16</StreamGeometry>
  <StreamGeometry x:Key="Icon.More">M5 12 L5.01 12 M12 12 L12.01 12 M19 12 L19.01 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Clock">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M12 7 L12 12 L15.5 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Spinner">M12 3 A9 9 0 0 1 21 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.ClearOutputs">M4 6 L14 6 M4 11 L11 11 M4 16 L9 16 M14 13 L20 19 M20 13 L14 19</StreamGeometry>
  <StreamGeometry x:Key="Icon.Markdown">M3 6 L21 6 L21 18 L3 18 Z M6 15 L6 9 L8.5 12 L11 9 L11 15 M16 9 L16 15 M13.5 12.5 L16 15 L18.5 12.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Code">M8 7 L3 12 L8 17 M16 7 L21 12 L16 17 M14 5 L10 19</StreamGeometry>
  <StreamGeometry x:Key="Icon.Notebook">M6 3 L18 3 A1 1 0 0 1 19 4 L19 20 A1 1 0 0 1 18 21 L6 21 Z M9 3 L9 21 M12 8 L16 8 M12 12 L16 12</StreamGeometry>

</ResourceDictionary>
