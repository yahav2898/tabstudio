<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Desktop mode's icons: the display and the tablet, the companion's panels, and one icon per kind of control in the
    Toolbox (Toolbox/*.json names them as Icon.Toolbox.<icon>). Stroke paths on a 24×24 grid, like Icons.axaml.
  -->

  <!-- Desktop mode -->
  <StreamGeometry x:Key="Icon.Monitor">M3 4 L21 4 L21 16 L3 16 Z M9 20 L15 20 M12 16 L12 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Tablet">M6 3 L18 3 L18 21 L6 21 Z M11 18 L13 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox">M3 9 L21 9 L21 19 L3 19 Z M8 9 L8 6 L16 6 L16 9 M3 13 L21 13 M10 13 L10 15 L14 15 L14 13</StreamGeometry>
  <StreamGeometry x:Key="Icon.Properties">M4 7 L20 7 M4 17 L20 17 M9 4 L9 10 M15 14 L15 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Scale">M4 9 L4 4 L9 4 M20 15 L20 20 L15 20 M4 4 L10 10 M20 20 L14 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Keyboard">M2 6 L22 6 L22 18 L2 18 Z M6 10 L6 10.01 M10 10 L10 10.01 M14 10 L14 10.01 M18 10 L18 10.01 M8 14 L16 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.ArrowUp">M12 19 L12 5 M6 11 L12 5 L18 11</StreamGeometry>
  <StreamGeometry x:Key="Icon.ArrowDown">M12 5 L12 19 M6 13 L12 19 L18 13</StreamGeometry>
  <StreamGeometry x:Key="Icon.ArrowLeft">M19 12 L5 12 M11 6 L5 12 L11 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.ArrowRight">M5 12 L19 12 M13 6 L19 12 L13 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Tab">M4 12 L18 12 M13 7 L18 12 L13 17 M21 6 L21 18</StreamGeometry>

  <!-- Toolbox: common controls -->
  <StreamGeometry x:Key="Icon.Toolbox.Control">M4 6 L20 6 L20 18 L4 18 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Button">M7 7 L17 7 A5 5 0 0 1 17 17 L7 17 A5 5 0 0 1 7 7 Z M9.5 12 L14.5 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.ToggleButton">M7 7 L17 7 A5 5 0 0 1 17 17 L7 17 A5 5 0 0 1 7 7 Z M9.5 12 L11.5 14 L14.5 10</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Text">M6 6 L18 6 M12 6 L12 18 M9.5 18 L14.5 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Label">M3 7 L15 7 L20 12 L15 17 L3 17 Z M7 12 L11 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.TextBox">M3 7 L21 7 L21 17 L3 17 Z M7 10 L7 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.CheckBox">M5 5 L19 5 L19 19 L5 19 Z M8.5 12 L11 14.5 L15.5 9.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.RadioButton">M4 12 A8 8 0 1 0 20 12 A8 8 0 1 0 4 12 M10 12 A2 2 0 1 0 14 12 A2 2 0 1 0 10 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.ToggleSwitch">M8 7 L16 7 A5 5 0 0 1 16 17 L8 17 A5 5 0 0 1 8 7 Z M13 12 A3 3 0 1 0 19 12 A3 3 0 1 0 13 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.ComboBox">M3 7 L21 7 L21 17 L3 17 Z M15 7 L15 17 M16.5 11 L18 12.5 L19.5 11</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Slider">M3 12 L21 12 M9 8 L9 16</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.ProgressBar">M3 9 L21 9 L21 15 L3 15 Z M5 12 L13 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Image">M3 5 L21 5 L21 19 L3 19 Z M3 16 L9 10 L14 15 M13 14 L16 11 L21 16 M15.5 8.5 A1.5 1.5 0 1 0 18.5 8.5 A1.5 1.5 0 1 0 15.5 8.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.NumericUpDown">M3 7 L21 7 L21 17 L3 17 Z M15 7 L15 17 M16.5 10.5 L18 9 L19.5 10.5 M16.5 13.5 L18 15 L19.5 13.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Search">M5 11 A6 6 0 1 0 17 11 A6 6 0 1 0 5 11 M20 20 L15.5 15.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Calendar">M4 6 L20 6 L20 20 L4 20 Z M4 10 L20 10 M8 3 L8 7 M16 3 L16 7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Clock">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M12 7 L12 12 L15.5 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Link">M10 14 A4 4 0 0 0 15.7 14 L18.7 11 A4 4 0 0 0 13 5.3 L12 6.3 M14 10 A4 4 0 0 0 8.3 10 L5.3 13 A4 4 0 0 0 11 18.7 L12 17.7</StreamGeometry>

  <!-- Toolbox: layout -->
  <StreamGeometry x:Key="Icon.Toolbox.Grid">M3 3 L21 3 L21 21 L3 21 Z M3 12 L21 12 M12 3 L12 21</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.StackPanel">M4 4 L20 4 L20 8 L4 8 Z M4 10 L20 10 L20 14 L4 14 Z M4 16 L20 16 L20 20 L4 20 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.DockPanel">M3 3 L21 3 L21 21 L3 21 Z M3 8 L21 8 M9 8 L9 21</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.WrapPanel">M3 5 L9 5 L9 10 L3 10 Z M11 5 L17 5 L17 10 L11 10 Z M3 14 L9 14 L9 19 L3 19 Z M19 7.5 L21 7.5 L21 16.5 L12 16.5 M14 14.5 L12 16.5 L14 18.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Canvas">M3 3 L21 3 L21 21 L3 21 Z M7 7 L11 7 L11 11 L7 11 Z M14 15.5 A2.5 2.5 0 1 0 19 15.5 A2.5 2.5 0 1 0 14 15.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Border">M7 4 L17 4 A3 3 0 0 1 20 7 L20 17 A3 3 0 0 1 17 20 L7 20 A3 3 0 0 1 4 17 L4 7 A3 3 0 0 1 7 4 Z M8.5 8.5 L15.5 8.5 L15.5 15.5 L8.5 15.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.ScrollViewer">M3 3 L21 3 L21 21 L3 21 Z M16 3 L16 21 M18.5 6 L18.5 11</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Viewbox">M3 3 L21 3 L21 21 L3 21 Z M7 10 L7 7 L10 7 M17 14 L17 17 L14 17 M7 7 L11 11 M17 17 L13 13</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Expander">M3 5 L21 5 L21 10 L3 10 Z M3 10 L3 19 L21 19 L21 10 M15.5 6.5 L17 8 L18.5 6.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Splitter">M3 3 L21 3 L21 21 L3 21 Z M12 3 L12 21 M9 10 L7 12 L9 14 M15 10 L17 12 L15 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Separator">M3 12 L21 12 M7 7 L17 7 M7 17 L17 17</StreamGeometry>

  <!-- Toolbox: lists and navigation -->
  <StreamGeometry x:Key="Icon.Toolbox.List">M8 6 L20 6 M8 12 L20 12 M8 18 L20 18 M4 6 L4.01 6 M4 12 L4.01 12 M4 18 L4.01 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Tree">M5 4 L5 16 M5 9 L10 9 M5 16 L10 16 M13 9 L20 9 M13 16 L20 16 M3 4 L8 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Tabs">M3 9 L21 9 L21 20 L3 20 Z M3 9 L3 5 L10 5 L10 9 M12 9 L12 6 L18 6 L18 9</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Menu">M3 4 L21 4 L21 8 L3 8 Z M7 8 L7 18 L15 18 L15 8 M9 11.5 L13 11.5 M9 14.5 L13 14.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.SplitView">M3 4 L21 4 L21 20 L3 20 Z M9 4 L9 20 M5 8 L7 8 M5 11 L7 11</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Carousel">M7 5 L17 5 L17 19 L7 19 Z M4 8 L4 16 M20 8 L20 16</StreamGeometry>

  <!-- Toolbox: shapes and media -->
  <StreamGeometry x:Key="Icon.Toolbox.Rectangle">M4 6 L20 6 L20 18 L4 18 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Ellipse">M3 12 A9 7 0 1 0 21 12 A9 7 0 1 0 3 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Line">M4 20 L20 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Toolbox.Path">M4 18 C8 4 16 20 20 6</StreamGeometry>

</ResourceDictionary>
