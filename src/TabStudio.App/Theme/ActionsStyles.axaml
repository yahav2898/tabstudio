<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TabStudio.App.Controls">

  <!--
    Styles of the GitHub Actions window, the CI status bar item and job logs.
  -->

  <!-- A running run's, job's or check's icon turns, as on GitHub. -->
  <Style Selector="controls|StrokeIcon.spinning">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0.0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360.0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- A section of the GitHub Actions window: its heading. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextLabel}" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A square icon button of the window's tool rows. -->
  <Style Selector="Button.iconButton">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="0" />
  </Style>

</Styles>
