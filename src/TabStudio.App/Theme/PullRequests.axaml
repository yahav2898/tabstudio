<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Pull request review's colors and icons. Icons are stroke paths on a 24×24 grid, like Icons.axaml; circles are
    written as two arcs.
  -->

  <!-- Where a pull request stands, as GitHub colors it: open green, draft gray, merged purple, closed red. -->
  <SolidColorBrush x:Key="Brush.PullRequest.Open" Color="#238636" />
  <SolidColorBrush x:Key="Brush.PullRequest.Draft" Color="#4A5060" />
  <SolidColorBrush x:Key="Brush.PullRequest.Merged" Color="#8957E5" />
  <SolidColorBrush x:Key="Brush.PullRequest.Closed" Color="#C93C37" />
  <SolidColorBrush x:Key="Brush.PullRequest.OpenText" Color="#6FD6A0" />
  <SolidColorBrush x:Key="Brush.PullRequest.MergedText" Color="#C9B6FF" />

  <!-- Review cards: the stripe on a card's left edge says what it is. -->
  <SolidColorBrush x:Key="Brush.Review.Thread" Color="#6CB6FF" />
  <SolidColorBrush x:Key="Brush.Review.Pending" Color="#E3B341" />
  <SolidColorBrush x:Key="Brush.Review.Claude" Color="#C9B6FF" />
  <SolidColorBrush x:Key="Brush.Review.ClaudeSoft" Color="#2E2846" />
  <SolidColorBrush x:Key="Brush.Review.PendingSoft" Color="#3A3220" />
  <SolidColorBrush x:Key="Brush.Review.Card" Color="#262A33" />

  <StreamGeometry x:Key="Icon.Conversation">M4 5 L20 5 L20 16 L10 16 L5 20 L5 16 L4 16 Z M8 9.5 L16 9.5 M8 12.5 L13 12.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Merge">M4 5 A2 2 0 1 0 8 5 A2 2 0 1 0 4 5 M4 19 A2 2 0 1 0 8 19 A2 2 0 1 0 4 19 M16 13 A2 2 0 1 0 20 13 A2 2 0 1 0 16 13 M6 7 L6 17 M6 7 C6 11 10 13 16 13</StreamGeometry>
  <StreamGeometry x:Key="Icon.Approved">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M8 12.5 L11 15.5 L16.5 9.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChangesRequested">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M8 12 L16 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.CheckOut">M12 4 L12 15 M7 10 L12 15 L17 10 M5 20 L19 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Eye">M2 12 C5 6 19 6 22 12 C19 18 5 18 2 12 Z M9 12 A3 3 0 1 0 15 12 A3 3 0 1 0 9 12</StreamGeometry>

</ResourceDictionary>
