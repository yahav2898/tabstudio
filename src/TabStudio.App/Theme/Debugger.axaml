<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The debugger's icons (its colors are in Colors.axaml, for both themes). Icons are stroke paths on a 24×24 grid, like Icons.axaml; circles are written as
    two arcs: "M cx-r,cy a r,r 0 1 0 2r,0 a r,r 0 1 0 -2r,0".
  -->

  <StreamGeometry x:Key="Icon.Bug">M8 9 A4 4 0 0 1 16 9 L16 15 A4 4 0 0 1 8 15 Z M12 9 L12 19 M8 12 L4 12 M16 12 L20 12 M8 16 L5 18 M16 16 L19 18 M9 6 L7 4 M15 6 L17 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.PlayOutline">M7 4 L20 12 L7 20 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Restart">M4 12 A8 8 0 1 0 7 5.8 M4 4 L4 9 L9 9</StreamGeometry>
  <StreamGeometry x:Key="Icon.StepInto">M12 3 L12 13 M8 9 L12 13 L16 9 M10 19 A2 2 0 1 0 14 19 A2 2 0 1 0 10 19</StreamGeometry>
  <StreamGeometry x:Key="Icon.StepOver">M4 13 A8 7 0 0 1 20 13 M16 12.5 L20 13 L21 9 M10 19 A2 2 0 1 0 14 19 A2 2 0 1 0 10 19</StreamGeometry>
  <StreamGeometry x:Key="Icon.StepOut">M12 14 L12 4 M8 8 L12 4 L16 8 M10 19 A2 2 0 1 0 14 19 A2 2 0 1 0 10 19</StreamGeometry>
  <StreamGeometry x:Key="Icon.NextStatement">M3 9 L12 9 L12 4.5 L20.5 12 L12 19.5 L12 15 L3 15 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Breakpoint">M6 12 A6 6 0 1 0 18 12 A6 6 0 1 0 6 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Watch">M2 12 C5 6 19 6 22 12 C19 18 5 18 2 12 Z M9 12 A3 3 0 1 0 15 12 A3 3 0 1 0 9 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Copy">M9 9 L20 9 L20 20 L9 20 Z M5 15 L4 15 L4 4 L15 4 L15 5</StreamGeometry>

</ResourceDictionary>
