<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Swarm's screens: the Device Matrix's icons, in the style of Icons.axaml (stroke paths on a 24×24 grid, drawn by
    controls:StrokeIcon), and the notice drawn over a screen. Its colors are tokens of Colors.axaml (Brush.Swarm.*,
    Brush.Overlay), in both themes.
  -->

  <!-- A short notice over a screen, such as a tap mirrored from another screen that found no element there. -->
  <ControlTheme x:Key="SwarmNotice" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Overlay.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Popup}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </ControlTheme>

  <!-- Every screen at once: a grid of screens. -->
  <StreamGeometry x:Key="Icon.DeviceMatrix">M3 5 L10 5 L10 19 L3 19 Z M13 8 L21 8 L21 19 L13 19 Z M5.5 16.5 L7.5 16.5 M16 16.5 L18 16.5</StreamGeometry>
  <!-- Turn the device on its side. -->
  <StreamGeometry x:Key="Icon.Rotate">M5 12 A7 7 0 0 1 17.5 7.6 M18 3.5 L18 8 L13.5 8 M19 12 A7 7 0 0 1 6.5 16.4 M6 20.5 L6 16 L10.5 16</StreamGeometry>
  <!-- Light or dark: a moon. -->
  <StreamGeometry x:Key="Icon.Theme">M19.5 14.5 A8 8 0 1 1 9.5 4.5 A6.5 6.5 0 0 0 19.5 14.5 Z</StreamGeometry>
  <!-- Right to left: a paragraph mark and an arrow pointing left. -->
  <StreamGeometry x:Key="Icon.Direction">M11 4 L11 14 M15 4 L15 14 M9.5 4 L18 4 M11 4 A3 3 0 0 0 11 10 M20 19 L5 19 M8 16 L5 19 L8 22</StreamGeometry>
  <!-- Larger text: a large and a small letter A. -->
  <StreamGeometry x:Key="Icon.FontScale">M2.5 19 L8 5 L13.5 19 M4.6 14 L11.4 14 M14.5 19 L18 10.5 L21.5 19 M15.7 16 L20.3 16</StreamGeometry>
  <!-- Full size: four corners. -->
  <StreamGeometry x:Key="Icon.FullSize">M4 9 L4 4 L9 4 M15 4 L20 4 L20 9 M20 15 L20 20 L15 20 M9 20 L4 20 L4 15</StreamGeometry>
  <!-- Fit every screen. -->
  <StreamGeometry x:Key="Icon.Fit">M4 8 L4 4 L8 4 M16 4 L20 4 L20 8 M20 16 L20 20 L16 20 M8 20 L4 20 L4 16 M9 8 L15 8 L15 16 L9 16 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.ZoomIn">M4 11 A6.5 6.5 0 1 0 17 11 A6.5 6.5 0 1 0 4 11 M20.5 20.5 L15.5 15.5 M7.5 11 L13.5 11 M10.5 8 L10.5 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.ZoomOut">M4 11 A6.5 6.5 0 1 0 17 11 A6.5 6.5 0 1 0 4 11 M20.5 20.5 L15.5 15.5 M7.5 11 L13.5 11</StreamGeometry>
  <!-- The layout checks: a ruler. -->
  <StreamGeometry x:Key="Icon.LayoutCheck">M3 15 L15 3 L21 9 L9 21 Z M7 11 L9 13 M10 8 L12 10 M13 5 L15 7 M8.5 9.5 L9.5 10.5</StreamGeometry>

</ResourceDictionary>
