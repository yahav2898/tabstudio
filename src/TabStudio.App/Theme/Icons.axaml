<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    TabStudio's icon set. Every icon is a stroke path on a 24×24 grid, drawn by controls:StrokeIcon.
    Circles are written as two arcs: "M cx-r,cy a r,r 0 1 0 2r,0 a r,r 0 1 0 -2r,0".
  -->

  <!-- Navigation and files -->
  <StreamGeometry x:Key="Icon.Back">M15 6 L9 12 L15 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Forward">M9 6 L15 12 L9 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronDown">M7 10 L12 15 L17 10</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronUp">M7 14 L12 9 L17 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronRight">M10 7 L15 12 L10 17</StreamGeometry>
  <StreamGeometry x:Key="Icon.Close">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Home">M4 11 L12 4 L20 11 L20 20 L4 20 Z M10 20 L10 14 L14 14 L14 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.NewFile">M6 3 L14 3 L18 7 L18 21 L6 21 Z M14 3 L14 7 L18 7 M12 11 L12 17 M9 14 L15 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.File">M6 3 L15 3 L19 7 L19 21 L6 21 Z M15 3 L15 7 L19 7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Folder">M3 6 L9 6 L11 8 L21 8 L21 19 L3 19 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Save">M5 4 L16 4 L19 7 L19 20 L5 20 Z M8 4 L8 9 L15 9 L15 4 M8 20 L8 14 L16 14 L16 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.SaveAll">M8 3 L18 3 L21 6 L21 17 M3 7 L14 7 L17 10 L17 21 L3 21 Z M6 7 L6 11 L12 11 L12 7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Download">M12 4 L12 15 M7 10 L12 15 L17 10 M5 20 L19 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Search">M5 11 A6 6 0 1 0 17 11 A6 6 0 1 0 5 11 M20 20 L15.5 15.5</StreamGeometry>

  <!-- Editing -->
  <StreamGeometry x:Key="Icon.Undo">M9 6 L4 11 L9 16 M4 11 L14 11 A5 5 0 0 1 14 21 L12 21</StreamGeometry>
  <StreamGeometry x:Key="Icon.Redo">M15 6 L20 11 L15 16 M20 11 L10 11 A5 5 0 0 0 10 21 L12 21</StreamGeometry>
  <StreamGeometry x:Key="Icon.Comment">M9 5 L5 19 M19 5 L15 19</StreamGeometry>
  <StreamGeometry x:Key="Icon.Format">M4 6 L20 6 M8 12 L20 12 M4 18 L20 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Rename">M4 20 L8 20 L19 9 L15 5 L4 16 Z</StreamGeometry>

  <!-- Build and run -->
  <StreamGeometry x:Key="Icon.Play">M7 4 L20 12 L7 20 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Stop">M6 6 L18 6 L18 18 L6 18 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Pause">M9 6 L9 18 M15 6 L15 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Build">M14.5 6.5 A4 4 0 0 0 9 12 L3.5 17.5 L6 20 L11.5 14.5 A4 4 0 0 0 17 9 L14.5 11.5 L12.5 9.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Flame">M12 3 C12 3 17 7 17 12 A5 5 0 0 1 7 12 C7 10 8 8 9 7 C9 9 10 10 11 10 C11 7 12 5 12 3 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Terminal">M4 5 L20 5 L20 19 L4 19 Z M7 9 L10 12 L7 15 M12 15 L17 15</StreamGeometry>

  <!-- Test Explorer: run commands and test outcomes (failed and skipped use Icon.Error and Icon.Warning) -->
  <StreamGeometry x:Key="Icon.RunAll">M3 5 L11 12 L3 19 Z M12 5 L20 12 L12 19 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.TestPassed">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M8 12.5 L11 15.5 L16.5 9.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.TestNotRun">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M12 7.5 L12 13 M12 16.5 L12 17</StreamGeometry>
  <StreamGeometry x:Key="Icon.TestQueued">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M12 7.5 L12 12 L15.5 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.TestRunning">M12 3 A9 9 0 1 1 3 12 M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8</StreamGeometry>
  <StreamGeometry x:Key="Icon.GroupBy">M4 5 L13 5 M7 5 L7 18 L11 18 M7 11.5 L11 11.5 M14 11.5 L20 11.5 M14 18 L20 18</StreamGeometry>

  <!-- Solution Explorer -->
  <StreamGeometry x:Key="Icon.Solution">M7 4 L17 4 A3 3 0 0 1 20 7 L20 17 A3 3 0 0 1 17 20 L7 20 A3 3 0 0 1 4 17 L4 7 A3 3 0 0 1 7 4 Z M8 9 L16 9 M8 13 L16 13 M8 17 L13 17</StreamGeometry>
  <StreamGeometry x:Key="Icon.Globe">M4 12 A8 8 0 1 0 20 12 A8 8 0 1 0 4 12 M4 12 L20 12 M12 4 C15 7 15 17 12 20 M12 4 C9 7 9 17 12 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Cube">M12 3 L20 7.5 L20 16.5 L12 21 L4 16.5 L4 7.5 Z M4 7.5 L12 12 L20 7.5 M12 12 L12 21</StreamGeometry>
  <StreamGeometry x:Key="Icon.Flask">M9 3 L15 3 M10 3 L10 9 L5 18 A2 2 0 0 0 7 21 L17 21 A2 2 0 0 0 19 18 L14 9 L14 3</StreamGeometry>
  <StreamGeometry x:Key="Icon.Window">M3 4 L21 4 L21 20 L3 20 Z M3 8 L21 8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Link">M10 14 A4 4 0 0 0 15.7 14 L18.7 11 A4 4 0 0 0 13 5.3 L12 6.3 M14 10 A4 4 0 0 0 8.3 10 L5.3 13 A4 4 0 0 0 11 18.7 L12 17.7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Package">M12 3 L20 7.5 L20 16.5 L12 21 L4 16.5 L4 7.5 Z M8 5.3 L16 9.8 L16 13</StreamGeometry>
  <StreamGeometry x:Key="Icon.Collapse">M7 4 L17 4 A3 3 0 0 1 20 7 L20 17 A3 3 0 0 1 17 20 L7 20 A3 3 0 0 1 4 17 L4 7 A3 3 0 0 1 7 4 Z M8 12 L16 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Refresh">M4 12 A8 8 0 1 0 7 5.8 M4 4 L4 9 L9 9</StreamGeometry>

  <!-- Status -->
  <StreamGeometry x:Key="Icon.Check">M5 12 L10 17 L19 7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Error">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M9 9 L15 15 M15 9 L9 15</StreamGeometry>
  <StreamGeometry x:Key="Icon.Warning">M12 4 L21 20 L3 20 Z M12 10 L12 14 M12 17 L12 17.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Info">M3 12 A9 9 0 1 0 21 12 A9 9 0 1 0 3 12 M12 11 L12 17 M12 7.5 L12 8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Thermometer">M10 4 A2 2 0 0 1 14 4 L14 14 A4 4 0 1 1 10 14 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Branch">M4 5 A2 2 0 1 0 8 5 A2 2 0 1 0 4 5 M4 19 A2 2 0 1 0 8 19 A2 2 0 1 0 4 19 M16 7 A2 2 0 1 0 20 7 A2 2 0 1 0 16 7 M6 7 L6 17 M18 9 C18 14 12 13 6 17</StreamGeometry>
  <StreamGeometry x:Key="Icon.Doctor">M6 3 L6 9 A4 4 0 0 0 14 9 L14 3 M10 13 L10 16 A4 4 0 0 0 18 16 L18 14 M16 12 A2 2 0 1 0 20 12 A2 2 0 1 0 16 12</StreamGeometry>

  <!-- People and tools -->
  <StreamGeometry x:Key="Icon.Agent">M4 5 L20 5 L20 16 L9 16 L4 20 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.User">M8 8 A4 4 0 1 0 16 8 A4 4 0 1 0 8 8 M4 21 C5 17 8 15 12 15 C16 15 19 17 20 21</StreamGeometry>
  <StreamGeometry x:Key="Icon.Gear">M9 12 A3 3 0 1 0 15 12 A3 3 0 1 0 9 12 M12 3 L12 6 M12 18 L12 21 M3 12 L6 12 M18 12 L21 12 M5.6 5.6 L7.7 7.7 M16.3 16.3 L18.4 18.4 M5.6 18.4 L7.7 16.3 M16.3 7.7 L18.4 5.6</StreamGeometry>
  <StreamGeometry x:Key="Icon.List">M8 6 L20 6 M8 12 L20 12 M8 18 L20 18 M4 6 L4.01 6 M4 12 L4.01 12 M4 18 L4.01 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Logo">M17 5 L9 5 A3 3 0 0 0 9 11 L15 11 A3 3 0 0 1 15 17 L6 17</StreamGeometry>

  <!-- Source control -->
  <StreamGeometry x:Key="Icon.Fetch">M20 12 A8 8 0 1 1 17 5.8 M20 4 L20 9 L15 9 M12 8 L12 15 M9 12.5 L12 15.5 L15 12.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Pull">M12 3 L12 15 M7 10 L12 15 L17 10 M5 20 L19 20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Push">M12 21 L12 9 M7 14 L12 9 L17 14 M5 4 L19 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sync">M8 4 L8 18 M4 14 L8 18 L12 14 M16 20 L16 6 M12 10 L16 6 L20 10</StreamGeometry>
  <StreamGeometry x:Key="Icon.Commit">M8 12 A4 4 0 1 0 16 12 A4 4 0 1 0 8 12 M3 12 L8 12 M16 12 L21 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.History">M4 12 A8 8 0 1 0 6.3 6.3 M3 4 L6.3 6.3 L8.5 3 M12 8 L12 12 L15 14</StreamGeometry>
  <StreamGeometry x:Key="Icon.PullRequest">M4 5 A2 2 0 1 0 8 5 A2 2 0 1 0 4 5 M4 19 A2 2 0 1 0 8 19 A2 2 0 1 0 4 19 M16 19 A2 2 0 1 0 20 19 A2 2 0 1 0 16 19 M6 7 L6 17 M18 17 L18 9 A3 3 0 0 0 15 6 L11 6 M13 4 L11 6 L13 8</StreamGeometry>
  <StreamGeometry x:Key="Icon.External">M14 4 L20 4 L20 10 M20 4 L11 13 M18 14 L18 20 L4 20 L4 6 L10 6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M12 5 L12 19 M5 12 L19 12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Lock">M6 11 L18 11 L18 20 L6 20 Z M8.5 11 L8.5 8 A3.5 3.5 0 0 1 15.5 8 L15.5 11</StreamGeometry>
  <StreamGeometry x:Key="Icon.Upload">M12 16 L12 4 M7 9 L12 4 L17 9 M5 20 L19 20</StreamGeometry>

</ResourceDictionary>
