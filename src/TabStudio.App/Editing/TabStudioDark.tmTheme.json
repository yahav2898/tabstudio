{
  "name": "TabStudio Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1B1D23",
    "editor.foreground": "#D7DAE0"
  },
  "tokenColors": [
    { "settings": { "foreground": "#D7DAE0" } },
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8CA77A" } },
    { "scope": ["string", "punctuation.definition.string", "string.quoted", "string.template"], "settings": { "foreground": "#E6A26B" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#F0C674" } },
    { "scope": ["constant.numeric", "constant.language.numeric"], "settings": { "foreground": "#B5CEA8" } },
    { "scope": ["constant.language", "constant.other.boolean"], "settings": { "foreground": "#7FB2FF" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.other"], "settings": { "foreground": "#7FB2FF" } },
    { "scope": ["keyword.control", "keyword.control.flow", "keyword.control.import", "keyword.control.from"], "settings": { "foreground": "#D3A6F2" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#D7DAE0" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.interface", "entity.name.namespace", "support.type", "support.class", "entity.other.inherited-class", "storage.type.class.jsdoc"], "settings": { "foreground": "#5FD0BA" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "entity.name.method"], "settings": { "foreground": "#E2D58E" } },
    { "scope": ["variable", "variable.parameter", "variable.other", "meta.definition.variable", "support.variable"], "settings": { "foreground": "#A9D4F5" } },
    { "scope": ["variable.language"], "settings": { "foreground": "#7FB2FF" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml.doctype"], "settings": { "foreground": "#7FB2FF" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#A9D4F5" } },
    { "scope": ["support.type.property-name", "support.type.property-name.json", "meta.object-literal.key"], "settings": { "foreground": "#A9D4F5" } },
    { "scope": ["punctuation.definition.tag", "punctuation.separator.key-value"], "settings": { "foreground": "#9AA1AE" } },
    { "scope": ["meta.preprocessor", "entity.name.function.preprocessor", "punctuation.definition.directive"], "settings": { "foreground": "#9AA1AE" } },
    { "scope": ["markup.heading", "entity.name.section", "markup.heading entity.name"], "settings": { "foreground": "#7FB2FF", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#E6A26B" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#8FB8FF" } },
    { "scope": ["markup.list", "punctuation.definition.list"], "settings": { "foreground": "#9AA1AE" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#6FD6A0" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#F47067" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#E3B341" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#F47067" } }
  ]
}
