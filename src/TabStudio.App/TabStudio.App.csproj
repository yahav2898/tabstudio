<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The IDE itself: views, view models and services, shared by every platform head
    (TabStudio.Android for the product, TabStudio.Desktop for development).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TabStudio.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TabStudioIncludeLocalAITestModel)' == 'true'">
    <DefineConstants>$(DefineConstants);TABSTUDIO_LOCAL_AI_SELF_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TabStudioIncludeLocalAITestModel)' == 'true'">
    <EmbeddedResource Include="../../artifacts/local-ai/tiny.gguf" LogicalName="LocalAI/tiny.gguf" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- The sample solution ships inside the app and is extracted on first use. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\HelloTablet\**\*"
                      Exclude="..\..\samples\HelloTablet\**\bin\**;..\..\samples\HelloTablet\**\obj\**"
                      LogicalName="Samples/HelloTablet/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\samples\PIC\**\*"
                      Exclude="..\..\samples\PIC\**\build\**;..\..\samples\PIC\**\dist\**"
                      LogicalName="Templates/PIC/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Editing\TabStudioDark.tmTheme.json" LogicalName="Themes/TabStudioDark.json" />
  </ItemGroup>

  <!-- The Toolbox's controls and the Properties panel's categories, one file per UI framework. -->
  <ItemGroup>
    <EmbeddedResource Include="Toolbox\*.json" LogicalName="Toolbox/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Uno and Avalonia share one compatible SkiaSharp runtime, as on Android. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Reads the TabStudio Link host's QR code in camera frames. -->
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabStudio.Database\TabStudio.Database.csproj" />
    <ProjectReference Include="..\TabStudio.Core\TabStudio.Core.csproj" />
    <ProjectReference Include="..\TabStudio.Porting\TabStudio.Porting.csproj" />
    <ProjectReference Include="..\TabStudio.Compilation\TabStudio.Compilation.csproj" />
    <ProjectReference Include="..\TabStudio.Packages\TabStudio.Packages.csproj" />
    <ProjectReference Include="..\TabStudio.Agent\TabStudio.Agent.csproj" />
    <ProjectReference Include="..\TabStudio.SourceControl\TabStudio.SourceControl.csproj" />
    <ProjectReference Include="..\TabStudio.Debugging\TabStudio.Debugging.csproj" />
    <ProjectReference Include="..\TabStudio.TestRunner\TabStudio.TestRunner.csproj" />
    <ProjectReference Include="..\TabStudio.LiveTesting\TabStudio.LiveTesting.csproj" />
    <ProjectReference Include="..\TabStudio.Notebooks\TabStudio.Notebooks.csproj" />
    <ProjectReference Include="..\TabStudio.Link\TabStudio.Link.csproj" />
    <ProjectReference Include="..\TabStudio.LanguageServers\TabStudio.LanguageServers.csproj" />
    <ProjectReference Include="..\TabStudio.Swarm\TabStudio.Swarm.csproj" />
    <ProjectReference Include="..\TabStudio.Live\TabStudio.Live.csproj" />
    <ProjectReference Include="..\TabStudio.Extensions\TabStudio.Extensions.csproj" />
    <ProjectReference Include="..\TabStudio.Toolchains\TabStudio.Toolchains.csproj" />
    <ProjectReference Include="..\TabStudio.Services\TabStudio.Services.csproj" />
    <ProjectReference Include="..\TabStudio.Web\TabStudio.Web.csproj" />
    <ProjectReference Include="..\TabStudio.Wpf\TabStudio.Wpf.csproj" />

    <ProjectReference Include="..\TabStudio.Uno\TabStudio.Uno.csproj" />
    <ProjectReference Include="..\TabStudio.Forms\TabStudio.Forms.csproj" />
    <!-- Microsoft.VisualBasic.Forms: Visual Basic programs, and Microsoft.VisualBasic.Core's MsgBox and InputBox, bind to it. -->
    <ProjectReference Include="..\TabStudio.VisualBasic.Forms\TabStudio.VisualBasic.Forms.csproj" />
    <ProjectReference Include="..\TabStudio.Forms.Design\TabStudio.Forms.Design.csproj" />
    <ProjectReference Include="..\TabStudio.WindowsBridge\TabStudio.WindowsBridge.csproj" />
    <ProjectReference Include="..\TabStudio.Remote\TabStudio.Remote.csproj" />
  </ItemGroup>

  <Import Project="TabStudio.App.WindowsForms.targets" />
  <Import Project="TabStudio.App.VisualBasic.targets" />

  <!-- Automatically bridge to the optional agent/database feature when combined. -->
  <ItemGroup>
    <Compile Remove="ViewModels/WorkspaceViewModel.Services.Database.cs" />
    <Compile Include="ViewModels/WorkspaceViewModel.Services.Database.cs"
             Condition="Exists('$(MSBuildProjectDirectory)/ViewModels/WorkspaceViewModel.Database.cs')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabStudio.App.Tests" />
  </ItemGroup>

</Project>
