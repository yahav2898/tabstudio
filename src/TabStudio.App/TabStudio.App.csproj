<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The IDE itself: views, view models and services, shared by every platform head
    (TabStudio.Android for the product, TabStudio.Desktop for development).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TabStudio.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- The sample solution ships inside the app and is extracted on first use. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\HelloTablet\**\*"
                      Exclude="..\..\samples\HelloTablet\**\bin\**;..\..\samples\HelloTablet\**\obj\**"
                      LogicalName="Samples/HelloTablet/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Editing\TabStudioDark.tmTheme.json" LogicalName="Themes/TabStudioDark.json" />
  </ItemGroup>

  <!-- The Toolbox's controls and the Properties panel's categories, one file per UI framework. -->
  <ItemGroup>
    <EmbeddedResource Include="Toolbox\*.json" LogicalName="Toolbox/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Reads the TabStudio Link host's QR code in camera frames. -->
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabStudio.Core\TabStudio.Core.csproj" />
    <ProjectReference Include="..\TabStudio.Compilation\TabStudio.Compilation.csproj" />
    <ProjectReference Include="..\TabStudio.Packages\TabStudio.Packages.csproj" />
    <ProjectReference Include="..\TabStudio.Agent\TabStudio.Agent.csproj" />
    <ProjectReference Include="..\TabStudio.SourceControl\TabStudio.SourceControl.csproj" />
    <ProjectReference Include="..\TabStudio.Debugging\TabStudio.Debugging.csproj" />
    <ProjectReference Include="..\TabStudio.TestRunner\TabStudio.TestRunner.csproj" />
    <ProjectReference Include="..\TabStudio.LiveTesting\TabStudio.LiveTesting.csproj" />
    <ProjectReference Include="..\TabStudio.Notebooks\TabStudio.Notebooks.csproj" />
    <ProjectReference Include="..\TabStudio.Link\TabStudio.Link.csproj" />
    <ProjectReference Include="..\TabStudio.LanguageServers\TabStudio.LanguageServers.csproj" />
    <ProjectReference Include="..\TabStudio.Extensions\TabStudio.Extensions.csproj" />
    <ProjectReference Include="..\TabStudio.Web\TabStudio.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabStudio.App.Tests" />
  </ItemGroup>

</Project>
