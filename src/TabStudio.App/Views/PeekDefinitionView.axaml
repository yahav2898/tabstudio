<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.PeekDefinitionView"
             x:DataType="vm:PeekDefinitionViewModel">
  <!--
    Peek Definition: a small read-only editor with the definition's file, under the line that uses it. The title
    opens the file as a tab; Escape or the cross closes the peek.
  -->
  <Border CornerRadius="8" ClipToBounds="True"
          Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1,2,1,1"
          BoxShadow="{DynamicResource Shadow.Popup}">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="10,2,4,2" MinHeight="36">
          <Button x:Name="TitleButton" Theme="{StaticResource ToolButton}" HorizontalAlignment="Left" Padding="6,0" ToolTip.Tip="Open as a tab">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Classes="muted small" Text="{Binding SymbolDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <Button x:Name="PreviousButton" Grid.Column="1" Theme="{StaticResource ToolButton}" ToolTip.Tip="Previous definition" IsVisible="{Binding HasSeveral}">
            <controls:StrokeIcon Data="{StaticResource Icon.ChevronUp}" Size="13" />
          </Button>
          <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Position}" VerticalAlignment="Center" Margin="2,0" IsVisible="{Binding HasSeveral}" />
          <Button x:Name="NextButton" Grid.Column="3" Theme="{StaticResource ToolButton}" ToolTip.Tip="Next definition" IsVisible="{Binding HasSeveral}">
            <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="13" />
          </Button>
          <Button x:Name="CloseButton" Grid.Column="4" Theme="{StaticResource ToolButton}" ToolTip.Tip="Close (Esc)">
            <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="13" />
          </Button>
        </Grid>
      </Border>
      <ae:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True" FontFamily="{DynamicResource CodeFont}" FontSize="{DynamicResource Type.Section}"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0,4,0,0" />
    </DockPanel>
  </Border>
</UserControl>
