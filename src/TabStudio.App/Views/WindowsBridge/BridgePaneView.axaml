<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:wb="using:TabStudio.App.ViewModels.WindowsBridge"
             x:Class="TabStudio.App.Views.WindowsBridge.BridgePaneView"
             x:DataType="wb:BridgePaneViewModel">

  <!-- A program on the user's Windows PC, streamed beside the code: pick its window, touch it, type into it. -->

  <UserControl.Styles>
    <Style Selector="Border.overlay">
      <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
    </Style>
    <Style Selector="Border.overlay.away">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.overlay.away > Border.card">
      <Setter Property="Background" Value="{DynamicResource Brush.Popup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderPopup}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10,4,6,4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <controls:StrokeIcon Data="{StaticResource Icon.Computer}" Size="15" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="8,2" VerticalAlignment="Center" Spacing="1">
          <TextBlock Classes="header" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted small" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Theme="{StaticResource ToolButton}" Command="{Binding RestartAppCommand}" ToolTip.Tip="Build again and restart">
            <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="15" />
          </Button>
          <Button Theme="{StaticResource ToolButton}" Command="{Binding StopAppCommand}" ToolTip.Tip="Stop the program on the PC">
            <controls:StrokeIcon Data="{StaticResource Icon.Stop}" IsFilled="True" Size="13" Foreground="{DynamicResource Brush.Error}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The program and its window or dialog, and what to do with the window. -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" IsVisible="{Binding HasSelectedApp}">
      <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,Auto" RowSpacing="4">
        <ComboBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" HorizontalAlignment="Stretch" ToolTip.Tip="Program on the PC">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="wb:BridgeAppViewModel">
              <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="2" ItemsSource="{Binding SelectedApp.Windows, FallbackValue={x:Null}}" SelectedItem="{Binding SelectedWindow}"
                  HorizontalAlignment="Stretch" ToolTip.Tip="Window or dialog">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="wb:BridgeWindowOption">
              <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Display}" /><Run Text="  " /><Run Text="{Binding SizeText}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
          <Button Theme="{StaticResource ToolButton}" Command="{Binding FitWindowCommand}" ToolTip.Tip="Resize the window to fill this pane">
            <controls:StrokeIcon Data="{StaticResource Icon.FitWindow}" Size="15" />
          </Button>
          <Button x:Name="CopyButton" Theme="{StaticResource ToolButton}" IsEnabled="{Binding IsStreaming}" ToolTip.Tip="Copy the PC's clipboard text to this tablet">
            <controls:StrokeIcon Data="{StaticResource Icon.Copy}" Size="15" />
          </Button>
          <Button x:Name="PasteButton" Theme="{StaticResource ToolButton}" IsEnabled="{Binding IsStreaming}" ToolTip.Tip="Put this tablet's clipboard text on the PC">
            <controls:StrokeIcon Data="{StaticResource Icon.Paste}" Size="15" />
          </Button>
          <Button Theme="{StaticResource ToolButton}" Command="{Binding ShowKeyboardCommand}" ToolTip.Tip="Type into the program">
            <controls:StrokeIcon Data="{StaticResource Icon.Keyboard}" Size="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,5" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
            IsVisible="{Binding ClipboardNote, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Classes="muted small" Text="{Binding ClipboardNote}" TextWrapping="Wrap" />
    </Border>

    <Panel>
      <controls:BridgeFrameView x:Name="Frame" Stream="{Binding Stream}" InputSink="{Binding}" WindowScale="{Binding WindowScale}" IsDimmed="{Binding IsPcAway}" />

      <!-- Nothing to show yet, or the PC is away: the last picture stays, dimmed, under the reason. -->
      <Border Classes="overlay" Classes.away="{Binding IsPcAway}" IsVisible="{Binding HasMessage}" IsHitTestVisible="False">
        <Border Classes="card" MaxWidth="400" Margin="24" Padding="20,18" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.Computer}" Size="34" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" />
            <TextBlock Classes="h2" Text="{Binding MessageTitle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Border>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
