<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.VariableListView"
             x:DataType="vm:VariableTreeViewModel">

  <UserControl.Styles>
    <!-- While the program runs, the values shown may be out of date. -->
    <Style Selector="ListBox.stale">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="{DynamicResource CodeFont}" />
      <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <!-- Values that changed since the last pause are red, as in Visual Studio. -->
    <Style Selector="TextBlock.value.changed">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
    </Style>
    <Style Selector="TextBlock.value.error">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Historical · recorded values" IsVisible="{Binding IsHistorical}"
               Classes="muted small" Margin="12,4" />
    <!-- Column headers -->
    <Border DockPanel.Dock="Top" Height="26" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="2*,3*,2*,34" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Classes="muted small" Text="Name" />
        <TextBlock Grid.Column="1" Classes="muted small" Text="Value" />
        <TextBlock Grid.Column="2" Classes="muted small" Text="Type" />
      </Grid>
    </Border>

    <ListBox x:Name="Rows" ItemsSource="{Binding Rows}" ItemContainerTheme="{StaticResource ListRow}"
             Classes.stale="{Binding IsStale}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:VariableViewModel">
          <Grid ColumnDefinitions="2*,3*,2*,34" Height="30" Margin="8,0,0,0" Background="Transparent">
            <!-- Long-press on touch, right-click with a mouse. -->
            <Grid.ContextFlyout>
              <MenuFlyout>
                <MenuItem Header="Add Watch" IsVisible="{Binding !IsError}"
                          Command="{Binding Owner.AddWatchCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                <MenuItem Header="When did this change?" IsVisible="{Binding !IsError}"
                          Command="{Binding Owner.LastWriteCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                <MenuItem Header="Edit Value..." IsVisible="{Binding IsEditable}"
                          Command="{Binding Owner.EditValueCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                <MenuItem Header="Remove Watch" IsVisible="{Binding IsRemovable}"
                          Command="{Binding Owner.RemoveCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
              </MenuFlyout>
            </Grid.ContextFlyout>

            <!-- A grid, not a stack, so a long name trims in its column instead of running into the value. -->
            <Grid x:Name="NameCell" ColumnDefinitions="Auto,18,*" ToolTip.Tip="{Binding Path}">
              <Border Width="{Binding IndentWidth}" />
              <Panel Grid.Column="1" Width="18">
                <Panel IsVisible="{Binding IsExpandable}">
                  <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="13"
                                       Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding !IsExpanded}" />
                  <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="13"
                                       Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding IsExpanded}" />
                </Panel>
              </Panel>
              <TextBlock x:Name="NameText" Grid.Column="2" Text="{Binding Name}" FontFamily="{DynamicResource CodeFont}" FontSize="{DynamicResource Type.Body}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,8,0" />
            </Grid>
            <TextBlock Grid.Column="1" Classes="value" Classes.changed="{Binding HasChanged}" Classes.error="{Binding IsError}"
                       Text="{Binding Value}" ToolTip.Tip="{Binding Value}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" Classes="muted" FontSize="{DynamicResource Type.Body}" Text="{Binding Type}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="3" Theme="{StaticResource ToolButton}" Padding="0"
                    ToolTip.Tip="Remove Watch" IsVisible="{Binding IsRemovable}"
                    Command="{Binding Owner.RemoveCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}">
              <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="11" Foreground="{DynamicResource Brush.TextMuted}" />
            </Button>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
