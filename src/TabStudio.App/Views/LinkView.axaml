<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             xmlns:wbv="using:TabStudio.App.Views.WindowsBridge"
             xmlns:swarmViews="using:TabStudio.App.Views.Swarm"
             x:Class="TabStudio.App.Views.LinkView"
             x:DataType="vm:LinkViewModel">

  <UserControl.DataTemplates>
    <!-- A paired host or tablet. -->
    <DataTemplate DataType="vm:PairedDeviceViewModel">
      <Border MinHeight="58" Padding="12,8" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Brush.Control}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Panel Margin="2,0,14,0" VerticalAlignment="Center">
            <controls:StrokeIcon Data="{StaticResource Icon.Phone}" Size="22" Foreground="{DynamicResource Brush.TextSecondary}" IsVisible="{Binding IsPhone}" />
            <controls:StrokeIcon Data="{StaticResource Icon.Tablet}" Size="22" Foreground="{DynamicResource Brush.TextSecondary}" IsVisible="{Binding IsTablet}" />
            <controls:StrokeIcon Data="{StaticResource Icon.Computer}" Size="22" Foreground="{DynamicResource Brush.TextSecondary}" IsVisible="{Binding IsComputer}" />
          </Panel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Border Classes="pill success" IsVisible="{Binding IsCurrent}">
                <TextBlock Text="Connected" />
              </Border>
            </StackPanel>
            <TextBlock Classes="muted small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2" Theme="{StaticResource AccentButton}" Height="38" MinHeight="38" Padding="16,0" Margin="8,0,0,0"
                  Content="Connect" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" />
          <Button Grid.Column="3" Theme="{StaticResource ToolButton}" Height="38" MinHeight="38" Padding="12,0" Margin="4,0,0,0"
                  Content="Forget" Command="{Binding ForgetCommand}" ToolTip.Tip="Forget this device; it has to pair again" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- The TabStudio Link dialog, drawn over the start screen or the IDE. -->
  <Panel Background="{DynamicResource Brush.Scrim}" IsVisible="{Binding IsOpen}">
    <Border MaxWidth="780" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12"
            Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
            BoxShadow="{DynamicResource Shadow.Dialog}">
      <DockPanel>

        <!-- Title and the two halves -->
        <StackPanel DockPanel.Dock="Top" Margin="22,18,14,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
              <controls:StrokeIcon Data="{StaticResource Icon.Link}" Size="18" Foreground="{DynamicResource Brush.AccentText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Classes="h2" FontSize="{DynamicResource Type.Heading}" Text="TabStudio Link" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="A phone or PC running TabStudio compiles for this device over Wi-Fi. No cloud and no account; the connection is end-to-end encrypted." />
            </StackPanel>
            <Button Grid.Column="2" Theme="{StaticResource ToolButton}" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
              <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="16" />
            </Button>
          </Grid>
          <!-- The tabs wrap onto a second row on a phone, rather than cutting off "Windows PC" and "Join a swarm". -->
          <WrapPanel x:Name="LinkTabs" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsConnectTab}" MinHeight="40"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:LinkTab.Connect}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <controls:StrokeIcon Data="{StaticResource Icon.Tablet}" Size="14" />
                <TextBlock Text="Link to a host" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsHostTab}" MinHeight="40"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:LinkTab.Host}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <controls:StrokeIcon Data="{StaticResource Icon.Phone}" Size="14" />
                <TextBlock Text="Be a host" VerticalAlignment="Center" />
                <Border Classes="pill success" IsVisible="{Binding IsHosting}">
                  <TextBlock Text="On" />
                </Border>
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsBridgeTab}" MinHeight="40" IsVisible="{Binding HasBridge}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:LinkTab.Bridge}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <controls:StrokeIcon Data="{StaticResource Icon.Computer}" Size="14" />
                <TextBlock Text="{Binding Bridge.TabTitle, FallbackValue={x:Null}}" VerticalAlignment="Center" />
                <Border Classes="pill success" IsVisible="{Binding Bridge.IsOn, FallbackValue=False}">
                  <TextBlock Text="On" />
                </Border>
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsSwarmTab}" MinHeight="40" IsVisible="{Binding HasSwarm}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:LinkTab.Swarm}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <controls:StrokeIcon Data="{StaticResource Icon.Swarm}" Size="14" />
                <TextBlock Text="Join a swarm" VerticalAlignment="Center" />
                <Border Classes="pill success" IsVisible="{Binding Swarm.IsInSwarm, FallbackValue=False}">
                  <TextBlock Text="Joined" />
                </Border>
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Divider}" />

        <!-- This device, and Done -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="22,10,16,12">
          <!-- The fingerprint is how both ends are compared before a link is trusted: it wraps, never trims. -->
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Classes="muted small" Text="{Binding DeviceText}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FingerprintLine" Classes="muted small" Text="{Binding FingerprintText}" TextWrapping="Wrap" FontFamily="{DynamicResource CodeFont}" />
          </StackPanel>
          <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Height="40" Padding="20,0" Content="Done" Command="{Binding CloseCommand}" />
        </Grid>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Brush.Divider}" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
          <Panel Margin="22,16,22,16">

            <!-- Link to a host -->
            <StackPanel Spacing="14" IsVisible="{Binding IsConnectTab}">
              <Border Padding="16,14" CornerRadius="10" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Panel Width="12" Height="12" Margin="2,4,14,0" VerticalAlignment="Top">
                    <Ellipse Fill="{DynamicResource Brush.Success}" IsVisible="{Binding IsLinked}" />
                    <Ellipse Fill="{DynamicResource Brush.Warning}" IsVisible="{Binding IsReconnecting}" />
                    <Ellipse Fill="{DynamicResource Brush.Info}" IsVisible="{Binding IsConnecting}" />
                    <Ellipse Fill="{DynamicResource Brush.TextDisabled}" IsVisible="{Binding IsNotLinked}" />
                  </Panel>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClientTitle}" FontSize="{DynamicResource Type.Large}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding ClientDetail}"
                               IsVisible="{Binding ClientDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Height="40" Padding="16,0" Margin="12,0,0,0" VerticalAlignment="Center"
                          Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding CanDisconnect}" />
                </Grid>
              </Border>

              <TextBlock Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding ClientError}"
                         IsVisible="{Binding ClientError, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <StackPanel Spacing="8" IsVisible="{Binding HasPairedHosts}">
                <TextBlock Classes="label" FontWeight="SemiBold" Text="Paired hosts" />
                <ItemsControl ItemsSource="{Binding PairedHosts}" />
              </StackPanel>

              <Border Padding="16,14" CornerRadius="10" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                <StackPanel Spacing="12">
                  <TextBlock Classes="h2" Text="Pair with a new host" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="On the phone or PC, open TabStudio and choose File > TabStudio Link > Be a host. Both devices must be on the same Wi-Fi." />
                  <Button Theme="{StaticResource AccentButton}" Height="44" Padding="18,0" HorizontalAlignment="Left"
                          Command="{Binding ScanCommand}" IsVisible="{Binding CanScan}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <controls:StrokeIcon Data="{StaticResource Icon.Camera}" Size="16" />
                      <TextBlock Text="Scan its QR code" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Or type the address and the code it shows under the QR code:" IsVisible="{Binding CanScan}" />
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Type the address and the code it shows under its QR code:" IsVisible="{Binding !CanScan}" />
                  <!-- In one row on a tablet, the address above the code on a phone's narrow screen (see the code-behind). -->
                  <Grid x:Name="PairGrid" ColumnDefinitions="*,12,190,12,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock x:Name="AddressLabel" Classes="label" Text="Address" Margin="2,0,0,5" />
                    <TextBlock x:Name="CodeLabel" Grid.Column="2" Classes="label" Text="Code" Margin="2,0,0,5" />
                    <TextBox Grid.Row="1" x:Name="AddressBox" Classes="large mono" Watermark="192.168.1.23" Text="{Binding AddressText}" />
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="CodeBox" Classes="large mono" Watermark="XXXX-XXXX" MaxLength="10" Text="{Binding CodeText}" />
                    <Button Grid.Row="1" Grid.Column="4" x:Name="PairButton" Theme="{StaticResource AccentButton}" Height="44" Padding="22,0" Content="Pair" Command="{Binding PairCommand}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}">
                    <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" Text="Connecting and checking that it is the right device…" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Join a swarm -->
            <swarmViews:SwarmJoinView DataContext="{Binding Swarm}" IsVisible="{Binding $parent[UserControl].((vm:LinkViewModel)DataContext).IsSwarmTab, FallbackValue=False}" />

            <!-- Be a host -->
            <StackPanel Spacing="14" IsVisible="{Binding IsHostTab}">

              <!-- Not hosting yet -->
              <Border Padding="18,16" CornerRadius="10" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                      IsVisible="{Binding IsNotHosting}">
                <StackPanel Spacing="12">
                  <TextBlock Classes="h2" Text="Lend this device's power to a tablet" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="While TabStudio stays open here, a paired tablet sends its workspace to this device, which checks the code as it is typed, runs IntelliSense and builds it. Programs, tests and the debugger still run on the tablet." />
                  <StackPanel Spacing="8" Margin="0,2,0,2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <controls:StrokeIcon Data="{StaticResource Icon.Lock}" Size="15" Foreground="{DynamicResource Brush.AccentText}" />
                      <TextBlock Classes="small" TextWrapping="Wrap" Text="Only tablets that paired with the code shown here are served." VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <controls:StrokeIcon Data="{StaticResource Icon.Link}" Size="15" Foreground="{DynamicResource Brush.AccentText}" />
                      <TextBlock Classes="small" TextWrapping="Wrap" Text="Everything between the devices is encrypted with TLS, and each checks the other's certificate." VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <controls:StrokeIcon Data="{StaticResource Icon.Folder}" Size="15" Foreground="{DynamicResource Brush.AccentText}" />
                      <TextBlock Classes="small" TextWrapping="Wrap" Text="The tablet's files stay on the tablet; this device keeps a copy to compile, in its cache." VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="15" Foreground="{DynamicResource Brush.Warning}" />
                      <TextBlock Classes="small" TextWrapping="Wrap" VerticalAlignment="Center"
                                 Text="Compiling runs the analyzers and source generators of the tablet's packages on this device, so pair only tablets you own." />
                    </StackPanel>
                  </StackPanel>
                  <Button Theme="{StaticResource AccentButton}" Height="44" Padding="20,0" HorizontalAlignment="Left" Command="{Binding StartHostingCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <controls:StrokeIcon Data="{StaticResource Icon.Play}" IsFilled="True" Size="14" />
                      <TextBlock Text="Start hosting" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <TextBlock Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding HostError}"
                             IsVisible="{Binding HostError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Border>

              <!-- Hosting -->
              <StackPanel Spacing="14" IsVisible="{Binding IsHosting}">
                <!-- The QR code beside its instructions, or above them on a phone's narrow screen (see the code-behind). -->
                <Grid x:Name="HostCodeGrid" ColumnDefinitions="Auto,22,*" RowDefinitions="Auto,Auto" IsVisible="{Binding HasNetwork}">
                  <Border Width="236" Height="236" CornerRadius="10" Background="{DynamicResource Brush.QrCode.Light}" VerticalAlignment="Top">
                    <controls:QrCodeView Code="{Binding HostQrCode}" />
                  </Border>
                  <StackPanel x:Name="HostCodeText" Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Classes="h2" Text="Scan this with TabStudio on the tablet" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="On the tablet: File > TabStudio Link > Scan its QR code. Without a camera, type these instead:" />
                    <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,6,Auto" Margin="0,4,0,0">
                      <TextBlock Classes="label" Text="Address" VerticalAlignment="Center" />
                      <SelectableTextBlock Grid.Column="2" FontFamily="{DynamicResource CodeFont}" FontSize="{DynamicResource Type.Title}" Foreground="{DynamicResource Brush.TextBright}" Text="{Binding HostAddressText}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="2" Classes="label" Text="Code" VerticalAlignment="Center" />
                      <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <SelectableTextBlock FontFamily="{DynamicResource CodeFont}" FontSize="{DynamicResource Type.Display}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding PairingCodeText}" VerticalAlignment="Center" />
                        <Button Theme="{StaticResource ToolButton}" Height="38" MinHeight="38" Padding="10,0" Command="{Binding NewCodeCommand}" ToolTip.Tip="Draw a new code; the shown one stops working">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="14" />
                            <TextBlock Text="New code" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                    <TextBlock Classes="muted small" TextWrapping="Wrap" Text="The code works once, for ten minutes. A wrong guess replaces it." />
                  </StackPanel>
                </Grid>

                <Border Padding="14,12" CornerRadius="8" Background="{DynamicResource Brush.Control}" IsVisible="{Binding !HasNetwork}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{DynamicResource Brush.Warning}" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="This device is not on a network a tablet can reach. Connect it to the same Wi-Fi as the tablet." />
                  </StackPanel>
                </Border>

                <Border Padding="16,14" CornerRadius="10" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel Width="12" Height="12" Margin="2,4,14,0" VerticalAlignment="Top">
                      <Ellipse Fill="{DynamicResource Brush.Success}" IsVisible="{Binding IsServing}" />
                      <Ellipse Fill="{DynamicResource Brush.TextDisabled}" IsVisible="{Binding !IsServing}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding HostTitle}" FontSize="{DynamicResource Type.Large}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding HostDetail}"
                                 IsVisible="{Binding HostDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StrokeIcon Data="{StaticResource Icon.Thermometer}" Size="13" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Classes="muted small" Text="{Binding HostDeviceText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Height="40" Padding="16,0" Margin="12,0,0,0" VerticalAlignment="Center"
                            Content="Disconnect" Command="{Binding DisconnectTabletCommand}" IsVisible="{Binding IsServing}" />
                  </Grid>
                </Border>

                <StackPanel Spacing="8" IsVisible="{Binding HasPairedTablets}">
                  <TextBlock Classes="label" FontWeight="SemiBold" Text="Paired tablets" />
                  <ItemsControl ItemsSource="{Binding PairedTablets}" />
                </StackPanel>

                <Button Theme="{StaticResource SecondaryButton}" Height="40" Padding="18,0" HorizontalAlignment="Left"
                        Content="Stop hosting" Command="{Binding StopHostingCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- Windows PC: build and run Windows-only projects on a PC, or be that PC -->
            <Panel IsVisible="{Binding IsBridgeTab}">
              <wbv:WindowsBridgeTabView DataContext="{Binding Bridge}" />
            </Panel>
          </Panel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
