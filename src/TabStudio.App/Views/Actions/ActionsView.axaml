<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:conv="using:TabStudio.App.Converters"
             xmlns:actions="using:TabStudio.App.ViewModels.Actions"
             xmlns:views="using:TabStudio.App.Views.Actions"
             x:Class="TabStudio.App.Views.Actions.ActionsView"
             x:DataType="actions:ActionsViewModel"
             Background="{DynamicResource Brush.Panel}">

  <UserControl.Styles>
    <!-- A card around a section's rows, as the Git Changes window draws conflicts. -->
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Brush.Control}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- Title, with the repository and its GitHub page -->
    <Border DockPanel.Dock="Top" Height="36" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,4,0">
        <TextBlock Classes="header" Text="GitHub Actions" />
        <TextBlock Grid.Column="1" Classes="muted small" Margin="8,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding ScopeName}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" IsVisible="{Binding HasScope}">
          <Button Theme="{StaticResource ToolButton}" Classes="iconButton" ToolTip.Tip="Refresh" Command="{Binding RefreshCommand}">
            <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="15" />
          </Button>
          <Button Theme="{StaticResource ToolButton}" Classes="iconButton" ToolTip.Tip="Open on GitHub" Command="{Binding OpenOnGitHubCommand}">
            <controls:StrokeIcon Data="{StaticResource Icon.External}" Size="15" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The GitHub account -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,2,4,2">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <controls:StrokeIcon Data="{StaticResource Icon.User}" Size="15" Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextMuted}" />
        <TextBlock Grid.Column="1" Classes="muted small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{Binding Account.StatusText}" />
        <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Height="36" MinHeight="36" FontSize="12.5" Content="Sign in"
                Foreground="{DynamicResource Brush.Link}" Command="{Binding Account.OpenCommand}" IsVisible="{Binding !Account.IsSignedIn}" />
      </Grid>
    </Border>

    <Panel>
      <!-- Main page: the commit's checks, runs, workflows, watched repositories and notifications. Pull down to refresh. -->
      <RefreshContainer x:Name="Refresher" IsVisible="{Binding IsMainPageVisible}">
        <ScrollViewer x:Name="MainScroller" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12,10,12,16" Spacing="18">

            <!-- A watched repository: the way back to the workspace's -->
            <Button Theme="{StaticResource ToolButton}" Height="36" MinHeight="36" Padding="8,0" HorizontalAlignment="Left"
                    Command="{Binding BackToWorkspaceCommand}" IsVisible="{Binding IsWatchedScope}"
                    ToolTip.Tip="Back to this workspace's repository">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:StrokeIcon Data="{StaticResource Icon.Back}" Size="15" />
                <TextBlock Text="This workspace's repository" VerticalAlignment="Center" FontSize="12.5" />
              </StackPanel>
            </Button>

            <!-- Errors and what the last action did -->
            <StackPanel Spacing="8" IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="15" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Error}" />
                <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" Text="{Binding ErrorText}" />
                <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Classes="iconButton" VerticalAlignment="Top" ToolTip.Tip="Dismiss"
                        Command="{Binding DismissMessagesCommand}">
                  <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="12" />
                </Button>
              </Grid>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding InfoText, Converter={x:Static ObjectConverters.IsNotNull}}">
              <controls:StrokeIcon Data="{StaticResource Icon.Check}" Size="15" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Success}" />
              <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding InfoText}" />
              <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Classes="iconButton" VerticalAlignment="Top" ToolTip.Tip="Dismiss"
                      Command="{Binding DismissMessagesCommand}">
                <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="12" />
              </Button>
            </Grid>

            <!-- Not on GitHub: say so, and keep the watched repositories below -->
            <StackPanel Spacing="8" IsVisible="{Binding !HasScope}">
              <Grid ColumnDefinitions="Auto,*">
                <controls:StrokeIcon Data="{StaticResource Icon.Actions}" Size="20" Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Grid.Column="1" Classes="h2" Text="This folder is not on GitHub" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Publish it from the Git Changes window, or open a repository from GitHub, to see its checks, runs and logs here. You can still watch other repositories below." />
            </StackPanel>

            <!-- This commit's checks -->
            <StackPanel Spacing="6" IsVisible="{Binding IsWorkspaceScope}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section" Text="This commit" />
                <TextBlock Grid.Column="1" Classes="muted small" FontFamily="{DynamicResource CodeFont}" Text="{Binding ChecksHeader}" VerticalAlignment="Center" />
              </Grid>
              <Border Padding="10,8" CornerRadius="8" Background="{Binding CiVisual, Converter={x:Static conv:ActionsConverters.StateSoftBrush}}">
                <Grid ColumnDefinitions="Auto,*">
                  <controls:StrokeIcon Size="18" StrokeThickness="2" Margin="0,0,10,0"
                                       Data="{Binding CiVisual, Converter={x:Static conv:ActionsConverters.StateIcon}}"
                                       Foreground="{Binding CiVisual, Converter={x:Static conv:ActionsConverters.StateBrush}}"
                                       Classes.spinning="{Binding CiVisual, Converter={x:Static conv:ActionsConverters.IsSpinning}}" />
                  <TextBlock Grid.Column="1" Text="{Binding ChecksSummary}" FontWeight="SemiBold" FontSize="12.5"
                             Foreground="{DynamicResource Brush.TextBright}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" Text="{Binding CiErrorText}"
                         IsVisible="{Binding HasCiError}" />
              <ItemsControl ItemsSource="{Binding Checks}" IsVisible="{Binding HasChecks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="actions:CiCheckItemViewModel">
                    <Button Theme="{StaticResource ToolButton}" Height="46" MinHeight="46" Padding="6,0" CornerRadius="6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            ToolTip.Tip="{Binding ToolTip}" Command="{Binding Open}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <controls:StrokeIcon Size="16" StrokeThickness="2" Margin="0,0,10,0"
                                             Data="{Binding Visual, Converter={x:Static conv:ActionsConverters.StateIcon}}"
                                             Foreground="{Binding Visual, Converter={x:Static conv:ActionsConverters.StateBrush}}"
                                             Classes.spinning="{Binding Visual, Converter={x:Static conv:ActionsConverters.IsSpinning}}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.TextBright}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Panel Grid.Column="2" Margin="8,0,2,0">
                          <controls:StrokeIcon Data="{StaticResource Icon.Log}" Size="14" Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding OpensLog}" />
                          <controls:StrokeIcon Data="{StaticResource Icon.External}" Size="13" Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding !OpensLog}" />
                        </Panel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Runs -->
            <StackPanel Spacing="6" IsVisible="{Binding HasScope}">
              <TextBlock Classes="section" Text="Runs" />
              <Grid ColumnDefinitions="*,6,*">
                <ComboBox x:Name="BranchFilterBox" HorizontalAlignment="Stretch" ItemsSource="{Binding BranchFilters}" SelectedItem="{Binding BranchFilter}"
                          ToolTip.Tip="Which branches">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="actions:RunBranchFilter">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StrokeIcon Data="{StaticResource Icon.Branch}" Size="13" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" x:Name="WorkflowFilterBox" HorizontalAlignment="Stretch" ItemsSource="{Binding WorkflowFilters}" SelectedItem="{Binding WorkflowFilter}"
                          ToolTip.Tip="Which workflows">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="actions:RunWorkflowFilter">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StrokeIcon Data="{StaticResource Icon.Workflow}" Size="13" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <ProgressBar IsIndeterminate="True" Width="120" Margin="0,6" HorizontalAlignment="Left" IsVisible="{Binding IsLoadingRuns}" />
              <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" Text="{Binding RunsErrorText}"
                         IsVisible="{Binding RunsErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="muted small" Margin="2,4" Text="{Binding NoRunsText}" IsVisible="{Binding ShowsNoRuns}" />
              <ItemsControl ItemsSource="{Binding Runs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="actions:WorkflowRunItemViewModel">
                    <Button Theme="{StaticResource ToolButton}" MinHeight="60" Padding="6,7" CornerRadius="6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                            ToolTip.Tip="Show the run's jobs and steps" Command="{Binding Open}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*">
                        <controls:StrokeIcon Size="16" StrokeThickness="2" Margin="0,1,10,0" VerticalAlignment="Top"
                                             Data="{Binding Visual, Converter={x:Static conv:ActionsConverters.StateIcon}}"
                                             Foreground="{Binding Visual, Converter={x:Static conv:ActionsConverters.StateBrush}}"
                                             Classes.spinning="{Binding Visual, Converter={x:Static conv:ActionsConverters.IsSpinning}}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="small" TextTrimming="CharacterEllipsis"><Run
                            Text="{Binding Workflow}" Foreground="{DynamicResource Brush.TextSecondary}" /><Run
                            Text=" · " Foreground="{DynamicResource Brush.TextMuted}" /><Run
                            Text="{Binding Trigger}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
                          <TextBlock Classes="muted small" Text="{Binding Footer}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Workflows, with Run workflow... for those that can be run by hand -->
            <StackPanel Spacing="6" IsVisible="{Binding HasWorkflows}">
              <TextBlock Classes="section" Text="Workflows" />
              <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" Text="{Binding WorkflowsErrorText}"
                         IsVisible="{Binding WorkflowsErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ItemsControl ItemsSource="{Binding Workflows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="actions:WorkflowItemViewModel">
                    <Border Classes="card" Margin="0,0,0,6" Padding="10,8,6,8">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <controls:StrokeIcon Data="{StaticResource Icon.Workflow}" Size="16" Margin="0,2,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.TextMuted}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted small" Text="{Binding Path}" FontFamily="{DynamicResource CodeFont}" FontSize="11" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted small" Text="{Binding Note}" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Height="36" Padding="10,0" Margin="8,0,0,0" FontSize="12.5"
                                VerticalAlignment="Center" ToolTip.Tip="Run workflow..." Command="{Binding Run}" CommandParameter="{Binding}"
                                IsVisible="{Binding CanDispatch}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:StrokeIcon Data="{StaticResource Icon.Play}" IsFilled="True" Size="11" Foreground="{DynamicResource Brush.AccentText}" />
                            <TextBlock Text="Run workflow" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Watched repositories -->
            <StackPanel Spacing="6">
              <TextBlock Classes="section" Text="Watched repositories" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding !HasWatched}"
                         Text="Follow other repositories' CI here, such as your team's: add one by owner/name or its GitHub address." />
              <ItemsControl ItemsSource="{Binding Watched}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="actions:WatchedRepositoryItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                      <Button Theme="{StaticResource ToolButton}" Height="48" MinHeight="48" Padding="6,0" CornerRadius="6"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              ToolTip.Tip="Show this repository's runs" Command="{Binding Open}" CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*">
                          <controls:StrokeIcon Size="16" StrokeThickness="2" Margin="0,0,10,0"
                                               Data="{Binding Visual, Converter={x:Static conv:ActionsConverters.StateIcon}}"
                                               Foreground="{Binding Visual, Converter={x:Static conv:ActionsConverters.StateBrush}}"
                                               Classes.spinning="{Binding Visual, Converter={x:Static conv:ActionsConverters.IsSpinning}}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding FullName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted small" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Button>
                      <Button Grid.Column="1" Theme="{StaticResource ToolButton}" Classes="iconButton" Margin="2,0,0,0" VerticalAlignment="Center"
                              ToolTip.Tip="Stop watching" Command="{Binding Remove}" CommandParameter="{Binding}">
                        <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="12" Foreground="{DynamicResource Brush.TextMuted}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="WatchBox" Text="{Binding WatchText}" MinHeight="36" Watermark="owner/name or GitHub address" />
                <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Height="36" Padding="12,0" Margin="6,0,0,0" FontSize="12.5"
                        Command="{Binding AddWatchedCommand}" ToolTip.Tip="Watch this repository's runs">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:StrokeIcon Data="{StaticResource Icon.Watch}" Size="14" />
                    <TextBlock Text="Watch" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" Text="{Binding WatchErrorText}"
                         IsVisible="{Binding WatchErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <!-- Notifications -->
            <StackPanel Spacing="8">
              <TextBlock Classes="section" Text="Notifications" />
              <CheckBox IsChecked="{Binding NotifyWhenRunsFinish}">
                <StackPanel Spacing="2">
                  <TextBlock Text="Tell me when a run finishes" />
                  <TextBlock Classes="muted small" TextWrapping="Wrap"
                             Text="Runs on this branch, and runs you start or re-run here. Only while TabStudio is running." />
                </StackPanel>
              </CheckBox>
              <CheckBox IsChecked="{Binding UseSystemNotifications}" IsVisible="{Binding AreSystemNotificationsSupported}"
                        IsEnabled="{Binding NotifyWhenRunsFinish}">
                <StackPanel Spacing="2">
                  <TextBlock Text="Also in Android's notifications" />
                  <TextBlock Classes="muted small" TextWrapping="Wrap"
                             Text="While TabStudio is in the background, as long as Android keeps it running. Android asks you to allow this the first time." />
                </StackPanel>
              </CheckBox>
              <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" Text="{Binding NotificationsErrorText}"
                         IsVisible="{Binding NotificationsErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </RefreshContainer>

      <!-- A run's details -->
      <views:RunDetailsView DataContext="{Binding RunDetails}" IsVisible="{Binding $parent[UserControl].((actions:ActionsViewModel)DataContext).IsRunDetailsOpen}" />
    </Panel>
  </DockPanel>
</UserControl>
