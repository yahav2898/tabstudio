<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels" xmlns:views="using:TabStudio.App.Views"
             x:Class="TabStudio.App.Views.Toolchains.SerialMonitorView" x:DataType="vm:SerialMonitorViewModel">
  <!--
    View > Serial Monitor, in the bottom dock beside the Output: a toolbar with the USB device, its speed and interface,
    Refresh and Connect, the board's output, and the line to send. With no device attached it says how to attach one.
  -->
  <UserControl.Styles>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="WrapPanel.toolbar > :is(Control)">
      <Setter Property="Margin" Value="0,2,8,2" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <WrapPanel Classes="toolbar">
        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinWidth="200" MaxWidth="360" IsEnabled="{Binding !IsConnected}"
                  PlaceholderText="No USB device" AutomationProperties.Name="USB device" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="Baud" VerticalAlignment="Center" />
          <TextBox Text="{Binding Baud}" Width="96" IsEnabled="{Binding !IsConnected}" AutomationProperties.Name="Baud"
                   ToolTip.Tip="Speed in bits per second; 8 data bits, no parity, 1 stop bit (8-N-1)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="label" Text="Interface" VerticalAlignment="Center" />
          <TextBox Text="{Binding Interface}" Watermark="Auto" Width="64" IsEnabled="{Binding !IsConnected}" AutomationProperties.Name="Interface"
                   ToolTip.Tip="The adapter's interface number, for adapters with more than one port" />
        </StackPanel>
        <Button Theme="{StaticResource ToolButton}" Classes="tool icon" ToolTip.Tip="Refresh the USB devices" Command="{Binding RefreshCommand}"
                IsEnabled="{Binding !IsConnected}">
          <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="16" />
        </Button>
        <Button Theme="{StaticResource AccentButton}" Classes="tool" Content="Connect" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}" />
        <Button Theme="{StaticResource SecondaryButton}" Classes="tool" Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" />
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding Input}" Classes="mono" Watermark="A line to send, in UTF-8, ending in LF" IsEnabled="{Binding IsConnected}"
                 AutomationProperties.Name="Line to send" />
        <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Classes="tool" Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding IsConnected}" />
      </Grid>
    </Border>
    <Panel>
      <views:OutputView DataContext="{Binding Output}" />
      <ScrollViewer IsVisible="{Binding ShowsEmptyState}" HorizontalScrollBarVisibility="Disabled">
        <controls:EmptyState Icon="{StaticResource Icon.Link}" Title="No serial device" IsCompact="True"
                             Message="Attach the board's USB serial adapter with a USB-OTG cable, then refresh. Android asks to allow TabStudio to use it."
                             ActionText="Refresh" ActionCommand="{Binding RefreshCommand}" />
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
