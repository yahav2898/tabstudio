<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.Toolchains.ToolchainOverlaysView"
             x:DataType="vm:WorkspaceViewModel">

  <UserControl.Styles>
    <Style Selector="Border.storeRow">
      <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="Border.storeRow.highlighted">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Toolchains.Ready}" />
    </Style>
    <!-- A toolchain's actions: beside its text, or on a narrow screen under it, so the text keeps its width. -->
    <Style Selector="StackPanel.storeActions">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Margin" Value="14,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.store.narrow StackPanel.storeActions">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="ProgressBar.install">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Control}" />
      <Setter Property="MinHeight" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="2.5" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- The notices, one under the other below the toolbar at the top right, so they never cover each other or Run. -->
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,98,20,0" Spacing="10" ZIndex="2">
    <!-- A program listens on a port: open it in the web preview or the browser. -->
    <Border x:Name="ServerNotice" IsVisible="{Binding ServerNotice, Converter={x:Static ObjectConverters.IsNotNull}}" MaxWidth="390"
            Padding="16,12,8,14" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Popup}"
            BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1" BoxShadow="{DynamicResource Shadow.Popup}">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" DataContext="{Binding ServerNotice}" x:DataType="vm:ServerNoticeViewModel">
        <Border Width="30" Height="30" CornerRadius="{StaticResource Radius.Button}" Background="{DynamicResource Brush.AccentSoft}" Margin="0,2,12,0" VerticalAlignment="Top">
          <controls:StrokeIcon Data="{StaticResource Icon.Globe}" Size="16" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource Type.Large}" Foreground="{DynamicResource Brush.TextBright}"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Padding="0" Margin="6,-2,0,0"
                VerticalAlignment="Top" ToolTip.Tip="Dismiss" Command="{Binding Dismiss}">
          <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="14" />
        </Button>
        <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
          <Button Theme="{StaticResource AccentButton}" Padding="14,0" Margin="0,0,8,0" Content="Open in Preview" Command="{Binding OpenPreview}" />
          <Button Theme="{StaticResource SecondaryButton}" Padding="14,0" Content="Open in Browser" Command="{Binding OpenBrowser}" />
        </WrapPanel>
      </Grid>
    </Border>
    <!-- An offer about the startup project: install its toolchain, or its packages. -->
    <Border IsVisible="{Binding HasToolchainNotice}" Width="390"
            Padding="16,14" CornerRadius="10" Background="{DynamicResource Brush.Popup}"
            BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1" BoxShadow="{DynamicResource Shadow.Popup}">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" DataContext="{Binding ToolchainNotice}" x:DataType="vm:ToolchainNoticeViewModel">
        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
          <controls:StrokeIcon Data="{StaticResource Icon.Package}" Size="16" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource Type.Large}" Foreground="{DynamicResource Brush.TextBright}"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Padding="0" Margin="6,-4,-6,0"
                VerticalAlignment="Top" ToolTip.Tip="Not now" Command="{Binding Dismiss}">
          <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="13" />
        </Button>
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" FontSize="{DynamicResource Type.Body}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Message}" />
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Theme="{StaticResource AccentButton}" Padding="14,0" Content="{Binding ActionText}" Command="{Binding Action}" />
          <Button Theme="{StaticResource SecondaryButton}" Padding="14,0" Content="Not now" Command="{Binding Dismiss}" />
        </StackPanel>
      </Grid>
    </Border>
    </StackPanel>

    <!-- The Toolchain Store. -->
    <Panel x:Name="StoreScrim" Background="{DynamicResource Brush.Scrim}" IsVisible="{Binding ToolchainStore.IsOpen}">
      <Border x:Name="Store" Classes="store" MaxWidth="860" MaxHeight="680" Margin="28" HorizontalAlignment="Stretch" VerticalAlignment="Center"
              CornerRadius="{StaticResource Radius.Dialog}"
              Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
              BoxShadow="{DynamicResource Shadow.Dialog}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" DataContext="{Binding ToolchainStore}" x:DataType="vm:ToolchainStoreViewModel">
          <!-- Header -->
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,20,16,14">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0">
              <controls:StrokeIcon Data="{StaticResource Icon.Package}" Size="20" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="h2" FontSize="{DynamicResource Type.Title}" Text="Toolchain Store" />
              <TextBlock Classes="muted" FontSize="{DynamicResource Type.Body}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subtitle}" />
            </StackPanel>
            <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Padding="0"
                    VerticalAlignment="Top" ToolTip.Tip="Close" Command="{Binding CloseCommand}">
              <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="15" />
            </Button>
          </Grid>

          <Border Grid.Row="1" IsVisible="{Binding HasNotice}" Margin="22,0,22,12" Padding="12,10" CornerRadius="8" Background="{DynamicResource Brush.Control}">
            <Grid ColumnDefinitions="Auto,*">
              <controls:StrokeIcon Data="{StaticResource Icon.Info}" Size="15" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="{DynamicResource Type.Body}" TextWrapping="Wrap" Text="{Binding Notice}" />
            </Grid>
          </Border>

          <!-- The toolchains -->
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" Margin="22,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ToolchainItemViewModel">
                  <Border Classes="storeRow" Classes.highlighted="{Binding IsHighlighted}">
                    <!-- The tile on the left, the actions on the right, and the text wrapping in the space between. -->
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="11" Background="{Binding BadgeBrush}" VerticalAlignment="Top" Margin="0,2,14,0">
                        <TextBlock Text="{Binding Badge}" FontWeight="Bold" FontSize="{DynamicResource Type.Heading}" Foreground="{DynamicResource Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Classes="storeActions" Orientation="Horizontal" Spacing="8">
                        <Button Theme="{StaticResource AccentButton}" Padding="16,0" IsVisible="{Binding ShowsPrimaryInstall}" Command="{Binding InstallCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <controls:StrokeIcon Data="{StaticResource Icon.Download}" Size="14" Foreground="{DynamicResource Brush.OnAccent}" />
                            <TextBlock Text="Install" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Theme="{StaticResource SecondaryButton}" Padding="16,0" IsVisible="{Binding ShowsSecondaryInstall}" Command="{Binding InstallCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <controls:StrokeIcon Data="{StaticResource Icon.Download}" Size="14" />
                            <TextBlock Text="Install" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Theme="{StaticResource AccentButton}" Padding="16,0" Content="Update" IsVisible="{Binding ShowsUpdate}" Command="{Binding UpdateCommand}" />
                        <Button Theme="{StaticResource SecondaryButton}" Padding="14,0" Content="Remove" IsVisible="{Binding ShowsRemove}" Command="{Binding RemoveCommand}" />
                        <Button Theme="{StaticResource SecondaryButton}" Padding="14,0" Content="Cancel" IsVisible="{Binding ShowsCancel}" Command="{Binding CancelCommand}" />
                      </StackPanel>
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource Type.Subtitle}" Foreground="{DynamicResource Brush.TextBright}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding VersionText}" Classes="mono muted" FontSize="{DynamicResource Type.Body}" VerticalAlignment="Center" />
                          <Border Classes="pill" Classes.success="{Binding IsInstalled}" Classes.warning="{Binding HasUpdate}" Classes.ready="{Binding IsBusy}">
                            <TextBlock Text="{Binding StateText}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="{DynamicResource Type.Body}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Description}" />
                        <TextBlock FontSize="{DynamicResource Type.Small}" Foreground="{DynamicResource Brush.TextLabel}" TextWrapping="Wrap">
                          <Run Text="{Binding Languages}" />
                          <Run Text="  ·  " Foreground="{DynamicResource Brush.TextDisabled}" />
                          <Run Text="{Binding SizeText}" />
                        </TextBlock>
                        <StackPanel Spacing="5" Margin="0,6,0,0" IsVisible="{Binding HasProgress}">
                          <ProgressBar Classes="install" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                          <TextBlock Classes="muted small" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProgressText}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0" IsVisible="{Binding HasError}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="13" Margin="0,1,6,0" Foreground="{DynamicResource Brush.Error}" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Text="{Binding Error}" FontSize="{DynamicResource Type.Small}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="muted small" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Disk usage -->
          <Border Grid.Row="3" Margin="0,14,0,0" Padding="22,12" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <controls:StrokeIcon Data="{StaticResource Icon.Solution}" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource Type.Body}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DiskUsageText}">
                <Run Text="{Binding DiskUsageText}" Foreground="{DynamicResource Brush.TextSecondary}" />
                <Run Text="   " />
                <Run Text="{Binding FreeSpaceText}" Foreground="{DynamicResource Brush.TextMuted}" />
              </TextBlock>
              <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Padding="12,0" Command="{Binding CheckForUpdatesCommand}"
                      IsVisible="{Binding CanInstallHere}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="13" />
                  <TextBlock Text="Check for Updates" FontSize="{DynamicResource Type.Body}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Panel>
  </Panel>
</UserControl>
