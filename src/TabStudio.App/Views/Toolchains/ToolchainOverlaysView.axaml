<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.Toolchains.ToolchainOverlaysView"
             x:DataType="vm:WorkspaceViewModel">

  <UserControl.Styles>
    <Style Selector="Border.storeRow">
      <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="Border.storeRow.highlighted">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Background" Value="#1A2B2A" />
    </Style>
    <Style Selector="Border.state">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="Background" Value="{DynamicResource Brush.Pill}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.state > TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
    <Style Selector="Border.state.installed">
      <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
    </Style>
    <Style Selector="Border.state.installed > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
    </Style>
    <Style Selector="Border.state.update">
      <Setter Property="Background" Value="#2E2A1B" />
    </Style>
    <Style Selector="Border.state.update > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <Style Selector="Border.state.busy">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
    </Style>
    <Style Selector="Border.state.busy > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>
    <Style Selector="ProgressBar.install">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Control}" />
      <Setter Property="MinHeight" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- An offer about the startup project: install its toolchain, or its packages. -->
    <Border IsVisible="{Binding HasToolchainNotice}" Width="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,98,20,0"
            Padding="16,14" CornerRadius="10" Background="{DynamicResource Brush.Popup}"
            BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1" BoxShadow="0 10 28 0 #59000000">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" DataContext="{Binding ToolchainNotice}" x:DataType="vm:ToolchainNoticeViewModel">
        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
          <controls:StrokeIcon Data="{StaticResource Icon.Package}" Size="16" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.TextBright}"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0" Margin="6,-4,-6,0"
                VerticalAlignment="Top" ToolTip.Tip="Not now" Command="{Binding Dismiss}">
          <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="13" />
        </Button>
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Message}" />
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Theme="{StaticResource AccentButton}" Height="34" MinHeight="34" Padding="14,0" Content="{Binding ActionText}" Command="{Binding Action}" />
          <Button Theme="{StaticResource SecondaryButton}" Height="34" MinHeight="34" Padding="14,0" Content="Not now" Command="{Binding Dismiss}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The Toolchain Store. -->
    <Panel Background="#99000000" IsVisible="{Binding ToolchainStore.IsOpen}">
      <Border MaxWidth="860" MaxHeight="680" Margin="28" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="14"
              Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
              BoxShadow="0 16 40 0 #73000000">
        <Grid RowDefinitions="Auto,Auto,*,Auto" DataContext="{Binding ToolchainStore}" x:DataType="vm:ToolchainStoreViewModel">
          <!-- Header -->
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,20,16,14">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,14,0">
              <controls:StrokeIcon Data="{StaticResource Icon.Package}" Size="20" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="h2" FontSize="18" Text="Toolchain Store" />
              <TextBlock Classes="muted" FontSize="12.5" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Width="36" Height="36" MinWidth="36" MinHeight="36" Padding="0"
                    VerticalAlignment="Top" ToolTip.Tip="Close" Command="{Binding CloseCommand}">
              <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="15" />
            </Button>
          </Grid>

          <Border Grid.Row="1" IsVisible="{Binding HasNotice}" Margin="22,0,22,12" Padding="12,10" CornerRadius="8" Background="{DynamicResource Brush.Control}">
            <Grid ColumnDefinitions="Auto,*">
              <controls:StrokeIcon Data="{StaticResource Icon.Info}" Size="15" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Notice}" />
            </Grid>
          </Border>

          <!-- The toolchains -->
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Padding="22,0,22,0">
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ToolchainItemViewModel">
                  <Border Classes="storeRow" Classes.highlighted="{Binding IsHighlighted}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="46" Height="46" CornerRadius="11" Background="{Binding BadgeBrush}" VerticalAlignment="Top" Margin="0,2,14,0">
                        <TextBlock Text="{Binding Badge}" FontWeight="Bold" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Brush.TextBright}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding VersionText}" Classes="mono muted" FontSize="12.5" VerticalAlignment="Center" />
                          <Border Classes="state" Classes.installed="{Binding IsInstalled}" Classes.update="{Binding HasUpdate}" Classes.busy="{Binding IsBusy}">
                            <TextBlock Text="{Binding StateText}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextLabel}" TextWrapping="Wrap">
                          <Run Text="{Binding Languages}" />
                          <Run Text="  ·  " Foreground="{DynamicResource Brush.TextDisabled}" />
                          <Run Text="{Binding SizeText}" />
                        </TextBlock>
                        <StackPanel Spacing="5" Margin="0,6,0,0" IsVisible="{Binding HasProgress}">
                          <ProgressBar Classes="install" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
                          <TextBlock Classes="muted small" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0" IsVisible="{Binding HasError}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="13" Margin="0,1,6,0" Foreground="{DynamicResource Brush.Error}" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="muted small" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button Theme="{StaticResource AccentButton}" Height="36" MinHeight="36" Padding="16,0" IsVisible="{Binding ShowsInstall}" Command="{Binding InstallCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <controls:StrokeIcon Data="{StaticResource Icon.Download}" Size="14" Foreground="{DynamicResource Brush.OnAccent}" />
                            <TextBlock Text="Install" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Theme="{StaticResource AccentButton}" Height="36" MinHeight="36" Padding="16,0" Content="Update" IsVisible="{Binding ShowsUpdate}" Command="{Binding UpdateCommand}" />
                        <Button Theme="{StaticResource SecondaryButton}" Height="36" MinHeight="36" Padding="14,0" Content="Remove" IsVisible="{Binding ShowsRemove}" Command="{Binding RemoveCommand}" />
                        <Button Theme="{StaticResource SecondaryButton}" Height="36" MinHeight="36" Padding="14,0" Content="Cancel" IsVisible="{Binding ShowsCancel}" Command="{Binding CancelCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Disk usage -->
          <Border Grid.Row="3" Margin="0,14,0,0" Padding="22,12" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <controls:StrokeIcon Data="{StaticResource Icon.Solution}" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding DiskUsageText}" Foreground="{DynamicResource Brush.TextSecondary}" />
                <Run Text="   " />
                <Run Text="{Binding FreeSpaceText}" Foreground="{DynamicResource Brush.TextMuted}" />
              </TextBlock>
              <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Height="34" MinHeight="34" Padding="12,0" Command="{Binding CheckForUpdatesCommand}"
                      IsVisible="{Binding CanInstallHere}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="13" />
                  <TextBlock Text="Check for Updates" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Panel>
  </Panel>
</UserControl>
