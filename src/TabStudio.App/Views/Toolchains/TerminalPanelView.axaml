<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.Toolchains.TerminalPanelView"
             x:DataType="vm:TerminalViewModel">

  <UserControl.Styles>
    <!-- The on-screen keys: they never take the focus, so the keyboard stays up while they are tapped. -->
    <Style Selector="Button.key">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontFamily" Value="{DynamicResource CodeFont}" />
      <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="Button.key.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Button.key.selected">
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    </Style>
  </UserControl.Styles>

  <DockPanel Background="{DynamicResource Brush.Terminal.Background}">
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
            Padding="6,4" IsVisible="{Binding !ShowsMessage}">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="Esc" Command="{Binding PressKeyCommand}" CommandParameter="Escape" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="Tab" Command="{Binding PressKeyCommand}" CommandParameter="Tab" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="Ctrl" Classes.selected="{Binding IsControlLatched}" Command="{Binding ToggleControlCommand}" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="Alt" Classes.selected="{Binding IsAltLatched}" Command="{Binding ToggleAltCommand}" />
          <Border Classes="toolbarSeparator" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="←" Command="{Binding PressKeyCommand}" CommandParameter="Left" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="↑" Command="{Binding PressKeyCommand}" CommandParameter="Up" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="↓" Command="{Binding PressKeyCommand}" CommandParameter="Down" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="→" Command="{Binding PressKeyCommand}" CommandParameter="Right" />
          <Border Classes="toolbarSeparator" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="Home" Command="{Binding PressKeyCommand}" CommandParameter="Home" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="End" Command="{Binding PressKeyCommand}" CommandParameter="End" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="PgUp" Command="{Binding PressKeyCommand}" CommandParameter="PageUp" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="PgDn" Command="{Binding PressKeyCommand}" CommandParameter="PageDown" />
          <Border Classes="toolbarSeparator" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="|" Command="{Binding TypeCommand}" CommandParameter="|" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="~" Command="{Binding TypeCommand}" CommandParameter="~" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="/" Command="{Binding TypeCommand}" CommandParameter="/" />
          <Button Theme="{StaticResource SecondaryButton}" Classes="key" Content="-" Command="{Binding TypeCommand}" CommandParameter="-" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Panel>
      <controls:TerminalView x:Name="Screen" Terminal="{Binding}" FontSize="{DynamicResource Type.Section}" Margin="10,6,2,0" />

      <!-- Instead of the shell: the first-time setup, or why the shell cannot start. -->
      <Border IsVisible="{Binding ShowsMessage}" Background="{DynamicResource Brush.Toolbar}">
        <Grid ColumnDefinitions="Auto,*" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
          <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top" Margin="0,0,16,0">
            <controls:StrokeIcon Data="{StaticResource Icon.Terminal}" Size="21" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Classes="h2" FontSize="{DynamicResource Type.Heading}" Text="Terminal" />
            <TextBlock Classes="muted" FontSize="{DynamicResource Type.Section}" TextWrapping="Wrap" Text="{Binding Message}" />
            <StackPanel Spacing="6" IsVisible="{Binding IsSettingUp}">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding SetupProgress}" Height="5" MinHeight="5" CornerRadius="3"
                           Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Control}" />
              <TextBlock Classes="muted small" Text="{Binding SetupText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Theme="{StaticResource AccentButton}" Content="Set Up the Terminal"
                      IsVisible="{Binding NeedsSetup}" Command="{Binding SetUpCommand}" />
              <Button Theme="{StaticResource SecondaryButton}" Padding="14,0" Content="Try Again"
                      IsVisible="{Binding !NeedsSetup}" Command="{Binding RestartCommand}" />
              <Button Theme="{StaticResource SecondaryButton}" Padding="14,0" Content="Toolchain Store"
                      Command="{Binding OpenStoreCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
