<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:agent="using:TabStudio.App.ViewModels.Agent"
             xmlns:local="using:TabStudio.Agent.Local"
             x:Class="TabStudio.App.Views.AgentPanelView"
             x:DataType="agent:AgentPanelViewModel">

  <!--
    The agent tool window: the conversation with Claude, the changes it proposes with Keep and Undo, and its
    settings. Sized for a side bar: everything wraps, and every action is a button large enough to tap.
  -->

  <UserControl.Styles>
    <Style Selector="TextBlock.diff">
      <Setter Property="FontFamily" Value="{DynamicResource CodeFont}" />
      <Setter Property="FontSize" Value="{DynamicResource Type.Fine}" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header: where the agent runs, and the model and the tokens used so far, under the title -->
    <Border DockPanel.Dock="Top" MinHeight="44" Padding="12,4,4,4" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <controls:StrokeIcon Data="{StaticResource Icon.Agent}" Size="16" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="header" Text="Agent" />
            <Border Classes="pill" Classes.ready="{Binding IsLocalMode}" ToolTip.Tip="{Binding PrivacyBadge}">
              <TextBlock Text="{Binding PrivacyPill}" />
            </Border>
          </StackPanel>
          <TextBlock Classes="muted small" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModelLabel}">
            <Run Text="{Binding ModelLabel}" />
            <Run Text="{Binding UsageSuffix}" />
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="2" Theme="{StaticResource ToolButton}" ToolTip.Tip="New Conversation" Command="{Binding NewConversationCommand}">
          <controls:StrokeIcon Data="{StaticResource Icon.NewFile}" Size="16" />
        </Button>
        <Button Grid.Column="3" Theme="{StaticResource ToolButton}" ToolTip.Tip="Agent Settings" Command="{Binding OpenSettingsCommand}"
                Classes.selected="{Binding IsSettingsOpen}">
          <controls:StrokeIcon Data="{StaticResource Icon.Gear}" Size="16" />
        </Button>
      </Grid>
    </Border>

    <!--
      Settings: where the agent runs (Claude with an API key, or a model on this device), the on-device model that also
      writes inline completions, the instructions for every conversation and the MCP servers, then Save.
    -->
    <ScrollViewer x:Name="Settings" IsVisible="{Binding IsSettingsOpen}" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Styles>
        <Style Selector="TextBox, ComboBox">
          <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
        </Style>
        <Style Selector="CheckBox">
          <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
        </Style>
        <Style Selector="Button.action">
          <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
          <Setter Property="Padding" Value="14,0" />
        </Style>
      </ScrollViewer.Styles>
      <StackPanel Margin="12,12,12,16" Spacing="8">
        <TextBlock Classes="h2" Text="Agent settings" />
        <CheckBox Content="Local mode: a model on this device" IsChecked="{Binding UseLocalMode}" />
        <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding UseLocalMode}"
                   Text="The local agent reads files and proposes changes, offline. It has no cloud, MCP, shell or network tools." />
        <StackPanel Spacing="8" IsVisible="{Binding !UseLocalMode}">
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="The agent uses your own Claude API key, from console.anthropic.com. It is kept in TabStudio's private storage on this device and sent only to Claude's API." />
          <TextBlock Classes="label" Text="API key" />
          <TextBox Classes="mono" PasswordChar="•" Watermark="sk-ant-..." Text="{Binding ApiKeyText}" AutomationProperties.Name="API key" />
          <TextBlock Classes="label" Text="Model" />
          <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" HorizontalAlignment="Stretch" AutomationProperties.Name="Model" />
        </StackPanel>

        <!-- The on-device model: the local agent's, and inline completions' in any mode. -->
        <StackPanel Spacing="8" IsVisible="{Binding LocalAI, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="h2" Text="On-device model" Margin="0,8,0,0" />
        <StackPanel DataContext="{Binding LocalAI}" x:DataType="agent:LocalAIViewModel" Spacing="8">
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Downloads come from Hugging Face; the model then runs offline. It writes inline completions, and the agent's answers in local mode." />
          <StackPanel Spacing="8" IsEnabled="{Binding !IsBusy}">
            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" HorizontalAlignment="Stretch" AutomationProperties.Name="On-device model">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="local:LocalModel">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Classes="muted small" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="small"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <CheckBox Content="Inline completions: Tab accepts" IsChecked="{Binding InlineEnabled}" />
            <Expander Header="The model's license" HorizontalAlignment="Stretch">
              <ScrollViewer MaxHeight="260">
                <TextBlock Text="{Binding LicenseText}" TextWrapping="Wrap" Classes="small" />
              </ScrollViewer>
            </Expander>
            <CheckBox Content="I accept the model's license" IsChecked="{Binding LicenseAccepted}" />
            <WrapPanel>
              <Button Theme="{StaticResource SecondaryButton}" Classes="action" Margin="0,0,8,8" Command="{Binding DownloadCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:StrokeIcon Data="{StaticResource Icon.Download}" Size="14" VerticalAlignment="Center" />
                  <TextBlock Text="Download" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Theme="{StaticResource SecondaryButton}" Classes="action" Margin="0,0,8,8" Content="Unload from Memory" Command="{Binding UnloadCommand}" />
              <Button Theme="{StaticResource SecondaryButton}" Classes="action" Margin="0,0,8,8" Command="{Binding DeleteCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <controls:StrokeIcon Data="{StaticResource Icon.Trash}" Size="14" VerticalAlignment="Center" />
                  <TextBlock Text="Delete" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsBusy}">
            <controls:LoadingState IsInline="True" Message="{Binding ProgressText}" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Classes="action" Content="Cancel" Command="{Binding CancelDownloadCommand}" />
          </Grid>
          <Panel IsVisible="{Binding !IsBusy}">
            <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Classes="muted small"
                       IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Panel>
        </StackPanel>
        </StackPanel>

        <TextBlock Classes="h2" Text="Every conversation" Margin="0,8,0,0" />
        <TextBlock Classes="label" Text="Instructions" />
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Watermark="For example: Use file-scoped namespaces. Write xUnit tests."
                 Text="{Binding InstructionsText}" AutomationProperties.Name="Instructions" />
        <StackPanel Spacing="8" IsVisible="{Binding !UseLocalMode}">
          <TextBlock Classes="label" Text="MCP servers" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="One per line: a name, the server's https address, and a token if it needs one. Their tools become the agent's tools." />
          <TextBox Classes="mono" AcceptsReturn="True" MinHeight="64" Watermark="issues https://mcp.example.com/mcp" Text="{Binding McpServersText}"
                   AutomationProperties.Name="MCP servers" />
        </StackPanel>
        <TextBlock Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding ErrorText}"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
          <Button Theme="{StaticResource SecondaryButton}" Classes="action" Content="Cancel" Command="{Binding CancelSettingsCommand}" IsVisible="{Binding HasConfiguredProvider}" />
          <Button Theme="{StaticResource AccentButton}" Classes="action" Content="Save" Command="{Binding SaveSettingsCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Conversation -->
    <DockPanel IsVisible="{Binding !IsSettingsOpen}">
      <!-- Input -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,8,10,10">
        <StackPanel Spacing="6">
          <TextBlock Foreground="{DynamicResource Brush.Error}" FontSize="{DynamicResource Type.Small}" TextWrapping="Wrap" Text="{Binding ErrorText}"
                     IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <!-- The picture the next request sends, such as a screen from "Fix with Agent" on a layout problem. -->
          <Border IsVisible="{Binding HasAttachment}" Background="{DynamicResource Brush.Hover}" CornerRadius="8" Padding="6"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border CornerRadius="4" ClipToBounds="True">
                <Image Source="{Binding Attachment.Thumbnail, FallbackValue={x:Null}}" Height="56" MaxWidth="72" Stretch="Uniform" />
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="small" Text="Screenshot attached" FontWeight="SemiBold" />
                <TextBlock Classes="muted small" Text="{Binding Attachment.Caption, FallbackValue={x:Null}}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Padding="0" VerticalAlignment="Center"
                      ToolTip.Tip="Remove the screenshot" Command="{Binding RemoveAttachmentCommand}">
                <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="13" />
              </Button>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"
                     Watermark="Ask the agent to change, explain or fix your code"
                     Text="{Binding InputText}" />
            <Panel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
              <Button Theme="{StaticResource AccentButton}" ToolTip.Tip="Send (Ctrl+Enter)"
                      Command="{Binding SendCommand}" IsVisible="{Binding !IsBusy}">
                <controls:StrokeIcon Data="{StaticResource Icon.Play}" Size="16" />
              </Button>
              <Button Theme="{StaticResource SecondaryButton}" ToolTip.Tip="Stop"
                      Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}">
                <controls:StrokeIcon Data="{StaticResource Icon.Stop}" Size="16" />
              </Button>
            </Panel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Pending changes -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
              IsVisible="{Binding HasChanges}" MaxHeight="320">
        <DockPanel>
          <Grid DockPanel.Dock="Top" MinHeight="38" Margin="12,0,8,0" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="h2" Text="{Binding ChangesTitle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Content="Undo all" Command="{Binding UndoAllCommand}" Margin="0,0,6,0" />
            <Button Grid.Column="2" Theme="{StaticResource AccentButton}" Content="Keep all" Command="{Binding KeepAllCommand}" />
          </Grid>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="agent:PendingChangeViewModel">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,2,8,2" MinHeight="36">
                      <Button Theme="{StaticResource ToolButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Command="{Binding $parent[ItemsControl].((agent:AgentPanelViewModel)DataContext).ToggleDiffCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="12" IsVisible="{Binding !IsExpanded}" />
                          <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="12" IsVisible="{Binding IsExpanded}" />
                          <TextBlock Text="{Binding Path}" FontSize="{DynamicResource Type.Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Classes="muted small" Text="{Binding KindLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <TextBlock Grid.Column="1" Classes="mono small" Text="{Binding Stats}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="6,0" />
                      <Button Grid.Column="2" Theme="{StaticResource ToolButton}" ToolTip.Tip="Undo this change"
                              Command="{Binding $parent[ItemsControl].((agent:AgentPanelViewModel)DataContext).UndoCommand}" CommandParameter="{Binding}">
                        <controls:StrokeIcon Data="{StaticResource Icon.Undo}" Size="14" />
                      </Button>
                      <Button Grid.Column="3" Theme="{StaticResource ToolButton}" ToolTip.Tip="Keep this change"
                              Command="{Binding $parent[ItemsControl].((agent:AgentPanelViewModel)DataContext).KeepCommand}" CommandParameter="{Binding}">
                        <controls:StrokeIcon Data="{StaticResource Icon.Check}" Size="14" Foreground="{DynamicResource Brush.Success}" />
                      </Button>
                    </Grid>
                    <Border IsVisible="{Binding IsExpanded}" Margin="12,0,8,6" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Lines}" Padding="0,4">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="agent:DiffLineViewModel">
                              <Panel>
                                <Border Background="{DynamicResource Brush.Agent.DiffAdded}" IsVisible="{Binding IsAdded}" />
                                <Border Background="{DynamicResource Brush.Agent.DiffRemoved}" IsVisible="{Binding IsRemoved}" />
                                <TextBlock Classes="diff" Text="⋯" Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding IsGap}" />
                                <StackPanel Orientation="Horizontal" IsVisible="{Binding !IsGap}">
                                  <TextBlock Classes="diff" Width="22" Text="{Binding Kind}" Foreground="{DynamicResource Brush.TextMuted}" />
                                  <TextBlock Classes="diff" Padding="0,1,12,1" Text="{Binding Text}" />
                                </StackPanel>
                              </Panel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Messages -->
      <Panel>
        <StackPanel IsVisible="{Binding IsEmpty}" Margin="24" Spacing="10" VerticalAlignment="Center" MaxWidth="360">
          <controls:StrokeIcon Data="{StaticResource Icon.Agent}" Size="34" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" />
          <TextBlock Classes="h2" Text="Claude works on your solution" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                     Text="It reads and searches your code, makes changes, compiles them and runs your tests. Every change waits here as a diff until you keep it." />
        </StackPanel>
        <ScrollViewer x:Name="Messages" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Items}" Margin="10,8">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="agent:UserMessageViewModel">
                <Border Background="{DynamicResource Brush.Agent.UserBubble}" CornerRadius="10" Padding="12,8" Margin="40,6,0,6" HorizontalAlignment="Right">
                  <StackPanel Spacing="8">
                    <!-- A picture sent with the request, such as a screen with a layout problem outlined. -->
                    <StackPanel IsVisible="{Binding HasImage}" Spacing="4" HorizontalAlignment="Left">
                      <Border CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Left">
                        <Image Source="{Binding Image.Thumbnail, FallbackValue={x:Null}}" MaxWidth="200" MaxHeight="220" Stretch="Uniform" />
                      </Border>
                      <TextBlock Classes="muted small" Text="{Binding Image.Caption, FallbackValue={x:Null}}" TextWrapping="Wrap" MaxWidth="200" />
                    </StackPanel>
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="agent:AssistantMessageViewModel">
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="2,6" LineHeight="{DynamicResource Type.Line.Relaxed}" />
              </DataTemplate>
              <DataTemplate DataType="agent:ToolCallViewModel">
                <StackPanel Margin="0,2">
                  <Button Theme="{StaticResource ToolButton}" HorizontalAlignment="Left"
                          Command="{Binding $parent[ItemsControl].((agent:AgentPanelViewModel)DataContext).ToggleResultCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="13" Foreground="{DynamicResource Brush.AccentText}" IsVisible="{Binding IsRunning}" />
                      <controls:StrokeIcon Data="{StaticResource Icon.Check}" Size="13" Foreground="{DynamicResource Brush.Success}" IsVisible="{Binding IsDone}" />
                      <TextBlock Classes="small" Text="{Binding Description}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                      <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="13" Foreground="{DynamicResource Brush.Warning}" IsVisible="{Binding IsError}" />
                    </StackPanel>
                  </Button>
                  <Border IsVisible="{Binding IsExpanded}" Background="{DynamicResource Brush.Window}" CornerRadius="6" Padding="10,6" Margin="24,2,0,4">
                    <SelectableTextBlock Classes="mono" FontSize="{DynamicResource Type.Fine}" Text="{Binding Result}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="agent:AgentNoticeViewModel">
                <TextBlock Classes="muted small" Text="{Binding Text}" TextWrapping="Wrap" Margin="2,6" FontStyle="Italic" />
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </DockPanel>
</UserControl>
