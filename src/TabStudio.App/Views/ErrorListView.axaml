<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             xmlns:views="using:TabStudio.App.Views"
             x:Class="TabStudio.App.Views.ErrorListView"
             x:DataType="vm:ErrorListViewModel">
  <UserControl.Styles>
    <!-- A code with a page that explains it, as language servers give: tapping it opens the page. -->
    <Style Selector="TextBlock.helpLink">
      <Setter Property="TextDecorations" Value="Underline" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- The screens a layout finding shows on: tapping it shows their pictures and outlines it in the Device Matrix. -->
    <Style Selector="Button.screensBadge">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- Filters -->
    <Grid DockPanel.Dock="Top" Height="38" ColumnDefinitions="Auto,Auto,Auto,Auto,*,220" Margin="12,0">
      <Button Theme="{StaticResource SecondaryButton}" Height="30" MinHeight="30" Padding="10,0" FontSize="12.5"
              Command="{Binding ToggleScopeCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Entire Solution" IsVisible="{Binding !CurrentDocumentOnly}" VerticalAlignment="Center" />
          <TextBlock Text="Current Document" IsVisible="{Binding CurrentDocumentOnly}" VerticalAlignment="Center" />
          <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="13" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Theme="{StaticResource ToolButton}" Height="30" MinHeight="30" Margin="8,0,0,0" FontSize="12.5"
              Classes.selected="{Binding ShowErrors}" Command="{Binding ToggleErrorsCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="14" Foreground="{DynamicResource Brush.Error}" />
          <TextBlock Text="{Binding ErrorsLabel}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Height="30" MinHeight="30" Margin="4,0,0,0" FontSize="12.5"
              Classes.selected="{Binding ShowWarnings}" Command="{Binding ToggleWarningsCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="14" Foreground="{DynamicResource Brush.Warning}" />
          <TextBlock Text="{Binding WarningsLabel}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="3" Theme="{StaticResource ToolButton}" Height="30" MinHeight="30" Margin="4,0,0,0" FontSize="12.5"
              Classes.selected="{Binding ShowMessages}" Command="{Binding ToggleMessagesCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:StrokeIcon Data="{StaticResource Icon.Info}" Size="14" Foreground="{DynamicResource Brush.Info}" />
          <TextBlock Text="{Binding MessagesLabel}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="4" x:Name="CiFilterButton" Theme="{StaticResource ToolButton}" Height="30" MinHeight="30" Margin="4,0,0,0" FontSize="12.5"
              HorizontalAlignment="Left" ToolTip.Tip="Show the errors and warnings CI reported for this commit"
              Classes.selected="{Binding ShowCi}" Command="{Binding ToggleCiCommand}" IsVisible="{Binding HasCiDiagnostics}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:StrokeIcon Data="{StaticResource Icon.Actions}" Size="14" Foreground="{DynamicResource Brush.AccentText}" />
          <TextBlock Text="{Binding CiLabel}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <!-- While packages restore or the solution is analyzed, the list is about to change. -->
      <StackPanel Grid.Column="4" x:Name="PendingStatus" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="8,0" IsVisible="{Binding IsPending}">
        <controls:StrokeIcon Classes.spinning="{Binding IsPending}" Data="{StaticResource Icon.Spinner}" Size="13" StrokeThickness="2.2" Foreground="{DynamicResource Brush.TextMuted}" />
        <TextBlock Text="{Binding PendingText}" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
      </StackPanel>
      <TextBox Grid.Column="5" Watermark="Search Error List" Text="{Binding SearchText}" VerticalAlignment="Center">
        <TextBox.InnerLeftContent>
          <controls:StrokeIcon Data="{StaticResource Icon.Search}" Size="13" Margin="8,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
        </TextBox.InnerLeftContent>
      </TextBox>
    </Grid>

    <!-- Column headers -->
    <Border DockPanel.Dock="Top" Height="26" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1">
      <!-- A phone's panel keeps Code short and drops Project and File for the Description; a tap still opens the file. -->
      <Grid x:Name="HeaderColumns" controls:ResponsiveColumns.Wide="34,150,*,130,160,50,40" controls:ResponsiveColumns.Compact="28,72,*,0,0,40,32"
            controls:ResponsiveColumns.IsCompact="{Binding $parent[views:ErrorListView].IsCompact}" Margin="12,0" VerticalAlignment="Center">
        <TextBlock Grid.Column="1" Classes="muted small" Text="Code" />
        <TextBlock Grid.Column="2" Classes="muted small" Text="Description" />
        <TextBlock Grid.Column="3" Classes="muted small" Text="Project" />
        <TextBlock Grid.Column="4" Classes="muted small" Text="File" />
        <TextBlock Grid.Column="5" Classes="muted small" Text="Line" />
      </Grid>
    </Border>

    <Panel>
      <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="No errors, warnings or messages."
                 IsVisible="{Binding !HasItems}" />
      <ListBox x:Name="Rows" ItemsSource="{Binding Items}" ItemContainerTheme="{StaticResource ListRow}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ErrorItemViewModel">
            <Grid controls:ResponsiveColumns.Wide="34,150,*,130,160,50,40" controls:ResponsiveColumns.Compact="28,72,*,0,0,40,32"
                  controls:ResponsiveColumns.IsCompact="{Binding $parent[views:ErrorListView].IsCompact}" Height="28" Margin="12,0" Background="Transparent"
                  ToolTip.Tip="{Binding Description}">
              <Panel>
                <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="14" Foreground="{DynamicResource Brush.Error}" IsVisible="{Binding IsError}" HorizontalAlignment="Left" />
                <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="14" Foreground="{DynamicResource Brush.Warning}" IsVisible="{Binding IsWarning}" HorizontalAlignment="Left" />
                <controls:StrokeIcon Data="{StaticResource Icon.Info}" Size="14" Foreground="{DynamicResource Brush.Info}" IsVisible="{Binding IsMessage}" HorizontalAlignment="Left" />
              </Panel>
              <TextBlock Grid.Column="1" Classes="link" Classes.helpLink="{Binding HasHelpLink}" FontSize="12.5" Text="{Binding Code}"
                         VerticalAlignment="Center" Tag="code" ToolTip.Tip="{Binding HelpLinkToolTip}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
              <DockPanel Grid.Column="2" Margin="0,0,12,0">
                <Border DockPanel.Dock="Left" Classes="ciBadge" IsVisible="{Binding IsFromCi}" ToolTip.Tip="{Binding CiToolTip}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="CI" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" />
                    <TextBlock Text="{Binding Ci.CheckName}" MaxWidth="150" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSecondary}" />
                  </StackPanel>
                </Border>
                <Border DockPanel.Dock="Left" Classes="ciBadge" IsVisible="{Binding IsFromBridge}" ToolTip.Tip="{Binding BridgeToolTip}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:StrokeIcon Data="{StaticResource Icon.Computer}" Size="11" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BridgePc}" MaxWidth="150" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSecondary}" />
                  </StackPanel>
                </Border>
                <Button DockPanel.Dock="Left" Theme="{StaticResource ToolButton}" Classes="screensBadge" Tag="screens" IsVisible="{Binding IsFromLayout}"
                        ToolTip.Tip="{Binding LayoutScreensToolTip}"
                        Command="{Binding $parent[ListBox].((vm:ErrorListViewModel)DataContext).ShowLayoutScreensCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:StrokeIcon Data="{StaticResource Icon.DeviceMatrix}" Size="12" Foreground="{DynamicResource Brush.AccentText}" />
                    <TextBlock Text="{Binding LayoutScreens}" MaxWidth="150" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LayoutScreenshots}" Margin="4">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="16" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:LayoutScreenshotViewModel">
                              <StackPanel Width="220" Spacing="6">
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                  <TextBlock Classes="muted small" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                        Width="220" Height="{Binding PictureHeight}" Background="{DynamicResource Brush.Window}">
                                  <Panel>
                                    <Image Source="{Binding Picture}" Stretch="Fill" />
                                    <Canvas>
                                      <Border Canvas.Left="{Binding HighlightLeft}" Canvas.Top="{Binding HighlightTop}"
                                              Width="{Binding Highlight.Width}" Height="{Binding Highlight.Height}"
                                              BorderBrush="{DynamicResource Brush.Swarm.Highlight}" BorderThickness="2" CornerRadius="3" />
                                    </Canvas>
                                    <TextBlock Classes="muted small" Text="No picture of this screen" IsVisible="{Binding !HasPicture}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Panel>
                                </Border>
                                <TextBlock Classes="small" Text="{Binding Message}" TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <TextBlock FontSize="12.5" Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Grid.Column="3" FontSize="12.5" Text="{Binding Project}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" FontSize="12.5" Text="{Binding File}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="5" FontSize="12.5" Text="{Binding Line}" VerticalAlignment="Center" />
              <Button Grid.Column="6" Theme="{StaticResource ToolButton}" Width="32" Height="26" MinWidth="32" MinHeight="26" Padding="0"
                      ToolTip.Tip="Fix with Agent" IsVisible="{Binding CanFixWithAgent}"
                      Command="{Binding $parent[ListBox].((vm:ErrorListViewModel)DataContext).FixWithAgentCommand}" CommandParameter="{Binding}">
                <controls:StrokeIcon Data="{StaticResource Icon.Agent}" Size="14" Foreground="{DynamicResource Brush.Accent}" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
