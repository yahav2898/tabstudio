<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:conv="using:TabStudio.App.Converters"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.SolutionExplorerView"
             x:DataType="vm:SolutionExplorerViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Height="36" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0,4,0">
        <TextBlock Classes="header" Text="Solution Explorer" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Theme="{StaticResource ToolButton}" Width="34" Height="34" MinWidth="34" MinHeight="34" Padding="0"
                  ToolTip.Tip="Collapse All" Command="{Binding CollapseAllCommand}">
            <controls:StrokeIcon Data="{StaticResource Icon.Collapse}" Size="15" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Padding="8,6">
      <TextBox Watermark="Search Solution Explorer" Text="{Binding SearchText}">
        <TextBox.InnerLeftContent>
          <controls:StrokeIcon Data="{StaticResource Icon.Search}" Size="13" Margin="8,0,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}" />
        </TextBox.InnerLeftContent>
      </TextBox>
    </Border>

    <ListBox x:Name="Tree" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedItem}"
             ItemContainerTheme="{StaticResource ListRow}" SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:ExplorerItemViewModel">
          <Grid ColumnDefinitions="Auto,18,Auto,*,Auto,Auto" Height="30" Background="Transparent">
            <!-- Long-press on touch, right-click with a mouse. -->
            <Grid.ContextFlyout>
              <MenuFlyout>
                <MenuItem Header="Open" Command="{Binding OpenCommand}" IsVisible="{Binding IsFile}" />
                <MenuItem Header="New File..." Command="{Binding NewFileCommand}" IsVisible="{Binding CanCreateChildren}" />
                <MenuItem Header="New Folder..." Command="{Binding NewFolderCommand}" IsVisible="{Binding CanCreateChildren}" />
                <MenuItem Header="Port to Avalonia…" Command="{Binding PortToAvaloniaCommand}" IsVisible="{Binding CanPortToAvalonia}" />
                <MenuItem Header="Set as Startup Project" Command="{Binding SetAsStartupProjectCommand}" IsVisible="{Binding CanBeStartupProject}" />
                <MenuItem Header="Live Unit Testing" IsVisible="{Binding CanSetLiveTesting}">
                  <MenuItem Header="Include" Command="{Binding IncludeInLiveTestingCommand}" />
                  <MenuItem Header="Exclude" Command="{Binding ExcludeFromLiveTestingCommand}" />
                </MenuItem>
                <MenuItem Header="Rename..." Command="{Binding RenameCommand}" IsVisible="{Binding CanModify}" />
                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding CanModify}" />
              </MenuFlyout>
            </Grid.ContextFlyout>
            <Border Width="{Binding IndentWidth}" />

            <!-- Expand chevron -->
            <Panel Grid.Column="1" IsVisible="{Binding IsExpandable}">
              <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="14"
                                   Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding !IsExpanded}" />
              <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="14"
                                   Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding IsExpanded}" />
            </Panel>

            <!-- Icon, or a badge for files -->
            <Panel Grid.Column="2" Margin="4,0,8,0" MinWidth="16">
              <controls:StrokeIcon Size="16" IsVisible="{Binding ShowsSymbol}"
                                   Data="{Binding Icon, Converter={x:Static conv:AppConverters.ExplorerIconGeometry}}"
                                   Foreground="{Binding Icon, Converter={x:Static conv:AppConverters.ExplorerIconBrush}}" />
              <Border Classes="badge" IsVisible="{Binding ShowsBadge}"
                      Background="{Binding BadgeKind, Converter={x:Static conv:AppConverters.BadgeBackground}}">
                <TextBlock Text="{Binding Badge}"
                           Foreground="{Binding BadgeKind, Converter={x:Static conv:AppConverters.BadgeForeground}}" />
              </Border>
              <Image Source="{Binding ThemeIcon}" Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding HasThemeIcon}" />
            </Panel>

            <TextBlock Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource Type.Section}">
              <Run Text="{Binding Name}" />
              <Run Text=" " />
              <Run Text="{Binding Detail}" Foreground="{DynamicResource Brush.TextMuted}" />
              <Run Text="{Binding Location}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource Type.Fine}" />
            </TextBlock>

            <Border Grid.Column="4" Classes="pill" Classes.ready="{Binding IsPillReady}" Margin="6,0,10,0"
                    IsVisible="{Binding Pill, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding Pill}" VerticalAlignment="Center" />
            </Border>

            <!-- Source control: a colored letter on changed files, a dot on folders with changes inside. -->
            <Panel Grid.Column="5" Width="14" Margin="0,0,12,0" ToolTip.Tip="{Binding GitGlyphTip}" IsVisible="{Binding HasGitGlyph}">
              <TextBlock Text="{Binding GitGlyphText}" FontSize="{DynamicResource Type.Small}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{Binding GitGlyph, Converter={x:Static conv:SourceControlConverters.GlyphBrush}}" IsVisible="{Binding HasGitLetter}" />
              <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Fill="{Binding GitGlyph, Converter={x:Static conv:SourceControlConverters.GlyphBrush}}" IsVisible="{Binding HasGitDot}" />
            </Panel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
