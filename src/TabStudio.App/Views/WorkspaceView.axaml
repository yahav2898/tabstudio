<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:conv="using:TabStudio.App.Converters"
             xmlns:input="using:TabStudio.App.Input"
             xmlns:hotReload="using:TabStudio.Compilation.HotReload"
             xmlns:views="using:TabStudio.App.Views"
             xmlns:databaseViews="using:TabStudio.App.Views.Database"
             xmlns:actionViews="using:TabStudio.App.Views.Actions"
             xmlns:prv="using:TabStudio.App.Views.PullRequests"
             xmlns:swarmViews="using:TabStudio.App.Views.Swarm"
             xmlns:liveViews="using:TabStudio.App.Views.Live"
             xmlns:liveVm="using:TabStudio.App.ViewModels.Live"
             xmlns:extensionViews="using:TabStudio.App.Views.Extensions"
             xmlns:toolchainViews="using:TabStudio.App.Views.Toolchains"
             xmlns:searchViews="using:TabStudio.App.Views.Search"
             xmlns:appearance="using:TabStudio.App.Services.Appearance"
             xmlns:vm="using:TabStudio.App.ViewModels"
             xmlns:bridgeViews="using:TabStudio.App.Views.WindowsBridge"
             xmlns:opsViews="using:TabStudio.App.Views.LongOperations"
             xmlns:sys="using:System"
             x:Class="TabStudio.App.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

  <!--
    The IDE's shell (docs/design/README.md): the menu bar with the Search button, the adaptive toolbar, the documents
    and the bottom dock, the side bar's tool windows with the activity bar on its outer edge, and the adaptive status
    bar. On a narrow or portrait screen the side bar opens as a drawer over the editor, the menus fold into one button
    on a phone, and the bars fold their least used items into More (WorkspaceView.Layout.cs). Ctrl+Q opens the search.
  -->

  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding StartDebuggingCommand}" />
    <KeyBinding Gesture="Ctrl+F5" Command="{Binding RunCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding StopDebuggingCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F5" Command="{Binding RestartCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding ToggleBreakpointCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F9" Command="{Binding DeleteAllBreakpointsCommand}" />
    <KeyBinding Gesture="F10" Command="{Binding StepOverCommand}" />
    <KeyBinding Gesture="Alt+F10" Command="{Binding ApplyHotReloadCommand}" />
    <KeyBinding Gesture="Shift+F10" Command="{Binding StepBackCommand}" />
    <KeyBinding Gesture="Ctrl+F10" Command="{Binding RunToCursorCommand}" />
    <KeyBinding Gesture="F11" Command="{Binding StepIntoCommand}" />
    <KeyBinding Gesture="Shift+F11" Command="{Binding StepOutCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+Pause" Command="{Binding BreakAllCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+Cancel" Command="{Binding BreakAllCommand}" />
    <KeyBinding Gesture="Alt+Multiply" Command="{Binding ShowNextStatementCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding BuildCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
    <KeyBinding Gesture="Ctrl+OemQuestion" Command="{Binding ToggleCommentCommand}" />
    <KeyBinding Gesture="Shift+Alt+F" Command="{Binding FormatDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding ReplaceCommand}" />
    <KeyBinding Gesture="Ctrl+F4" Command="{Binding CloseDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextDocumentCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousDocumentCommand}" />
    <KeyBinding Gesture="Alt+Left" Command="{Binding NavigateBackCommand}" />
    <KeyBinding Gesture="Alt+Right" Command="{Binding NavigateForwardCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+L" Command="{Binding ToggleSideBarCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+X" Command="{Binding ShowExtensionsCommand}" />
    <KeyBinding Gesture="Ctrl+OemTilde" Command="{Binding ShowTerminalCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- The Search button's key cap, as the search shows key gestures. -->
    <Style Selector="Border.keycap">
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Control}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="TextElement.FontSize" Value="11" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <!-- The Search button: 240 pixels, or below 1000 pixels its icon alone (WorkspaceView.Layout.cs sets the class). -->
    <Style Selector="Button#SearchButton">
      <Setter Property="Width" Value="240" />
    </Style>
    <Style Selector="Button#SearchButton.compact">
      <Setter Property="Width" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button#SearchButton.compact TextBlock#SearchLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button#SearchButton.compact Border.keycap">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The status bar's items: 24 pixels high, small text, white on teal. -->
    <Style Selector="Button.status">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- The floating touch bar's buttons: 44-pixel touch targets. -->
    <Style Selector="Button.touch">
      <Setter Property="Height" Value="44" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="40,46,*,28">

    <!-- Menu bar: the logo, the menus (one Menu button on a phone), the Search button and the solution's name. -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.MenuBar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid x:Name="MenuBar" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="8,0">
        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Brush.Accent}" Margin="0,0,6,0">
          <controls:StrokeIcon Data="{StaticResource Icon.Logo}" Size="16" StrokeThickness="2.6" Foreground="{DynamicResource Brush.OnAccent}" HorizontalAlignment="Center" />
        </Border>

        <!-- On a phone the menus fold into this button: WorkspaceView.Layout.cs moves them between it and the menu bar. -->
        <Button x:Name="MenuButton" Grid.Column="1" Theme="{StaticResource ToolButton}" Width="40" Height="36" MinHeight="36" Padding="0"
                IsVisible="False" ToolTip.Tip="Menu">
          <controls:StrokeIcon Data="{StaticResource Icon.Menu}" Size="18" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft" />
          </Button.Flyout>
        </Button>

        <Menu x:Name="MainMenu" Grid.Column="2" VerticalAlignment="Center">
          <MenuItem Header="_File">
            <MenuItem Header="_New">
              <MenuItem Header="C# _Notebook" Command="{Binding NewNotebookCommand}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="_Save" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
            <MenuItem Header="Open _Remote Folder (SSH)..." Command="{Binding ShowRemoteExplorerCommand}" />
            <MenuItem Header="Publish to _server..." Command="{Binding PublishToServerCommand}" />
            <MenuItem Header="Save A_ll" InputGesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}" />
            <Separator />
            <MenuItem Header="TabStudio _Link..." Command="{Binding OpenLinkCommand}" IsVisible="{Binding IsLinkAvailable}" />
            <MenuItem Header="_Join a Swarm..." Command="{Binding JoinSwarmCommand}" IsVisible="{Binding CanJoinSwarm}" />
            <MenuItem Header="Share Sess_ion..." Command="{Binding ShareSessionCommand}" IsVisible="{Binding IsLiveAvailable}" />
            <MenuItem Header="Join Li_ve Session..." Command="{Binding JoinLiveSessionCommand}" IsVisible="{Binding IsLiveAvailable}" />
            <MenuItem Header="{Binding WindowsBridgeMenuHeader}" Command="{Binding OpenWindowsBridgeCommand}" IsVisible="{Binding HasWindowsBridge}" />
            <Separator />
            <MenuItem Header="_Close Document" InputGesture="Ctrl+F4" Command="{Binding CloseDocumentCommand}" />
            <MenuItem Header="Close Sol_ution" Command="{Binding CloseWorkspaceCommand}" />
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding UndoCommand}" />
            <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding RedoCommand}" />
            <Separator />
            <MenuItem Header="_Find" InputGesture="Ctrl+F" Command="{Binding FindCommand}" />
            <MenuItem Header="Re_place" InputGesture="Ctrl+H" Command="{Binding ReplaceCommand}" />
            <Separator />
            <MenuItem Header="Toggle Line _Comment (Ctrl+/)" Command="{Binding ToggleCommentCommand}" />
            <MenuItem Header="F_ormat Document" InputGesture="Shift+Alt+F" Command="{Binding FormatDocumentCommand}" />
            <Separator />
            <MenuItem Header="_IntelliSense">
              <MenuItem Header="_List Members" InputGesture="Ctrl+J" Command="{Binding ListMembersCommand}" />
              <MenuItem Header="_Parameter Info" InputGesture="Ctrl+Shift+Space" Command="{Binding ParameterInfoCommand}" />
              <MenuItem Header="_Quick Info (Ctrl+K, Ctrl+I)" Command="{Binding QuickInfoCommand}" />
              <MenuItem Header="Complete _Word" InputGesture="Ctrl+Space" Command="{Binding CompleteWordCommand}" />
              <MenuItem Header="Insert _Snippet... (Ctrl+K, Ctrl+X)" Command="{Binding InsertSnippetCommand}" />
            </MenuItem>
            <MenuItem Header="Re_factor">
              <MenuItem Header="_Rename... (Ctrl+R, Ctrl+R)" InputGesture="F2" Command="{Binding RenameSymbolCommand}" />
            </MenuItem>
            <MenuItem Header="_Quick Actions and Refactorings..." InputGesture="Ctrl+OemPeriod" Command="{Binding QuickActionsCommand}" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="_Solution Explorer" InputGesture="Ctrl+Alt+L" Command="{Binding ToggleSideBarCommand}" />
            <MenuItem Header="_Git Changes" Command="{Binding ShowGitChangesCommand}" />
            <MenuItem Header="_Database Explorer" Command="{Binding ShowDatabaseCommand}" />
            <MenuItem Header="GitHub Actio_ns" Command="{Binding ShowActionsCommand}" />
            <MenuItem Header="Pull Re_quests" Command="{Binding ShowPullRequestsCommand}" />
            <MenuItem Header="_Test Explorer (Ctrl+E, T)" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.TestExplorer}" />
            <MenuItem Header="Device _Peripherals" Command="{Binding ShowEmbeddedPeripheralsCommand}" />
            <MenuItem Header="Claude _Agent" Command="{Binding ShowAgentCommand}" />
            <MenuItem Header="S_warm" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.Swarm}"
                      IsVisible="{Binding IsSwarmAvailable}" />
            <MenuItem Header="_Live Share" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.Live}"
                      IsVisible="{Binding IsLiveAvailable}" />
            <MenuItem Header="_Web Preview" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.WebPreview}"
                      IsEnabled="{Binding WebPreview.HasApp}" />
            <MenuItem Header="_App Preview" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.AppPreview}"
                      IsEnabled="{Binding AppPreview.HasApp}" />
            <MenuItem Header="Device _Matrix" Command="{Binding ShowDeviceMatrixCommand}" />
            <MenuItem Header="Windows _Bridge" Command="{Binding ShowWindowsBridgePaneCommand}" IsVisible="{Binding HasWindowsBridge}" />
            <MenuItem Header="_Error List" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.ErrorList}" />
            <MenuItem Header="_Output" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Output}" />
            <MenuItem Header="_Containers" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.Containers}" />
            <MenuItem Header="_Services" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.Services}" />
            <MenuItem Header="Ter_minal (Ctrl+`)" Command="{Binding ShowTerminalCommand}" />
            <MenuItem Header="_Serial Monitor" Command="{Binding ShowSerialMonitorCommand}" />
            <MenuItem Header="_Compatibility Doctor" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Compatibility}" />
            <MenuItem Header="Re_ferences" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.References}" />
            <MenuItem Header="_Bottom Panel" Command="{Binding ToggleBottomPanelCommand}" />
            <MenuItem Header="Des_ktop Mode" ToggleType="CheckBox" IsChecked="{Binding DesktopMode.IsActive, Mode=TwoWay, FallbackValue=False}"
                      IsEnabled="{Binding DesktopMode.HasDisplay, FallbackValue=False}" IsVisible="{Binding DesktopMode.IsSupported, FallbackValue=False}" />
            <Separator />
            <MenuItem Header="Navigate _Backward" InputGesture="Alt+Left" Command="{Binding NavigateBackCommand}" />
            <MenuItem Header="Navigate _Forward" InputGesture="Alt+Right" Command="{Binding NavigateForwardCommand}" />
            <MenuItem Header="Sync with _Active Document" Command="{Binding SyncWithActiveDocumentCommand}" />
            <Separator />
            <MenuItem Header="Go To _Definition" InputGesture="F12" Command="{Binding GoToDefinitionCommand}" />
            <MenuItem Header="_Peek Definition" InputGesture="Alt+F12" Command="{Binding PeekDefinitionCommand}" />
            <MenuItem Header="Go To _Implementation" InputGesture="Ctrl+F12" Command="{Binding GoToImplementationCommand}" />
            <MenuItem Header="Go To D_eclaration" Command="{Binding GoToDeclarationCommand}" />
            <MenuItem Header="Go To _Type Definition" Command="{Binding GoToTypeDefinitionCommand}" />
            <MenuItem Header="Find All _References" InputGesture="Shift+F12" Command="{Binding FindAllReferencesCommand}" />
          </MenuItem>
          <MenuItem Header="_Git">
            <MenuItem Header="_Commit..." Command="{Binding StartCommitCommand}" IsEnabled="{Binding GitChanges.IsLinked}" />
            <Separator />
            <MenuItem Header="_Fetch" Command="{Binding GitChanges.FetchCommand}" />
            <MenuItem Header="_Pull" Command="{Binding GitChanges.PullCommand}" />
            <MenuItem Header="_Sync (Pull then Push)" Command="{Binding GitChanges.SyncCommand}" />
            <Separator />
            <MenuItem Header="_New Branch..." Command="{Binding GitChanges.NewBranchCommand}" />
            <MenuItem Header="S_witch Branch..." Command="{Binding GitChanges.OpenBranchPickerCommand}" />
            <MenuItem Header="Create Pull _Request..." Command="{Binding GitChanges.OpenPullRequestFormCommand}" />
            <MenuItem Header="Pull Re_quests" Command="{Binding ShowPullRequestsCommand}" />
            <Separator />
            <MenuItem Header="P_ublish to GitHub..." Command="{Binding ShowGitChangesCommand}" IsEnabled="{Binding GitChanges.IsPublishVisible}" />
            <MenuItem Header="Open on _GitHub" Command="{Binding GitChanges.OpenOnGitHubCommand}" />
            <MenuItem Header="View _History" Command="{Binding GitChanges.OpenHistoryCommand}" />
            <MenuItem Header="GitHub Ac_tions" Command="{Binding ShowActionsCommand}" />
            <Separator />
            <MenuItem Header="GitHub _Account..." Command="{Binding GitChanges.Account.OpenCommand}" />
          </MenuItem>
          <MenuItem Header="_Build">
            <MenuItem Header="Embedded _Firmware" Command="{Binding BuildEmbeddedCommand}" />
            <MenuItem Header="Build Android APK" Command="{Binding BuildAndroidCommand}" />
            <MenuItem Header="Run Android App" Command="{Binding RunAndroidCommand}" />
            <MenuItem Header="Build for iOS…" Command="{Binding BuildForIosCommand}" />
            <MenuItem Header="Run iOS Workflow…" Command="{Binding RunIosWorkflowCommand}" />
            <MenuItem Header="_Build Solution" InputGesture="Ctrl+Shift+B" Command="{Binding BuildCommand}" />
            <Separator />
            <MenuItem Header="_Debug Configuration" Command="{Binding SetConfigurationCommand}" CommandParameter="Debug" />
            <MenuItem Header="_Release Configuration" Command="{Binding SetConfigurationCommand}" CommandParameter="Release" />
          </MenuItem>
          <MenuItem Header="_Debug">
            <MenuItem Header="_Windows">
              <MenuItem Header="_Locals" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Locals}" />
              <MenuItem Header="_Watch" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Watch}" />
              <MenuItem Header="_Call Stack" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.CallStack}" />
              <MenuItem Header="_Output" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Output}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding StartDebuggingMenuHeader}" InputGesture="F5" Command="{Binding StartDebuggingCommand}" />
            <MenuItem Header="Start with Recording" Command="{Binding StartWithRecordingCommand}" />
            <MenuItem Header="Recording Buffer..." Command="{Binding ConfigureRecordingCommand}" />
            <MenuItem Header="Start Wit_hout Debugging" InputGesture="Ctrl+F5" Command="{Binding RunCommand}" />
            <MenuItem Header="Run C_urrent File" Command="{Binding RunCurrentFileCommand}" />
            <MenuItem Header="{Binding PicFlashMenuText}" Command="{Binding FlashPicCommand}" IsVisible="{Binding IsPicProject}" />
            <MenuItem Header="PIC _Target…" Command="{Binding ConfigurePicTargetCommand}" IsVisible="{Binding IsPicProject}" />
            <MenuItem Header="_Embedded">
              <MenuItem Header="_Devices and probes" Command="{Binding ShowEmbeddedDevicesCommand}" />
              <MenuItem Header="Read target _identity" Command="{Binding IdentifyEmbeddedTargetCommand}" />
              <MenuItem Header="_Board and build configuration…" Command="{Binding ConfigureEmbeddedCommand}" />
              <MenuItem Header="_Build firmware" Command="{Binding BuildEmbeddedCommand}" />
              <MenuItem Header="_Upload and verify" Command="{Binding UploadEmbeddedCommand}" />
              <MenuItem Header="Upload UF2 to _BOOTSEL storage" Command="{Binding UploadUf2StorageCommand}" />
              <MenuItem Header="Debug on _chip…" Command="{Binding DebugEmbeddedChipCommand}" />
              <MenuItem Header="RTT and _defmt logs" Command="{Binding StartEmbeddedLogsCommand}" />
              <MenuItem Header="Upload over _Wi-Fi…" Command="{Binding UploadEmbeddedOtaCommand}" />
              <MenuItem Header="_Production batch…" Command="{Binding ProductionFlashEmbeddedCommand}" />
              <MenuItem Header="_Backup firmware…" Command="{Binding BackupEmbeddedFirmwareCommand}" />
              <MenuItem Header="Compare firmware _dumps…" Command="{Binding CompareFirmwareDumpsCommand}" />
              <Separator />
              <MenuItem Header="_Memory report" Command="{Binding AnalyzeEmbeddedMemoryCommand}" />
              <MenuItem Header="_Stack analysis" Command="{Binding AnalyzeEmbeddedStackCommand}" />
              <MenuItem Header="Decode _crash" Command="{Binding DecodeEmbeddedCrashCommand}" />
              <MenuItem Header="Capture halted Cortex-M _fault" Command="{Binding CaptureEmbeddedFaultCommand}" />
              <Separator />
              <MenuItem Header="Load CMSIS-_SVD…" Command="{Binding LoadEmbeddedSvdCommand}" />
              <MenuItem Header="Load register _header…" Command="{Binding LoadEmbeddedRegisterHeaderCommand}" />
              <MenuItem Header="Inspect _peripheral register…" Command="{Binding InspectEmbeddedRegisterCommand}" />
              <MenuItem Header="Read target _memory…" Command="{Binding ReadEmbeddedMemoryCommand}" />
              <MenuItem Header="_Disassembly…" Command="{Binding DisassembleEmbeddedCommand}" />
              <MenuItem Header="Edit register _field…" Command="{Binding EditEmbeddedRegisterFieldCommand}" />
              <MenuItem Header="RTOS _threads" Command="{Binding ShowEmbeddedRtosThreadsCommand}" />
              <MenuItem Header="Check _pin conflicts" Command="{Binding CheckEmbeddedPinsCommand}" />
              <MenuItem Header="Run embedded _tests" Command="{Binding RunEmbeddedTestsCommand}" />
              <MenuItem Header="Run tests on _board" Command="{Binding RunEmbeddedBoardTestsCommand}" />
              <MenuItem Header="Run Unity tests over _serial" Command="{Binding RunSerialEmbeddedTestsCommand}" />
              <MenuItem Header="Import test _results…" Command="{Binding ImportEmbeddedTestResultsCommand}" />
              <MenuItem Header="MicroPython _REPL" Command="{Binding OpenMicroPythonReplCommand}" />
              <MenuItem Header="Sync active Python _file" Command="{Binding SyncMicroPythonFileCommand}" />
              <MenuItem Header="Import _vendor project…" Command="{Binding ImportEmbeddedProjectCommand}" />
            </MenuItem>
            <MenuItem Header="MPLAB _Configuration…" Command="{Binding SelectPicConfigurationCommand}" IsVisible="{Binding IsPicProject}" />
            <MenuItem Header="On-chip Debugging in _MPLAB X…" Command="{Binding DebugPicOnBridgeCommand}" IsVisible="{Binding IsPicProject}" />
            <MenuItem Header="Brea_k All (Ctrl+Alt+Break)" Command="{Binding BreakAllCommand}" />
            <MenuItem Header="Stop D_ebugging" InputGesture="Shift+F5" Command="{Binding StopDebuggingCommand}" />
            <MenuItem Header="_Restart" InputGesture="Ctrl+Shift+F5" Command="{Binding RestartCommand}" />
            <MenuItem Header="Apply C# Hot Reload" InputGesture="Alt+F10" Command="{Binding ApplyHotReloadCommand}"
                      ToolTip.Tip="Available in the desktop host. On Android 0.15, restart to apply C# edits." />
            <MenuItem Header="Hot Reload C# on Save" ToggleType="CheckBox" IsChecked="{Binding HotReloadOnSave, Mode=TwoWay}"
                      IsEnabled="{x:Static hotReload:HotReloadSession.IsSupported}"
                      ToolTip.Tip="Available in the desktop host. On Android 0.15, saving a preview app restarts it." />
            <MenuItem Header="Flutter Hot Reload" Command="{Binding FlutterHotReloadCommand}" />
            <MenuItem Header="Flutter Hot Restart" Command="{Binding FlutterHotRestartCommand}" />
            <Separator />
            <MenuItem Header="Show _Next Statement (Alt+Num *)" Command="{Binding ShowNextStatementCommand}" />
            <MenuItem Header="Step _Into" InputGesture="F11" Command="{Binding StepIntoCommand}" />
            <MenuItem Header="Step _Over" InputGesture="F10" Command="{Binding StepOverCommand}" />
            <MenuItem Header="Step O_ut" InputGesture="Shift+F11" Command="{Binding StepOutCommand}" />
            <MenuItem Header="Step Back" InputGesture="Shift+F10" Command="{Binding StepBackCommand}" />
            <MenuItem Header="Step Back Into" Command="{Binding StepBackIntoCommand}" />
            <MenuItem Header="Reverse Continue" Command="{Binding ReverseContinueCommand}" />
            <MenuItem Header="Run _To Cursor" InputGesture="Ctrl+F10" Command="{Binding RunToCursorCommand}" />
            <Separator />
            <MenuItem Header="Toggle _Breakpoint" InputGesture="F9" Command="{Binding ToggleBreakpointCommand}" />
            <MenuItem Header="_Delete All Breakpoints" InputGesture="Ctrl+Shift+F9" Command="{Binding DeleteAllBreakpointsCommand}" />
            <MenuItem Header="Break on Unhandled E_xceptions" ToggleType="CheckBox" IsChecked="{Binding BreakOnUnhandledExceptions, Mode=TwoWay}" />
            <MenuItem Header="Exception _Settings" ItemsSource="{Binding ExceptionFilters}" IsVisible="{Binding HasExceptionFilters}">
              <MenuItem.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ExceptionFilterOption">
                  <Setter Property="Header" Value="{Binding Label}" />
                  <Setter Property="ToggleType" Value="CheckBox" />
                  <Setter Property="IsChecked" Value="{Binding IsEnabled, Mode=TwoWay}" />
                </ControlTheme>
              </MenuItem.ItemContainerTheme>
            </MenuItem>
          </MenuItem>
          <MenuItem Header="_Test">
            <MenuItem Header="Run _All Tests (Ctrl+R, A)" Command="{Binding Tests.RunAllCommand}" />
            <MenuItem Header="Run _Failed Tests (Ctrl+R, F)" Command="{Binding Tests.RunFailedCommand}" />
            <MenuItem Header="Run Tests in _Context (Ctrl+R, T)" Command="{Binding RunTestsInContextCommand}" />
            <MenuItem Header="_Repeat Last Run (Ctrl+R, L)" Command="{Binding Tests.RepeatLastRunCommand}" />
            <MenuItem Header="_Cancel Test Run" Command="{Binding Tests.CancelCommand}" />
            <Separator />
            <MenuItem Header="Live _Unit Testing">
              <MenuItem Header="_Start" Command="{Binding LiveTesting.StartCommand}" />
              <MenuItem Header="_Pause" Command="{Binding LiveTesting.PauseCommand}" IsVisible="{Binding !LiveTesting.IsPaused}" />
              <MenuItem Header="_Continue" Command="{Binding LiveTesting.ContinueCommand}" IsVisible="{Binding LiveTesting.IsPaused}" />
              <MenuItem Header="St_op" Command="{Binding LiveTesting.StopCommand}" />
              <Separator />
              <MenuItem Header="Run After _Typing Pauses" ToggleType="Radio" GroupName="LiveUnitTestingTrigger"
                        IsChecked="{Binding LiveTesting.RunsAfterTyping, Mode=OneWay}" Command="{Binding LiveTesting.UseRunAfterTypingCommand}" />
              <MenuItem Header="Run on _Save" ToggleType="Radio" GroupName="LiveUnitTestingTrigger"
                        IsChecked="{Binding LiveTesting.RunsOnSave, Mode=OneWay}" Command="{Binding LiveTesting.UseRunOnSaveCommand}" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Record _UI Test" Command="{Binding RecordUiTestCommand}" IsVisible="{Binding IsSwarmAvailable}" />
            <MenuItem Header="Run UI Tests on _Every Screen" Command="{Binding RunUiTestsOnEveryScreenCommand}" IsVisible="{Binding IsSwarmAvailable}" />
            <Separator />
            <MenuItem Header="Test E_xplorer (Ctrl+E, T)" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.TestExplorer}" />
          </MenuItem>
          <MenuItem Header="_Project">
            <MenuItem Header="Port to Avalonia…" Command="{Binding PortToAvaloniaCommand}" />
          </MenuItem>
          <MenuItem Header="E_xtensions">
            <MenuItem Header="_Manage Extensions" InputGesture="Ctrl+Shift+X" Command="{Binding ShowExtensionsCommand}" IsEnabled="{Binding HasExtensions}" />
            <MenuItem Header="_Install from VSIX..." Command="{Binding InstallFromVsixCommand}" IsEnabled="{Binding HasExtensions}" />
            <Separator />
            <MenuItem Header="_Color Theme..." Command="{Binding SelectColorThemeCommand}" IsEnabled="{Binding HasExtensions}" />
            <MenuItem Header="_File Icon Theme..." Command="{Binding SelectFileIconThemeCommand}" IsEnabled="{Binding HasExtensions}" />
            <Separator />
            <MenuItem Header="Check for _Updates" Command="{Binding CheckForExtensionUpdatesCommand}" IsEnabled="{Binding HasExtensions}" />
          </MenuItem>
          <MenuItem Header="T_ools">
            <MenuItem Header="Toolchain _Store" Command="{Binding ShowToolchainStoreCommand}" />
            <MenuItem Header="Install Project _Packages" Command="{Binding InstallProjectPackagesCommand}" />
            <MenuItem Header="Set Projects Up When They _Open" ToggleType="CheckBox" IsChecked="{Binding SetUpProjectsWhenTheyOpen, Mode=TwoWay}" />
            <Separator />
            <!-- TabStudio's own colors in a theme of the IDE; Extensions > Color Theme also lists the extensions' themes. -->
            <MenuItem Header="_Theme">
              <MenuItem Header="_Dark" ToggleType="Radio" GroupName="IdeTheme"
                        IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static appearance:IdeTheme.Dark}}"
                        Command="{Binding UseTabStudioThemeCommand}" CommandParameter="{x:Static appearance:IdeTheme.Dark}" />
              <MenuItem Header="_Light" ToggleType="Radio" GroupName="IdeTheme"
                        IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static appearance:IdeTheme.Light}}"
                        Command="{Binding UseTabStudioThemeCommand}" CommandParameter="{x:Static appearance:IdeTheme.Light}" />
              <MenuItem Header="Follow the _System" ToggleType="Radio" GroupName="IdeTheme"
                        IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static appearance:IdeTheme.System}}"
                        Command="{Binding UseTabStudioThemeCommand}" CommandParameter="{x:Static appearance:IdeTheme.System}" />
            </MenuItem>

          </MenuItem>
          <MenuItem Header="_Window">
            <MenuItem Header="_Next Document" InputGesture="Ctrl+Tab" Command="{Binding NextDocumentCommand}" />
            <MenuItem Header="_Previous Document" InputGesture="Ctrl+Shift+Tab" Command="{Binding PreviousDocumentCommand}" />
          </MenuItem>
        </Menu>

        <!-- One search for everything: files, commands, settings, symbols, templates and recent solutions (Ctrl+Q). -->
        <Button x:Name="SearchButton" Grid.Column="3" Theme="{StaticResource SecondaryButton}" Height="32" MinHeight="32"
                Margin="10,0,0,0" Padding="10,0,6,0" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                Command="{Binding Search.OpenCommand}" ToolTip.Tip="Search (Ctrl+Q)">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <controls:StrokeIcon Data="{StaticResource Icon.Search}" Size="14" />
            <TextBlock x:Name="SearchLabel" Grid.Column="1" Text="Search" Margin="8,0,0,0" FontSize="12.5" FontWeight="Normal"
                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="keycap" VerticalAlignment="Center">
              <TextBlock Text="Ctrl+Q" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>

        <!-- The solution's name, which trims when the menu bar is short of room. -->
        <Border x:Name="SolutionChip" Grid.Column="4" Height="28" Padding="10,0" Margin="10,0,0,0" CornerRadius="8" Background="{DynamicResource Brush.Panel}"
                HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="{Binding Title}">
          <Grid ColumnDefinitions="Auto,*">
            <controls:StrokeIcon Data="{StaticResource Icon.Solution}" Size="14" Margin="0,0,6,0" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Brush.TextSecondary}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!--
      Standard toolbar: an adaptive bar that never scrolls or clips. When it runs out of room the least used commands
      fold to their icons and then into More, by priority (docs/design/stage-2.md, 2.4); Run and Stop always stay.
    -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid Margin="8,0" ColumnDefinitions="*,Auto">
        <controls:AdaptiveBar x:Name="Toolbar" Spacing="2" VerticalAlignment="Center">
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Back}" Label="Navigate Backward" Gesture="Alt+Left" ShowsLabel="False" IconSize="16"
                                    Priority="30" Command="{Binding NavigateBackCommand}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Forward}" Label="Navigate Forward" Gesture="Alt+Right" ShowsLabel="False" IconSize="16"
                                    Priority="20" Command="{Binding NavigateForwardCommand}" />
          <controls:AdaptiveBarSeparator />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Save}" Label="Save" Gesture="Ctrl+S" ShowsLabel="False" IconSize="16"
                                    Priority="60" Command="{Binding SaveCommand}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.SaveAll}" Label="Save All" Gesture="Ctrl+Shift+S" ShowsLabel="False" IconSize="16"
                                    Priority="25" Command="{Binding SaveAllCommand}" />
          <controls:AdaptiveBarSeparator />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Undo}" Label="Undo" Gesture="Ctrl+Z" ShowsLabel="False" IconSize="16"
                                    Priority="50" Command="{Binding UndoCommand}" IsEnabled="{Binding ActiveDocument.CanUndo, FallbackValue=False}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Redo}" Label="Redo" Gesture="Ctrl+Y" ShowsLabel="False" IconSize="16"
                                    Priority="40" Command="{Binding RedoCommand}" IsEnabled="{Binding ActiveDocument.CanRedo, FallbackValue=False}" />
          <controls:AdaptiveBarSeparator />

          <!-- Configuration: Debug or Release; in More it becomes a submenu. -->
          <controls:AdaptiveBarItem x:Name="ConfigurationItem" Theme="{StaticResource SecondaryButton}" Icon="{StaticResource Icon.Build}" IconSize="16"
                                    Label="{Binding Configuration}" Priority="48" Margin="2,0" Padding="10,0"
                                    controls:AdaptiveBar.MenuHeader="{Binding Configuration, StringFormat='Solution Configuration: {0}'}">
            <controls:AdaptiveBarItem.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Debug" Command="{Binding SetConfigurationCommand}" CommandParameter="Debug" />
                <MenuItem Header="Release" Command="{Binding SetConfigurationCommand}" CommandParameter="Release" />
              </MenuFlyout>
            </controls:AdaptiveBarItem.Flyout>
          </controls:AdaptiveBarItem>

          <!-- Run: the startup project, with a menu to choose another one. Both halves are enabled together. -->
          <StackPanel x:Name="RunSplit" Orientation="Horizontal" Margin="8,0,4,0" controls:AdaptiveBar.IsPinned="True">
            <Button x:Name="RunButton" Theme="{StaticResource AccentButton}" Height="36" MinHeight="36" CornerRadius="8,0,0,8" Padding="12,0"
                    ToolTip.Tip="{Binding StartDebuggingToolTip}" Command="{Binding StartDebuggingCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:StrokeIcon Data="{StaticResource Icon.Play}" IsFilled="True" Size="14" />
                <TextBlock Text="{Binding StartDebuggingLabel}" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button x:Name="RunTargetButton" Theme="{StaticResource AccentButton}" Height="36" MinHeight="36" Width="30" MinWidth="30" Padding="0"
                    CornerRadius="0,8,8,0" BorderBrush="{DynamicResource Brush.OnAccent.Divider}" BorderThickness="1,0,0,0"
                    IsEnabled="{Binding #RunButton.IsEffectivelyEnabled}" ToolTip.Tip="Choose Startup Project or Launch Configuration">
              <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="14" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding RunTargets}">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:RunTargetOption">
                      <Setter Property="Header" Value="{Binding Header}" />
                      <Setter Property="Command" Value="{Binding Select}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Stop}" IsIconFilled="True" IconSize="14" Label="Stop" Gesture="Shift+F5" ShowsLabel="False"
                                    IsPinned="True" IconBrush="{DynamicResource Brush.Error}" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />

          <!-- Debugging, as Visual Studio's Debug toolbar: Start Without Debugging, or while debugging Break All, Stop, Restart and the steps. -->
          <!-- Only where the runtime can apply edits: on Android, C# edits apply with a restart (the item below). -->
          <controls:AdaptiveBarItem x:Name="HotReloadButton" Icon="{StaticResource Icon.Restart}" IconSize="16" Label="Hot Reload" Gesture="Alt+F10"
                                    Priority="95" Command="{Binding ApplyHotReloadCommand}"
                                    IsVisible="{x:Static hotReload:HotReloadSession.IsSupported}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Restart}" IconSize="16" Label="Restart to apply edits"
                                    IsPinned="True" IsVisible="{Binding HotReloadNeedsRestart}" Command="{Binding RestartForHotReloadCommand}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.PlayOutline}" IconSize="15" Label="Start Without Debugging" Gesture="Ctrl+F5" ShowsLabel="False"
                                    Priority="45" IconBrush="{DynamicResource Brush.Success}" Command="{Binding RunCommand}" IsVisible="{Binding !IsDebugging}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Pause}" IconSize="16" Label="Break All" Gesture="Ctrl+Alt+Break" ShowsLabel="False"
                                    Priority="70" Command="{Binding BreakAllCommand}" IsVisible="{Binding IsDebugging}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Stop}" IsIconFilled="True" IconSize="14" Label="Stop Debugging" Gesture="Shift+F5" ShowsLabel="False"
                                    IsPinned="True" IconBrush="{DynamicResource Brush.Error}" Command="{Binding StopDebuggingCommand}" IsVisible="{Binding IsDebugging}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Restart}" IconSize="16" Label="Restart" Gesture="Ctrl+Shift+F5" ShowsLabel="False"
                                    Priority="65" Command="{Binding RestartCommand}" IsVisible="{Binding IsDebugging}" />
          <controls:AdaptiveBarSeparator IsVisible="{Binding IsDebugging}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.NextStatement}" IsIconFilled="True" IconSize="16" Label="Show Next Statement" Gesture="Alt+Num *"
                                    ShowsLabel="False" Priority="62" IconBrush="{DynamicResource Brush.CurrentStatement}"
                                    Command="{Binding ShowNextStatementCommand}" IsVisible="{Binding IsDebugging}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.StepInto}" IconSize="16" Label="Step Into" Gesture="F11"
                                    Priority="85" Command="{Binding StepIntoCommand}" IsVisible="{Binding IsDebugging}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.StepOver}" IconSize="16" Label="Step Over" Gesture="F10"
                                    Priority="90" Command="{Binding StepOverCommand}" IsVisible="{Binding IsDebugging}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.StepOut}" IconSize="16" Label="Step Out" Gesture="Shift+F11"
                                    Priority="80" Command="{Binding StepOutCommand}" IsVisible="{Binding IsDebugging}" />
          <controls:AdaptiveBarSeparator />

          <!-- Where the startup project runs; a tap chooses another target, as the Run button's menu does. -->
          <controls:AdaptiveBarItem x:Name="RunHostItem" Icon="{StaticResource Icon.Computer}" IconSize="16"
                                    Label="{Binding RunHostText, StringFormat='Run on {0}'}" Priority="35" IsVisible="{Binding HasRunHost}" />
          <controls:AdaptiveBarSeparator />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Comment}" IconSize="16" Label="Toggle Line Comment" Gesture="Ctrl+/" ShowsLabel="False"
                                    Priority="15" Command="{Binding ToggleCommentCommand}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Format}" IconSize="16" Label="Format Document" Gesture="Shift+Alt+F" ShowsLabel="False"
                                    Priority="10" Command="{Binding FormatDocumentCommand}" />
          <controls:AdaptiveBarItem Icon="{StaticResource Icon.Search}" IconSize="16" Label="Find" Gesture="Ctrl+F" ShowsLabel="False"
                                    Priority="55" Command="{Binding FindCommand}" />
        </controls:AdaptiveBar>

        <!-- Problems at a glance, pinned beside the toolbar. -->
        <Button x:Name="ProblemsButton" Grid.Column="1" Margin="8,0,0,0" Theme="{StaticResource ToolButton}" VerticalAlignment="Center"
                Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.ErrorList}" ToolTip.Tip="Error List">
          <!-- A spinner animates only while it is shown: an animation on a hidden control would keep the IDE rendering. -->
          <Panel>
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding !ErrorList.IsPending}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="15" Foreground="{DynamicResource Brush.Error}" />
                <TextBlock Text="{Binding ErrorList.ErrorCount}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="15" Foreground="{DynamicResource Brush.Warning}" />
                <TextBlock Text="{Binding ErrorList.WarningCount}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <!-- While packages restore or the solution is analyzed, the counts are about to change: say so instead. -->
            <StackPanel x:Name="ProblemsPending" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ErrorList.IsPending}">
              <controls:StrokeIcon Classes.spinning="{Binding ErrorList.IsPending}" Data="{StaticResource Icon.Spinner}" Size="14" StrokeThickness="2.2" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Text="{Binding ErrorList.PendingText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>
          </Panel>
        </Button>
      </Grid>
    </Border>

    <!--
      Main area: documents and the bottom dock, the side bar's tool windows, and the activity bar on the outer edge. On
      a narrow or portrait screen the side bar is a drawer over the editor (WorkspaceView.Layout.cs).
    -->
    <Grid Grid.Row="2" x:Name="MainArea" ColumnDefinitions="*,Auto,330,48">
      <Grid x:Name="EditorArea" RowDefinitions="38,30,*,Auto,200">

        <!-- Document tabs -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
          <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                   ItemContainerTheme="{StaticResource DocumentTab}"
                   ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:DocumentViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Height="36">
                  <Border Classes="badge" Background="{Binding FileType.BadgeKind, Converter={x:Static conv:AppConverters.BadgeBackground}}" IsVisible="{Binding !HasFileIcon}">
                    <TextBlock Text="{Binding FileType.Badge}" Foreground="{Binding FileType.BadgeKind, Converter={x:Static conv:AppConverters.BadgeForeground}}" />
                  </Border>
                  <Image Source="{Binding FileIcon}" Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding HasFileIcon}" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  <!-- TabStudio Live: who else shows this document, as small avatars. -->
                  <ItemsControl ItemsSource="{Binding LiveAvatars}" IsVisible="{Binding HasLiveAvatars}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="-4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="liveVm:LiveAvatarViewModel">
                        <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Background}" BorderBrush="{DynamicResource Brush.Toolbar}" BorderThickness="1"
                                ToolTip.Tip="{Binding Name}">
                          <TextBlock Text="{Binding Initials}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnAccent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Theme="{StaticResource ToolButton}" Width="26" Height="26" MinWidth="26" MinHeight="26" Padding="0" CornerRadius="5"
                          ToolTip.Tip="Close (Ctrl+F4)"
                          Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).CloseDocumentCommand}"
                          CommandParameter="{Binding}">
                    <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="12" Foreground="{DynamicResource Brush.TextMuted}" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Breadcrumb -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sys:String">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
                    <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="12" Foreground="{DynamicResource Brush.TextDisabled}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The type and member at the caret: tap one to jump to a declaration next to it. -->
            <ItemsControl ItemsSource="{Binding ActiveDocument.SymbolPath, FallbackValue={x:Null}}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:SymbolCrumbViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Theme="{StaticResource ToolButton}" Height="28" MinHeight="28" MinWidth="0" Padding="6,0" CornerRadius="6">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:SymbolGlyphIcon Kind="{Binding Kind}" Size="14" />
                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding Siblings}">
                          <MenuFlyout.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:SymbolCrumbViewModel">
                              <Setter Property="Header" Value="{Binding Name}" />
                              <Setter Property="Command" Value="{Binding NavigateCommand}" />
                              <Setter Property="Icon">
                                <Template>
                                  <controls:SymbolGlyphIcon Kind="{Binding Kind}" Size="14" />
                                </Template>
                              </Setter>
                            </ControlTheme>
                          </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="12" Foreground="{DynamicResource Brush.TextDisabled}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Editors -->
        <Panel x:Name="EditorPanel" Grid.Row="2">
          <!--
            Over the files of a .NET Framework program that needs Windows: why it is not compiled here, and the two ways
            on: run it on the paired PC, or upgrade it to an SDK-style project (WorkspaceViewModel.NetFramework.cs).
          -->
          <DockPanel>
            <Border x:Name="NetFrameworkBanner" DockPanel.Dock="Top" IsVisible="{Binding HasNetFrameworkBanner}"
                    Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,8">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <controls:StrokeIcon Data="{StaticResource Icon.Info}" Size="15" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding NetFrameworkBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource Brush.Text}" />
                <Button x:Name="RunOnWindowsBridgeBannerButton" Grid.Column="2" Theme="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="10,0"
                        Height="32" MinHeight="32" Command="{Binding RunNetFrameworkProjectOnWindowsBridgeCommand}"
                        ToolTip.Tip="Build and run it on your Windows PC">
                  <TextBlock Text="Run on Windows Bridge" FontSize="12.5" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="UpgradeProjectBannerButton" Grid.Column="3" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,0"
                        Height="32" MinHeight="32" Command="{Binding UpgradeProjectCommand}" CommandParameter="{x:Null}"
                        ToolTip.Tip="Convert it to an SDK-style .NET project, and review the change">
                  <TextBlock Text="Upgrade project" FontSize="12.5" VerticalAlignment="Center" />
                </Button>
              </Grid>
            </Border>
            <controls:DocumentHost x:Name="Editors" Documents="{Binding Documents}" ActiveDocument="{Binding ActiveDocument}" />
          </DockPanel>

          <controls:EmptyState IsVisible="{Binding !HasDocuments}" Icon="{StaticResource Icon.File}" Title="No document is open"
                               Message="Open a file from the Solution Explorer, or find one with Search (Ctrl+Q)."
                               ActionText="Search" ActionCommand="{Binding Search.OpenCommand}" />

          <!--
            The floating touch buttons, editing or debugging (WorkspaceView.TouchBar.cs): they show after a touch and fade
            away while a hardware keyboard types, sit above the bottom dock, and move to the top of the editor when the
            caret's line or a popup such as the completion list would be under them. Folded into one small button they
            cover no code.
          -->
          <Panel x:Name="TouchBarHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,12">
            <Panel.IsVisible>
              <MultiBinding Converter="{x:Static conv:DesktopModeConverters.TouchBarsVisible}">
                <Binding Path="ShowsEditorTouchBar" />
                <Binding Path="IsDebugging" />
                <Binding Path="$self.(input:InputModality.PrefersKeyboard)" />
              </MultiBinding>
            </Panel.IsVisible>
            <Panel x:Name="TouchBarFader" IsVisible="{Binding IsTouchInput}">
              <Panel.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
              </Panel.Transitions>
              <Button x:Name="UnfoldTouchBarButton" Theme="{StaticResource ToolButton}" Width="44" Height="44" CornerRadius="14" Padding="0"
                      Background="{DynamicResource Brush.Hover}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
                      Command="{Binding ToggleTouchBarCommand}" IsVisible="{Binding IsTouchBarCollapsed}" ToolTip.Tip="Show the touch buttons">
                <controls:StrokeIcon Data="{StaticResource Icon.ChevronLeft}" Size="18" />
              </Button>
              <Panel IsVisible="{Binding !IsTouchBarCollapsed}">
                <!-- Touch actions: what a keyboard user reaches with F2, Alt+F12, Ctrl+/, Ctrl+F10, Shift+Alt+F and F5. -->
                <Border x:Name="EditTouchBar" Padding="4" CornerRadius="{StaticResource Radius.Dialog}"
                        Background="{DynamicResource Brush.Hover}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
                        BoxShadow="{DynamicResource Shadow.Popup}" IsVisible="{Binding ShowsEditorTouchBar}">
                  <DockPanel>
                    <Button x:Name="FoldTouchBarButton" DockPanel.Dock="Left" Theme="{StaticResource ToolButton}" Width="32" Height="44" MinWidth="32"
                            CornerRadius="{StaticResource Radius.Card}" Padding="0" Margin="0,0,2,0"
                            Command="{Binding ToggleTouchBarCommand}" ToolTip.Tip="Fold the touch buttons away">
                      <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="16" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Button>
                    <controls:AdaptiveBar x:Name="TouchBar" Spacing="2" MorePlacement="TopEdgeAlignedRight">
                      <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.Rename}" IconSize="16" Label="Rename" Gesture="F2"
                                                Priority="30" Command="{Binding RenameSymbolCommand}" />
                      <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.Search}" IconSize="16" Label="Peek" Gesture="Alt+F12"
                                                Priority="25" Command="{Binding PeekDefinitionCommand}" />
                      <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.Comment}" IconSize="16" Label="Comment" Gesture="Ctrl+/"
                                                Priority="20" Command="{Binding ToggleCommentCommand}" />
                      <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.Forward}" IconSize="16" Label="To Cursor" Gesture="Ctrl+F10"
                                                Priority="15" Command="{Binding RunToCursorCommand}" />
                      <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.Format}" IconSize="16" Label="Format" Gesture="Shift+Alt+F"
                                                Priority="10" Command="{Binding FormatDocumentCommand}" />
                      <controls:AdaptiveBarItem Classes="touch" Theme="{StaticResource AccentButton}" Icon="{StaticResource Icon.Play}" IsIconFilled="True"
                                                IconSize="14" Label="Run" Gesture="F5" IsPinned="True" Priority="100" FontWeight="SemiBold"
                                                Command="{Binding StartDebuggingCommand}" />
                    </controls:AdaptiveBar>
                  </DockPanel>
                </Border>
                <views:DebugTouchBarView x:Name="DebugTouchBar" IsVisible="{Binding IsDebugging}" />
              </Panel>
            </Panel>
          </Panel>
          <actionViews:RunNoticeView x:Name="RunNotice" DataContext="{Binding Actions}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,12" />
        </Panel>

        <GridSplitter Grid.Row="3" x:Name="BottomSplitter" Height="12" Margin="0,-3" ZIndex="10" ResizeDirection="Rows" Background="Transparent">
          <GridSplitter.Template>
            <ControlTemplate>
              <Border Background="Transparent">
                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Brush.Divider}" />
              </Border>
            </ControlTemplate>
          </GridSplitter.Template>
        </GridSplitter>

        <!-- Bottom dock -->
        <Border Grid.Row="4" x:Name="BottomDock" Background="{DynamicResource Brush.Toolbar}">
          <DockPanel>
            <!--
              The time-travel timeline, while a recording is kept: stepping backwards as the debug toolbar steps forwards,
              folding to icons on a narrow screen; the recorded steps to drag through; and where in the recording the
              debugger is.
            -->
            <Border x:Name="RecordingTimeline" DockPanel.Dock="Top" IsVisible="{Binding HasRecording}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,4,12,6">
              <StackPanel Spacing="2">
                <controls:AdaptiveBar x:Name="RecordingBar" Spacing="2">
                  <controls:AdaptiveBarItem Icon="{StaticResource Icon.StepBack}" IconSize="16" Label="Step Back" Gesture="Shift+F10"
                                            IsPinned="True" Command="{Binding StepBackCommand}" />
                  <controls:AdaptiveBarItem Icon="{StaticResource Icon.StepBackInto}" IconSize="16" Label="Step Back Into"
                                            Priority="60" Command="{Binding StepBackIntoCommand}" />
                  <controls:AdaptiveBarItem Icon="{StaticResource Icon.ReverseContinue}" IsIconFilled="True" IconSize="14" Label="Reverse Continue"
                                            Priority="70" Command="{Binding ReverseContinueCommand}" />
                  <controls:AdaptiveBarSeparator />
                  <controls:AdaptiveBarItem Icon="{StaticResource Icon.NextStatement}" IsIconFilled="True" IconSize="16" Label="Return to Live"
                                            Priority="80" IconBrush="{DynamicResource Brush.CurrentStatement}" Command="{Binding ReturnToLiveCommand}" />
                </controls:AdaptiveBar>
                <Slider x:Name="RecordingSlider" Minimum="0" Maximum="{Binding RecordingMaximum}" Value="{Binding RecordingPosition, Mode=TwoWay}"
                        IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="{Binding CanNavigateRecording}" MinHeight="36" Margin="4,0,0,0"
                        AutomationProperties.Name="Recorded steps" ToolTip.Tip="Drag to any recorded step" />
                <TextBlock Text="{Binding RecordingLabel}" Classes="small muted" Margin="4,0,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RecordingLabel}" />
              </StackPanel>
            </Border>
            <Grid DockPanel.Dock="Top" Height="34" ColumnDefinitions="*,Auto" Margin="6,0">
              <!-- The tabs scroll sideways when the debugger's tabs leave too little room beside the Output's source. -->
              <ScrollViewer x:Name="BottomTabsScroller" Margin="0,0,10,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <StackPanel x:Name="BottomTabs" Orientation="Horizontal">
                <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsErrorListSelected}"
                        Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.ErrorList}" Content="Error List" />
                <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsOutputSelected}"
                        Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Output}" Content="Output" />
                <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsCompatibilitySelected}"
                        Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Compatibility}" Content="Compatibility Doctor" />
                <Button Theme="{StaticResource PanelTabButton}"
                        Classes.selected="{Binding SelectedPanel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:BottomPanel.References}}"
                        Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.References}" Content="References" />
                <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsLocalsSelected}" IsVisible="{Binding ShowsDebugPanels}"
                        Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Locals}" Content="Locals" />
                <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsWatchSelected}" IsVisible="{Binding ShowsDebugPanels}"
                        Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Watch}" Content="Watch" />
                <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsCallStackSelected}" IsVisible="{Binding ShowsDebugPanels}"
                        Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.CallStack}" Content="Call Stack" />
                <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsTerminalSelected}"
                        Command="{Binding ShowTerminalCommand}" Content="Terminal" />
                <Button Theme="{StaticResource PanelTabButton}" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.Logcat}" Content="Logcat"
                        Classes.selected="{Binding SelectedPanel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:BottomPanel.Logcat}}"
                        IsVisible="{Binding ShowsLogcatTab}" />
                <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsSerialMonitorSelected}"
                        Command="{Binding ShowSerialMonitorCommand}" Content="Serial Monitor" IsVisible="{Binding ShowsSerialMonitorTab}" />
                <Button Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsEmbeddedPeripheralsSelected}"
                        Command="{Binding ShowEmbeddedPeripheralsCommand}" Content="Peripherals" IsVisible="{Binding ShowsEmbeddedPeripheralsTab}" />
              </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- On a narrow panel the label goes and the picker narrows, so the tabs and Hide keep their room. -->
                <Panel x:Name="OutputSourceLabelHost" VerticalAlignment="Center">
                  <TextBlock Classes="muted small" Text="Show output from:" VerticalAlignment="Center" Margin="0,0,8,0"
                             IsVisible="{Binding IsOutputSelected}" />
                </Panel>
                <ComboBox x:Name="OutputSourceBox" MinWidth="170" Height="30" MinHeight="30" Margin="0,0,6,0" FontSize="12.5" VerticalAlignment="Center"
                          ItemsSource="{Binding OutputSources}" SelectedItem="{Binding SelectedOutputSource}" IsVisible="{Binding IsOutputSelected}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:OutputSourceOption">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Theme="{StaticResource ToolButton}" MinHeight="30" Height="30" FontSize="12.5" Content="Clear"
                        Command="{Binding ShownOutput.ClearCommand}" IsVisible="{Binding IsOutputSelected}" />
                <Button Theme="{StaticResource ToolButton}" MinHeight="30" Height="30" FontSize="12.5" Content="Clear"
                        Command="{Binding Terminal.ClearCommand}" IsVisible="{Binding IsTerminalSelected}" />
                <Button Theme="{StaticResource ToolButton}" MinHeight="30" Height="30" FontSize="12.5" Content="Restart"
                        Command="{Binding Terminal.RestartCommand}" IsVisible="{Binding IsTerminalSelected}" />
                <Button x:Name="HideBottomPanelButton" Theme="{StaticResource ToolButton}" Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0"
                        ToolTip.Tip="Hide" Command="{Binding ToggleBottomPanelCommand}">
                  <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="14" />
                </Button>
              </StackPanel>
            </Grid>
            <!-- While debugging, the Call Stack stays in view beside Locals and Watch, as in Visual Studio's debug layout. -->
            <!-- Its width follows the panel's (WorkspaceView.Layout.cs): on a phone it gives Locals the room and keeps its tab. -->
            <Border x:Name="CallStackBeside" DockPanel.Dock="Right" Width="380" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
                    IsVisible="{Binding ShowsCallStackBeside}">
              <views:CallStackView DataContext="{Binding CallStack}" />
            </Border>
            <Panel>
              <views:ErrorListView DataContext="{Binding ErrorList}" IsVisible="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).IsErrorListSelected}" />
              <views:OutputView DataContext="{Binding ShownOutput}" IsVisible="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).IsOutputSelected}" />
              <views:CompatibilityView IsVisible="{Binding IsCompatibilitySelected}" />
              <Panel IsVisible="{Binding SelectedPanel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:BottomPanel.References}}">
                <views:ReferencesView DataContext="{Binding References}" />
              </Panel>
              <views:LocalsView DataContext="{Binding Locals}" IsVisible="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).IsLocalsSelected}" />
              <views:WatchView DataContext="{Binding Watch}" IsVisible="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).IsWatchSelected}" />
              <views:EmbeddedPeripheralsView IsVisible="{Binding IsEmbeddedPeripheralsSelected}" />
              <views:CallStackView DataContext="{Binding CallStack}" IsVisible="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).IsCallStackSelected}" />
              <Panel x:Name="LogcatPanel" IsVisible="{Binding SelectedPanel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:BottomPanel.Logcat}}">
                <views:OutputView DataContext="{Binding Logcat}" />
                <ScrollViewer IsVisible="{Binding Logcat.IsEmpty}" HorizontalScrollBarVisibility="Disabled">
                  <controls:EmptyState Icon="{StaticResource Icon.Log}" Title="No log yet" IsCompact="True"
                                       Message="Run Android App installs the app and follows its log here: its own process, from the debug build."
                                       ActionText="Run Android App" ActionCommand="{Binding RunAndroidCommand}" />
                </ScrollViewer>
              </Panel>
              <toolchainViews:TerminalPanelView DataContext="{Binding Terminal}" IsVisible="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).IsTerminalSelected}" />
              <toolchainViews:SerialMonitorView DataContext="{Binding SerialMonitor}" IsVisible="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).IsSerialMonitorSelected}" />
            </Panel>
          </DockPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" x:Name="SideSplitter" Width="12" Margin="-3,0" ZIndex="10" ResizeDirection="Columns" Background="Transparent">
        <GridSplitter.Template>
          <ControlTemplate>
            <Border Background="Transparent">
              <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource Brush.Border}" />
            </Border>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>

      <!-- On a narrow screen, a tap beside the drawer closes it. -->
      <Border x:Name="DrawerDismiss" Grid.Column="0" Grid.ColumnSpan="3" Background="Transparent" IsVisible="False" ZIndex="9" />

      <!--
        The side bar: the tool window the activity bar chose. Docked beside the editor on a wide screen, a drawer over it
        on a narrow or portrait one.
      -->
      <Border x:Name="SideBarFrame" Grid.Column="2" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" ZIndex="10">
        <Grid x:Name="SideBar" RowDefinitions="*,Auto,Auto">
          <views:SolutionExplorerView DataContext="{Binding Explorer}" />
          <Panel Grid.RowSpan="3" ZIndex="20" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsRemoteExplorerSelected}">
            <views:RemoteExplorerView DataContext="{Binding RemoteExplorer}" />
          </Panel>
          <GridSplitter Grid.Row="1" x:Name="PropertiesSplitter" Height="12" Margin="0,-3" ZIndex="10" ResizeDirection="Rows" Background="Transparent" IsVisible="False">
            <GridSplitter.Template>
              <ControlTemplate>
                <Border Background="Transparent">
                  <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Brush.Divider}" />
                </Border>
              </ControlTemplate>
            </GridSplitter.Template>
          </GridSplitter>
          <!-- Properties, folded into its header until a tap opens it; hidden while a designer shows its own. -->
          <views:PropertiesView Grid.Row="2" x:Name="PropertiesPanel" DataContext="{Binding Properties}"
                                IsVisible="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).ShowsSideBarProperties}" />
          <views:GitChangesView Grid.Row="0" Grid.RowSpan="3" DataContext="{Binding GitChanges}"
                                IsVisible="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).IsGitChangesSelected}" />

          <!-- The repository's pull requests, beside Git Changes. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsPullRequestsSelected}">
            <prv:PullRequestListView x:Name="PullRequestList" DataContext="{Binding PullRequests}" />
          </Panel>

          <!-- The Test Explorer covers the Solution Explorer and Properties while its tab is selected. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsTestExplorerSelected}">
            <views:TestExplorerView x:Name="TestExplorer" DataContext="{Binding Tests}" />
          </Panel>

          <!-- The agent, like the Test Explorer, takes the whole side bar. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsAgentSelected}">
            <views:AgentPanelView DataContext="{Binding Agent}" />
          </Panel>

          <!-- The app preview of the running Avalonia app. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsAppPreviewSelected}">
            <views:AppPreviewView DataContext="{Binding AppPreview}" />
          </Panel>

          <!-- The Windows Bridge: programs running on the paired Windows PC, streamed live. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsWindowsBridgeSelected}">
            <bridgeViews:BridgePaneView DataContext="{Binding WindowsBridgePane}" />
          </Panel>

          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsContainersSelected}">
            <views:ContainersView DataContext="{Binding Containers}" />
          </Panel>

          <!-- Native backing services from the repository's Compose files. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsServicesSelected}">
            <views:ServicesView DataContext="{Binding Services}" />
          </Panel>

          <!-- The web preview of the running web app. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsWebPreviewSelected}">
            <views:WebPreviewView DataContext="{Binding WebPreview}" />
          </Panel>

          <!-- Live Share: who is in the session, Follow, and what each participant may do. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsLiveSelected}">
            <liveViews:LivePanelView DataContext="{Binding LivePanel}" />
          </Panel>

          <!-- The Swarm window: the phones and tablets that run the app, its toggles and the UI test recorder. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsSwarmSelected}">
            <swarmViews:SwarmView DataContext="{Binding Swarm}" />
          </Panel>

          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsDatabaseSelected}">
            <databaseViews:DatabaseExplorerView DataContext="{Binding DatabaseExplorer}" />
          </Panel>

          <!-- GitHub Actions: the commit's checks, runs, workflows and watched repositories. -->
          <Panel Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}" IsVisible="{Binding IsActionsSelected}">
            <actionViews:ActionsView DataContext="{Binding Actions}" />
          </Panel>

        </Grid>
      </Border>

      <!-- The activity bar: one icon per tool window, on the side bar's outer edge; a tap on the shown one folds the side bar. -->
      <Border x:Name="ActivityEdge" Grid.Column="3" Background="{DynamicResource Brush.ActivityBar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
        <controls:ActivityBar x:Name="ActivityBarView" Bar="{Binding Activity}" />
      </Border>
    </Grid>

    <!-- The long operations' panel, over the editor's bottom-left corner above the status bar item that opens it. -->
    <Panel x:Name="OperationsOverlay" Grid.Row="2" IsVisible="{Binding Operations.IsPanelOpen}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
           Margin="8,0,8,6" MaxWidth="460" MinWidth="300" ZIndex="20">
      <opsViews:OperationsPanel x:Name="OperationsPanelView" DataContext="{Binding Operations}" />
    </Panel>

    <!--
      Status bar: one adaptive bar, the IDE's state on the left and the editor's on the right, both folding into one More
      menu at the right end (docs/design/stage-2.md, 2.5). It stays quiet about what is fine: a language service that is
      ready, a device that is not throttling, a device that is not linked.
    -->
    <Border Grid.Row="3" Background="{Binding IsDebugging, Converter={x:Static conv:DebugConverters.StatusBarBackground}}">
      <controls:AdaptiveBar x:Name="StatusBar" Spacing="6" Margin="6,0" ItemTheme="{StaticResource StatusBarButton}" MorePlacement="TopEdgeAlignedRight"
                            VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Brush.OnAccent}" TextElement.FontSize="12">
        <!-- What the IDE is doing; long messages trim, with the whole message in the tooltip. -->
        <!-- It trims to the room the items after it leave, so on a phone it never pushes them out of the bar. -->
        <Grid x:Name="StatusMessage" ColumnDefinitions="Auto,*" Margin="6,0,4,0" Background="Transparent" ToolTip.Tip="{Binding StatusText}"
              controls:AdaptiveBar.MinLength="48">
          <controls:StrokeIcon Size="13" VerticalAlignment="Center" Data="{Binding State, Converter={x:Static conv:AppConverters.StateIcon}}" Foreground="{DynamicResource Brush.OnAccent}" />
          <TextBlock x:Name="StatusMessageText" Grid.Column="1" Margin="6,0,0,0" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Brush.OnAccent}"
                     VerticalAlignment="Center" MaxWidth="460" TextTrimming="WordEllipsis" />
        </Grid>

        <!--
          Long operations: the newest with its stage, numbers and time left ("Downloading Pico SDK 120/340 MB · about 2 min
          left"); tap for all of them, with Cancel where it is safe and each one's raw log.
        -->
        <Panel controls:AdaptiveBar.Priority="100" IsVisible="{Binding Operations.HasOperations}" controls:AdaptiveBar.MinLength="120"
               controls:AdaptiveBar.MenuHeader="{Binding Operations.StatusText}" controls:AdaptiveBar.MenuCommand="{Binding Operations.TogglePanelCommand}">
          <Button x:Name="OperationsButton" Theme="{StaticResource StatusBarButton}" Height="24" Command="{Binding Operations.TogglePanelCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding Operations.StatusText}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <controls:StrokeIcon Classes.spinning="{Binding Operations.HasOperations}" Data="{StaticResource Icon.Spinner}" Size="13" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OnAccent}" />
              <TextBlock x:Name="OperationsText" Grid.Column="1" Margin="6,0" Text="{Binding Operations.StatusText}" FontSize="12" VerticalAlignment="Center" MaxWidth="380" TextTrimming="WordEllipsis" />
              <ProgressBar Grid.Column="2" Width="56" Height="4" MinHeight="4" Minimum="0" Maximum="100" VerticalAlignment="Center"
                           Value="{Binding Operations.Current.Percent, FallbackValue=0}" IsIndeterminate="{Binding Operations.Current.IsIndeterminate, FallbackValue=False}" />
            </Grid>
          </Button>
        </Panel>

        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Branch}" IconSize="13" Priority="80"
                                  Command="{Binding ShowGitChangesCommand}" IsVisible="{Binding GitChanges.IsLinked}">
          <controls:AdaptiveBarItem.Label>
            <MultiBinding Converter="{x:Static conv:ShellConverters.BranchLabel}">
              <Binding Path="GitChanges.BranchName" />
              <Binding Path="GitChanges.IncomingCommits" />
            </MultiBinding>
          </controls:AdaptiveBarItem.Label>
        </controls:AdaptiveBarItem>

        <!-- The paired Windows PC: tap for the Windows Bridge pane. -->
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Computer}" IconSize="13" Priority="60"
                                  Label="{Binding WindowsBridgeStatusText}" ToolTip.Tip="{Binding WindowsBridgeStatusTip}"
                                  Command="{Binding OpenWindowsBridgeCommand}"
                                  IsVisible="{Binding WindowsBridgeStatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- The commit's CI: tap for GitHub Actions on this commit. -->
        <Panel controls:AdaptiveBar.Priority="75" controls:AdaptiveBar.IsPinned="False" IsVisible="{Binding Actions.IsCiVisible}"
               controls:AdaptiveBar.MenuHeader="{Binding Actions.CiText, StringFormat='CI: {0}'}"
               controls:AdaptiveBar.MenuCommand="{Binding Actions.ShowCommitChecksCommand}" controls:AdaptiveBar.MenuIcon="{StaticResource Icon.Actions}">

          <actionViews:CiStatusBarItem DataContext="{Binding Actions}" />
        </Panel>

        <!-- Live Unit Testing, while it is on: what it does, or how the tests fare; tap for Pause and Stop. -->
        <controls:AdaptiveBarItem Classes="status" Icon="{Binding LiveTesting.State, Converter={x:Static conv:LiveTestingConverters.StateIcon}}" IconSize="13"
                                  Label="{Binding LiveTesting.StatusText}" Priority="60" IsVisible="{Binding LiveTesting.IsEnabled}">
          <controls:AdaptiveBarItem.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedLeft">
              <MenuItem Header="Pause Live Unit Testing" Command="{Binding LiveTesting.PauseCommand}" IsVisible="{Binding !LiveTesting.IsPaused}" />
              <MenuItem Header="Continue Live Unit Testing" Command="{Binding LiveTesting.ContinueCommand}" IsVisible="{Binding LiveTesting.IsPaused}" />
              <MenuItem Header="Stop Live Unit Testing" Command="{Binding LiveTesting.StopCommand}" />
              <Separator />
              <MenuItem Header="Test Explorer" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.TestExplorer}" />
            </MenuFlyout>
          </controls:AdaptiveBarItem.Flyout>
        </controls:AdaptiveBarItem>

        <!-- The swarm, while it is on: how many devices are in it; tap for the Swarm window. -->
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Swarm}" IconSize="13" Label="{Binding Swarm.StatusText, FallbackValue={x:Null}}"
                                  Priority="55" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.Swarm}"
                                  IsVisible="{Binding Swarm.IsOn, FallbackValue=False}" />

        <!-- TabStudio Live, while in a session: how many are in it, or who this device follows; tap for Live Share. -->
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Live}" IconSize="13" Label="{Binding LivePanel.StatusText, FallbackValue={x:Null}}"
                                  Priority="56" Command="{Binding SelectSideBarPanelCommand}" CommandParameter="{x:Static vm:SideBarPanel.Live}"
                                  IsVisible="{Binding LivePanel.IsInSession, FallbackValue=False}" />

        <!-- TabStudio Link, while this device is linked: the host and its latency; tap for the Link dialog. -->
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Link}" IconSize="13" Label="{Binding LinkStatusText}"
                                  Priority="50" Command="{Binding OpenLinkCommand}" IsVisible="{Binding ShowsLinkStatus}" />

        <!-- Desktop mode, while an external display is connected: tap to move the IDE to it or back. -->
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Monitor}" IconSize="13" Label="{Binding DesktopMode.StatusText, FallbackValue={x:Null}}"
                                  Priority="45" Command="{Binding DesktopMode.ToggleCommand, FallbackValue={x:Null}}"
                                  IsVisible="{Binding DesktopMode.HasDisplay, FallbackValue=False}" />

        <!-- The diagnostic at the caret: tap for the Error List. -->
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Info}" IconSize="13" Label="{Binding ActiveDocument.CaretMessage, FallbackValue={x:Null}}"
                                  Priority="40" Command="{Binding SelectPanelCommand}" CommandParameter="{x:Static vm:BottomPanel.ErrorList}"
                                  IsVisible="{Binding ActiveDocument.CaretMessage, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />

        <!-- The language servers, only while they are not ready; loading C# is a long operation, with the others. -->
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Terminal}" IconSize="13" Label="{Binding LanguageServerText}" Priority="30"
                                  Command="{Binding ShowLanguageServerLogCommand}" IsVisible="{Binding ShowsLanguageServerStatus}" />
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Download}" IconSize="13" Priority="32"
                                  Label="{Binding ServerInstallOffer.StatusBarText, FallbackValue={x:Null}}" Command="{Binding InstallServerToolchainCommand}"
                                  IsVisible="{Binding ServerInstallOffer, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- The device, only when it matters: warm enough to slow TabStudio down, or small enough for Lite mode. -->
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Thermometer}" IconSize="13" Label="{Binding ThermalText}" Priority="22"
                                  IsVisible="{Binding IsThrottled}" />
        <controls:AdaptiveBarItem Classes="status" Icon="{StaticResource Icon.Tablet}" IconSize="13" Label="{Binding DeviceText}" Priority="20"
                                  IsVisible="{Binding DeviceText, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <controls:AdaptiveBarSpacer />

        <!-- The editor: the caret stays; the language, encoding, line endings and indentation fold into More. -->
        <controls:AdaptiveBarItem Classes="status" Label="{Binding CaretText}" IsPinned="True" Priority="90" IsVisible="{Binding ShowsEditorStatus}" />
        <controls:AdaptiveBarItem Classes="status" Label="Spaces: 4" Priority="20" IsVisible="{Binding ShowsEditorStatus}" />
        <controls:AdaptiveBarItem Classes="status" Label="{Binding ActiveDocument.EncodingLabel, FallbackValue={x:Null}}" Priority="30"
                                  IsVisible="{Binding ShowsEditorStatus}" />
        <controls:AdaptiveBarItem Classes="status" Label="{Binding ActiveDocument.NewlineLabel, FallbackValue={x:Null}}" Priority="25"
                                  IsVisible="{Binding ShowsEditorStatus}" />
        <controls:AdaptiveBarItem Classes="status" Label="{Binding ActiveDocument.FileType.DisplayName, FallbackValue={x:Null}}" Priority="70"
                                  IsVisible="{Binding ShowsEditorStatus}" />
      </controls:AdaptiveBar>
    </Border>

    <!-- Git's dialogs: switch branch, create a pull request, history. -->
    <views:GitDialogsView Grid.Row="0" Grid.RowSpan="4" DataContext="{Binding GitChanges}" />

    <!-- The swarm's Add a device dialog, with its QR code. -->
    <swarmViews:SwarmInviteView Grid.Row="0" Grid.RowSpan="4" DataContext="{Binding Swarm.Invite, FallbackValue={x:Null}}" />

    <!-- TabStudio Live's Share Session dialog, with its QR code. -->
    <liveViews:LiveShareView Grid.Row="0" Grid.RowSpan="4" DataContext="{Binding LivePanel, FallbackValue={x:Null}}" />

    <!-- GitHub Actions' dialog: Run workflow. -->
    <actionViews:ActionsDialogsView Grid.Row="0" Grid.RowSpan="4" DataContext="{Binding Actions}" />

    <!-- The quick pick: color themes, file icon themes and snippets. -->
    <extensionViews:QuickPickView Grid.Row="0" Grid.RowSpan="4" DataContext="{Binding QuickPick}" />
    <!-- The Toolchain Store, and offers to install a project's toolchain or packages. -->
    <toolchainViews:ToolchainOverlaysView Grid.Row="0" Grid.RowSpan="4" />

    <!-- One search for everything (Ctrl+Q): over the whole IDE, as a dialog at the top. -->
    <searchViews:UnifiedSearchView Grid.Row="0" Grid.RowSpan="4" DataContext="{Binding Search}" />

    <!-- The in-app dialog that asks for names and confirmations. -->
    <Panel Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource Brush.Scrim}" IsVisible="{Binding Prompt.IsOpen}">
      <Border x:Name="PromptDialog" MaxWidth="480" Margin="16" VerticalAlignment="Center" Padding="22" CornerRadius="{StaticResource Radius.Dialog}"
              Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
              BoxShadow="{DynamicResource Shadow.Dialog}">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" FontSize="15" Text="{Binding Prompt.Title}" TextWrapping="Wrap" />
          <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Prompt.Message}" />
          </ScrollViewer>
          <!-- A choice, such as which APK to install: rows to tap rather than a number to type. -->
          <Border CornerRadius="{StaticResource Radius.Control}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  Background="{DynamicResource Brush.Control}" ClipToBounds="True" IsVisible="{Binding Prompt.HasChoices}">
            <ListBox x:Name="PromptChoices" ItemsSource="{Binding Prompt.Choices}" SelectedIndex="{Binding Prompt.SelectedIndex}" MaxHeight="264"
                     ItemContainerTheme="{StaticResource ListRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="MinHeight" Value="40" />
                  <Setter Property="Padding" Value="12,0" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,8" VerticalAlignment="Center" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <TextBox x:Name="PromptBox" Classes="large mono" Text="{Binding Prompt.Text}" PasswordChar="{Binding Prompt.PasswordCharacter}" IsVisible="{Binding Prompt.HasInput}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Theme="{StaticResource SecondaryButton}" Height="40" Padding="18,0" Content="Cancel" Command="{Binding Prompt.CancelCommand}" />
            <Button Theme="{StaticResource AccentButton}" Height="40" Padding="18,0" Content="{Binding Prompt.ConfirmText}"
                    Classes.destructive="{Binding Prompt.IsDestructive}" Command="{Binding Prompt.ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>

