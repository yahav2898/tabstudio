<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.OutputView"
             x:DataType="vm:OutputViewModel">
  <DockPanel>
    <!-- Console input, shown while a program runs. -->
    <Border DockPanel.Dock="Bottom" Padding="10,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
            IsVisible="{Binding IsAcceptingInput}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <controls:StrokeIcon Data="{StaticResource Icon.Terminal}" Size="16" Margin="2,0,10,0"
                             Foreground="{DynamicResource Brush.AccentText}" />
        <TextBox x:Name="Input" Grid.Column="1" Classes="mono"
                 Watermark="Type input for the program and press Enter"
                 Text="{Binding InputText}" />
        <Button Grid.Column="2" Theme="{StaticResource AccentButton}" Margin="8,0,0,0"
                Content="Send" Command="{Binding SubmitInputCommand}" />
      </Grid>
    </Border>
    <ae:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="False" WordWrap="True" FontSize="{DynamicResource Type.Section}"
                   Padding="12,6,12,6" />
  </DockPanel>
</UserControl>
