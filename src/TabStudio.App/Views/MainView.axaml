<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:views="using:TabStudio.App.Views"
             xmlns:desktop="using:TabStudio.App.Views.DesktopMode"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontSize="13">
  <Panel x:Name="Root">
    <!--
      The IDE: the start screen or a workspace, with the GitHub sign-in over it. In desktop mode it moves to the
      external display as it is, editors and all, and the companion takes its place here.
    -->
    <Panel x:Name="Ide" TextElement.Foreground="{DynamicResource Brush.Text}" TextElement.FontSize="13">
      <controls:PageHost Page="{Binding CurrentPage}">
        <controls:PageHost.DataTemplates>
          <DataTemplate DataType="vm:StartViewModel">
            <views:StartView />
          </DataTemplate>
          <DataTemplate DataType="vm:WorkspaceViewModel">
            <views:WorkspaceView />
          </DataTemplate>
        </controls:PageHost.DataTemplates>
      </controls:PageHost>

      <!-- Signing in to GitHub, from the start screen or the IDE. -->
      <views:GitHubSignInView DataContext="{Binding GitHubAccount}" />

      <!-- TabStudio Link, from the start screen, the File menu or the status bar. -->
      <views:LinkView DataContext="{Binding Link}" />
    </Panel>

    <!-- Desktop mode: the tablet's touch companion while the IDE is on a display, and the offer to use a display. -->
    <desktop:DesktopCompanionView DataContext="{Binding DesktopMode}" />
    <desktop:DesktopModeOfferView DataContext="{Binding DesktopMode}" />
  </Panel>
</UserControl>
