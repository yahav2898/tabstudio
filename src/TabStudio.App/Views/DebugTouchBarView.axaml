<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.DebugTouchBarView"
             x:DataType="vm:WorkspaceViewModel">

  <UserControl.Styles>
    <!-- 44-pixel touch targets. -->
    <Style Selector="Button.touch">
      <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
      <Setter Property="MinWidth" Value="{DynamicResource Target.Size}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
  </UserControl.Styles>

  <!--
    The floating debug buttons over the editor while debugging: a tablet has no F5, F10 or F11 keys. An adaptive bar,
    so on a narrow editor the least used fold to their icons and then into More; Continue and Stop always stay.
  -->
  <Border Padding="4" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Brush.Hover}"
          BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1" BoxShadow="{DynamicResource Shadow.Popup}">
    <DockPanel>
      <Button DockPanel.Dock="Left" Theme="{StaticResource ToolButton}" CornerRadius="{StaticResource Radius.Card}"
              Padding="0" Margin="0,0,2,0" Command="{Binding ToggleTouchBarCommand}" ToolTip.Tip="Fold the touch buttons away">
        <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="16" Foreground="{DynamicResource Brush.TextSecondary}" />
      </Button>
      <controls:AdaptiveBar x:Name="Bar" Spacing="2" MorePlacement="TopEdgeAlignedRight">
        <!-- The primary action while paused: white on teal in both themes. -->
        <controls:AdaptiveBarItem Classes="touch" Theme="{StaticResource AccentButton}" Icon="{StaticResource Icon.Play}" IsIconFilled="True" IconSize="14"
                                  Label="Continue" Gesture="F5" IsPinned="True" Priority="100" FontWeight="SemiBold"
                                  Command="{Binding StartDebuggingCommand}" IsVisible="{Binding IsPaused}" />
        <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.Pause}" IconSize="16" Label="Break" Gesture="Ctrl+Alt+Break"
                                  Priority="75" Command="{Binding BreakAllCommand}" IsVisible="{Binding IsDebuggeeRunning}" />
        <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.StepOver}" IconSize="16" Label="Over" Gesture="F10"
                                  Priority="90" Command="{Binding StepOverCommand}" />
        <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.StepInto}" IconSize="16" Label="Into" Gesture="F11"
                                  Priority="85" Command="{Binding StepIntoCommand}" />
        <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.StepOut}" IconSize="16" Label="Out" Gesture="Shift+F11"
                                  Priority="80" Command="{Binding StepOutCommand}" />
        <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.NextStatement}" IconSize="16" Label="To Cursor" Gesture="Ctrl+F10"
                                  Priority="60" Command="{Binding RunToCursorCommand}" IsVisible="{Binding IsPaused}" />
        <controls:AdaptiveBarItem Classes="touch" Icon="{StaticResource Icon.Stop}" IsIconFilled="True" IconSize="13" Label="Stop" Gesture="Shift+F5"
                                  IsPinned="True" Priority="95" IconBrush="{DynamicResource Brush.Error}" Command="{Binding StopDebuggingCommand}" />
      </controls:AdaptiveBar>
    </DockPanel>
  </Border>
</UserControl>
