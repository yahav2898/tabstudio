<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:a11y="using:TabStudio.App.Accessibility"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.WebPreviewView"
             x:DataType="vm:WebPreviewViewModel">

  <!--
    The running web app in an embedded browser, beside the editor. Where the platform has no embedded browser,
    the page opens in the system browser instead.
  -->

  <DockPanel>
    <!-- Address bar -->
    <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <!-- A WPF app is one page: its toolbar makes room for the zoom instead of the history buttons. -->
        <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Back" Command="{Binding GoBackCommand}" IsVisible="{Binding !IsWpfApp}">
          <controls:StrokeIcon Data="{StaticResource Icon.Back}" Size="15" />
        </Button>
        <Button Grid.Column="1" Theme="{StaticResource ToolButton}" ToolTip.Tip="Forward" Command="{Binding GoForwardCommand}" IsVisible="{Binding !IsWpfApp}">
          <controls:StrokeIcon Data="{StaticResource Icon.Forward}" Size="15" />
        </Button>
        <Button Grid.Column="2" Theme="{StaticResource ToolButton}" ToolTip.Tip="Reload" Command="{Binding ReloadCommand}">
          <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="15" />
        </Button>
        <TextBox x:Name="Address" Grid.Column="3" Margin="4,0" Classes="mono" FontSize="{DynamicResource Type.Small}" VerticalAlignment="Center"
                 Text="{Binding AddressText}" Watermark="Address">
          <TextBox.InnerLeftContent>
            <controls:StrokeIcon Data="{StaticResource Icon.Globe}" Size="13" Margin="8,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <!-- A WPF app's window: whole (Fit), at its size (100%) or the pane's (Fill); pinch zooms further. -->
        <ComboBox x:Name="Zoom" Grid.Column="4" Margin="0,0,4,0" MinWidth="76" VerticalAlignment="Center"
                  ItemsSource="{Binding ZoomChoices}" SelectedItem="{Binding SelectedZoom}" IsVisible="{Binding IsWpfApp}"
                  ToolTip.Tip="Zoom: Fit shows the whole window, 100% its real size, Fill gives it the pane. Pinch to zoom further." />
        <Button Grid.Column="5" Theme="{StaticResource ToolButton}" ToolTip.Tip="Open in browser" Command="{Binding OpenInBrowserCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <controls:StrokeIcon Data="{StaticResource Icon.External}" Size="15" />
            <TextBlock Text="Open in browser" VerticalAlignment="Center" IsVisible="{Binding !IsWpfApp}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Panel>
      <!-- The embedded browser goes here. -->
      <Panel x:Name="BrowserHost" a11y:A11y.IsContent="True" IsVisible="{Binding IsRunning}" />

      <!-- No embedded browser, or the app is not running. -->
      <StackPanel x:Name="Placeholder" Margin="24" Spacing="12" VerticalAlignment="Center" MaxWidth="360">
        <controls:StrokeIcon Data="{StaticResource Icon.Globe}" Size="34" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" />
        <TextBlock Classes="h2" Text="{Binding Title}" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center" />
        <Button Theme="{StaticResource AccentButton}" HorizontalAlignment="Center" Command="{Binding OpenInBrowserCommand}" IsVisible="{Binding IsRunning}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:StrokeIcon Data="{StaticResource Icon.External}" Size="14" />
            <TextBlock Text="Open in Browser" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
