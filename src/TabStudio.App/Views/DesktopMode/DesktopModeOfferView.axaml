<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:dm="using:TabStudio.App.ViewModels.DesktopMode"
             x:Class="TabStudio.App.Views.DesktopMode.DesktopModeOfferView"
             x:DataType="dm:DesktopModeViewModel"
             IsVisible="{Binding IsOfferVisible, FallbackValue=False}">

  <!--
    Offered on the tablet when a display is connected: move the IDE to it now, always, or not now. It sits under the
    toolbar, over the top of the documents, as the IDE's other notices do: at the bottom it covered the Error List and
    the program's output.
  -->
  <Border x:Name="OfferCard" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,100,16,0" MaxWidth="700"
          Padding="18,16" CornerRadius="14" Background="{DynamicResource Brush.Popup}"
          BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1" BoxShadow="{DynamicResource Shadow.Dialog}">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
      <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Top">
        <controls:StrokeIcon Data="{StaticResource Icon.Monitor}" Size="22" Foreground="{DynamicResource Brush.AccentText}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
        <TextBlock Classes="h2" FontSize="15">
          <Run Text="{Binding DisplayName}" /><Run Text=" is connected" />
        </TextBlock>
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Move the IDE to the display, and use this tablet as a touch Toolbox and Properties panel. A keyboard and mouse work on the display as on a PC." />
      </StackPanel>
      <WrapPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Margin="14,14,0,0">
        <Button Theme="{StaticResource SecondaryButton}" Height="44" Padding="18,0" Margin="0,0,10,0" Content="Not now"
                Command="{Binding DismissOfferCommand}" />
        <Button Theme="{StaticResource SecondaryButton}" Height="44" Padding="18,0" Margin="0,0,10,0" Content="Always"
                ToolTip.Tip="Move the IDE to a display whenever one is connected" Command="{Binding UseAlwaysCommand}" />
        <Button Theme="{StaticResource AccentButton}" Height="44" Padding="18,0" Command="{Binding EnterCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:StrokeIcon Data="{StaticResource Icon.Monitor}" Size="16" />
            <TextBlock Text="Use desktop mode" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </Grid>
  </Border>
</UserControl>
