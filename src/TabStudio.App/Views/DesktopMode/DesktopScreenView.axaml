<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TabStudio.App.Views.DesktopMode.DesktopScreenView"
             Background="{DynamicResource Brush.Window}"
             Foreground="{DynamicResource Brush.Text}"
             FontSize="{DynamicResource Type.Section}">
  <!-- What the external display shows in desktop mode: the IDE, moved here from the tablet as it is. -->
  <Decorator x:Name="Host" />
</UserControl>
