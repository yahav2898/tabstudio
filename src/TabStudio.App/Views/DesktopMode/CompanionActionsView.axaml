<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:conv="using:TabStudio.App.Converters"
             xmlns:dm="using:TabStudio.App.ViewModels.DesktopMode"
             x:Class="TabStudio.App.Views.DesktopMode.CompanionActionsView"
             x:DataType="dm:DesktopCompanionViewModel">

  <!--
    The companion's big buttons: Start, Run and Build, Stop while a program runs, and while debugging Continue or
    Break, the steps and Restart. They do what F5, Ctrl+F5, Ctrl+Shift+B, Shift+F5, F10, F11 and Shift+F11 do on the
    big screen, and never take the keyboard from it.
  -->
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="{DynamicResource Type.Large}" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal">
        <!-- Before running -->
        <Button Theme="{StaticResource AccentButton}" Command="{Binding Workspace.StartDebuggingCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsStart}" ToolTip.Tip="Start Debugging (F5)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.Play}" IsFilled="True" Size="16" />
            <TextBlock Text="{Binding Workspace.RunLabel, FallbackValue={x:Null}}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding Workspace.RunCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsRun}" ToolTip.Tip="Start Without Debugging (Ctrl+F5)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.PlayOutline}" Size="17" Foreground="{DynamicResource Brush.Success}" />
            <TextBlock Text="Run" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- While debugging -->
        <Button Theme="{StaticResource AccentButton}" Command="{Binding Workspace.StartDebuggingCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsContinue}" ToolTip.Tip="Continue (F5)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.Play}" IsFilled="True" Size="16" />
            <TextBlock Text="Continue" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding Workspace.BreakAllCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsBreak}" ToolTip.Tip="Break All (Ctrl+Alt+Break)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.Pause}" Size="18" StrokeThickness="2.4" />
            <TextBlock Text="Break" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding Workspace.StepOverCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsSteps}" ToolTip.Tip="Step Over (F10)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.StepOver}" Size="19" />
            <TextBlock Text="Step Over" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding Workspace.StepIntoCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsSteps}" ToolTip.Tip="Step Into (F11)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.StepInto}" Size="19" />
            <TextBlock Text="Step Into" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding Workspace.StepOutCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsSteps}" ToolTip.Tip="Step Out (Shift+F11)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.StepOut}" Size="19" />
            <TextBlock Text="Step Out" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding Workspace.RestartCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsSteps}" ToolTip.Tip="Restart (Ctrl+Shift+F5)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.Restart}" Size="19" />
            <TextBlock Text="Restart" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Stopping a program, debugged or not -->
        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding Workspace.StopDebuggingCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsStop}" ToolTip.Tip="Stop (Shift+F5)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.Stop}" IsFilled="True" Size="15" Foreground="{DynamicResource Brush.Error}" />
            <TextBlock Text="Stop" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Theme="{StaticResource SecondaryButton}" Command="{Binding Workspace.BuildCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding ShowsStart}" ToolTip.Tip="Build Solution (Ctrl+Shift+B)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:StrokeIcon Data="{StaticResource Icon.Build}" Size="18" />
            <TextBlock Text="Build" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <!-- What the IDE is doing, as its status bar says. -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,4,0" VerticalAlignment="Center" MaxWidth="360">
      <controls:StrokeIcon Size="15" Data="{Binding Workspace.State, Converter={x:Static conv:AppConverters.StateIcon}, FallbackValue={x:Null}}"
                           Foreground="{DynamicResource Brush.TextMuted}" />
      <TextBlock Classes="muted" Text="{Binding Workspace.StatusText, FallbackValue={x:Null}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
