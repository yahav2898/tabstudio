<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:dm="using:TabStudio.App.ViewModels.DesktopMode"
             x:Class="TabStudio.App.Views.DesktopMode.XamlPropertiesView"
             x:DataType="dm:XamlPropertiesViewModel">

  <!--
    The Properties panel of the XAML element at the caret on the big screen: the attributes it sets first, then the
    other properties of its type by category. A value is written to the XAML on Enter, when picked, or when the field
    is left; an empty value or the reset button takes the attribute out.
  -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="paneHeader" Height="44" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="14,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <controls:StrokeIcon Data="{StaticResource Icon.Properties}" Size="16" Foreground="{DynamicResource Brush.AccentText}" />
        <TextBlock Classes="header" Text="Properties" FontSize="{DynamicResource Type.Large}" />
      </StackPanel>
    </Border>

    <!-- The element -->
    <Border DockPanel.Dock="Top" Padding="14,10,14,6" IsVisible="{Binding HasElement}">
      <StackPanel Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="badge markup" Background="{DynamicResource Brush.Control}" Height="18">
            <TextBlock Text="XAML" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding ElementName}" FontSize="{DynamicResource Type.Heading}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ElementId}" FontSize="{DynamicResource Type.Large}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                     IsVisible="{Binding ElementId, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <TextBlock Classes="small muted" Text="{Binding Location}" />
      </StackPanel>
    </Border>

    <TextBox DockPanel.Dock="Top" Classes="large" Margin="12,4,12,8" Watermark="Search properties" Text="{Binding SearchText}"
             IsVisible="{Binding HasElement}">
      <TextBox.InnerLeftContent>
        <controls:StrokeIcon Data="{StaticResource Icon.Search}" Size="15" Margin="12,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
      </TextBox.InnerLeftContent>
    </TextBox>

    <!-- Why the last edit could not be made. -->
    <Border DockPanel.Dock="Bottom" Padding="14,8" IsVisible="{Binding HasError}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="15" Foreground="{DynamicResource Brush.Error}" />
        <TextBlock Classes="small" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Any property by name, such as one of the app's own controls. -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10"
            IsVisible="{Binding HasElement}">
      <Grid ColumnDefinitions="*,*,Auto">
        <TextBox x:Name="NewNameBox" Classes="large mono" Watermark="Property" Text="{Binding NewName}" />
        <TextBox x:Name="NewValueBox" Grid.Column="1" Classes="large mono" Margin="8,0" Watermark="Value" Text="{Binding NewValue}" />
        <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Focusable="False" Height="44" Padding="14,0" Command="{Binding AddPropertyCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:StrokeIcon Data="{StaticResource Icon.Plus}" Size="14" />
            <TextBlock Text="Add" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Panel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasElement}">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="dm:XamlPropertyGroupViewModel">
              <StackPanel IsVisible="{Binding IsVisible}">
                <Button Theme="{StaticResource ToolButton}" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        MinHeight="40" CornerRadius="0" Padding="12,0" Background="{DynamicResource Brush.Toolbar}"
                        Command="{Binding ToggleExpandedCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Panel Width="14">
                      <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="14" IsVisible="{Binding IsExpanded}" />
                      <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="14" IsVisible="{Binding !IsExpanded}" />
                    </Panel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" VerticalAlignment="Center" />
                    <Border Classes="pill">
                      <TextBlock Text="{Binding VisibleCount}" />
                    </Border>
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="dm:XamlPropertyRowViewModel">
                      <Border IsVisible="{Binding IsVisible}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                              MinHeight="54" Padding="14,4,4,4">
                        <Grid ColumnDefinitions="0.42*,0.58*,48">
                          <StackPanel VerticalAlignment="Center" Spacing="1" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <Border Width="7" Height="7" CornerRadius="2" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center"
                                      IsVisible="{Binding IsSet}" />
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Type.Section}" Foreground="{DynamicResource Brush.TextBright}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding TypeName}" FontSize="{DynamicResource Type.Caption}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding ShowsTypeName}" />
                          </StackPanel>
                          <TextBox Grid.Column="1" Classes="large mono" Watermark="Not set" Text="{Binding Value}" IsVisible="{Binding UsesText}" />
                          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="44" PlaceholderText="Not set"
                                    ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding UsesChoices}" />
                          <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Focusable="False" Width="44" Height="44" HorizontalAlignment="Right"
                                  Command="{Binding ResetCommand}" IsVisible="{Binding IsSet}" ToolTip.Tip="Reset: take it out of the XAML">
                            <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="13" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="32" MaxWidth="380" IsVisible="{Binding !HasElement}">
        <controls:StrokeIcon Data="{StaticResource Icon.Properties}" Size="40" Foreground="{DynamicResource Brush.TextDisabled}" HorizontalAlignment="Center" />
        <TextBlock Classes="h2" Text="No element at the caret" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   Text="Put the caret in an element of the XAML on the big screen to see and change its properties here." />
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
