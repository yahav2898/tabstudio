<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             xmlns:swarm="using:TabStudio.App.Swarm"
             xmlns:views="using:TabStudio.App.Views.Swarm"
             x:Class="TabStudio.App.Views.Swarm.DeviceMatrixView"
             x:DataType="vm:DeviceMatrixViewModel"
             x:Name="Root"
             Background="{DynamicResource Brush.Window}">

  <!--
    The Device Matrix: every screen the app runs on as a tile. Virtual devices are live and touchable, the app preview
    is drawn live, phones in the swarm show their latest picture. Tap a tile to focus it; pinch or use the zoom
    buttons to resize them all.
  -->

  <UserControl.Styles>
    <Style Selector="Border.finding">
      <Setter Property="Background" Value="{DynamicResource Brush.Notice.Error}" />
    </Style>
    <Style Selector="Border.finding.warning">
      <Setter Property="Background" Value="{DynamicResource Brush.Notice.Warning}" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10,12,14" />
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="MinWidth" Value="268" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.tile.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Border.bezel">
      <Setter Property="Background" Value="{DynamicResource Brush.Swarm.Bezel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Swarm.BezelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.issueBadge">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.issueBadge.error">
      <Setter Property="Background" Value="{DynamicResource Brush.Notice.Error}" />
    </Style>
    <Style Selector="Border.issueBadge.warning">
      <Setter Property="Background" Value="{DynamicResource Brush.Notice.Warning}" />
    </Style>
    <Style Selector="Button.preset">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- Toolbar: what the matrix shows, adding devices, the layout checks, and the zoom -->
    <Border DockPanel.Dock="Top" MinHeight="52" Padding="14,4,8,4" Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <controls:StrokeIcon Data="{StaticResource Icon.DeviceMatrix}" Size="18" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="header" Text="Device Matrix" />
            <TextBlock Classes="muted small" Text="{Binding SummaryText}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Theme="{StaticResource SecondaryButton}" x:Name="AddDeviceButton" ToolTip.Tip="Add a virtual device">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:StrokeIcon Data="{StaticResource Icon.Plus}" Size="14" />
              <TextBlock Text="Add device" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="300" Spacing="6" Margin="4">
                  <TextBlock Classes="label" Text="Portrait" />
                  <ItemsControl ItemsSource="{Binding PortraitPresets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="swarm:DevicePreset">
                        <Button Theme="{StaticResource ToolButton}" Classes="preset"
                                Command="{Binding #Root.((vm:DeviceMatrixViewModel)DataContext).AddDeviceCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding SizeText}" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="label" Text="Landscape" Margin="0,4,0,0" />
                  <ItemsControl ItemsSource="{Binding LandscapePresets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="swarm:DevicePreset">
                        <Button Theme="{StaticResource ToolButton}" Classes="preset"
                                Command="{Binding #Root.((vm:DeviceMatrixViewModel)DataContext).AddDeviceCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding SizeText}" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,4" />
                  <TextBlock Classes="label" Text="Custom size, in device-independent pixels" />
                  <Grid ColumnDefinitions="*,Auto,*">
                    <TextBox Text="{Binding CustomWidth}" Watermark="Width" />
                    <TextBlock Grid.Column="1" Text="×" Margin="8,0" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="2" Text="{Binding CustomHeight}" Watermark="Height" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding CustomName}" Watermark="Name (optional)" />
                    <Button Grid.Column="1" Theme="{StaticResource AccentButton}" Margin="8,0,0,0" Content="Add" Command="{Binding AddCustomDeviceCommand}" />
                  </Grid>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Check the layout of every screen again" Command="{Binding CheckLayoutCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="14" />
              <TextBlock Text="Check layout" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Layout checks">
            <controls:StrokeIcon Data="{StaticResource Icon.LayoutCheck}" Size="16" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="360" Spacing="2" Margin="4">
                  <TextBlock Classes="header" Text="Layout checks" Margin="0,0,0,2" />
                  <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="0,0,0,8"
                             Text="Run on every screen after each start of the app. Findings go to the Error List." />
                  <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:LayoutRuleViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="mono small" Text="{Binding Code}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" OnContent="" OffContent="" Margin="8,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Border Classes="toolbarSeparator" />
          <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Zoom out" Command="{Binding ZoomOutCommand}">
            <controls:StrokeIcon Data="{StaticResource Icon.ZoomOut}" Size="16" />
          </Button>
          <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Real size" Command="{Binding ResetZoomCommand}" MinWidth="58">
            <TextBlock Text="{Binding ZoomText}" FontSize="{DynamicResource Type.Body}" />
          </Button>
          <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Zoom in" Command="{Binding ZoomInCommand}">
            <controls:StrokeIcon Data="{StaticResource Icon.ZoomIn}" Size="16" />
          </Button>
          <Button Theme="{StaticResource ToolButton}" x:Name="FitButton" ToolTip.Tip="Fit every screen">
            <controls:StrokeIcon Data="{StaticResource Icon.Fit}" Size="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The layout finding outlined in its tiles -->
    <Border DockPanel.Dock="Top" Classes="finding" Classes.warning="{Binding !IsShownFindingError}" IsVisible="{Binding HasShownFinding}" Padding="14,6,8,6"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="12" Height="12" CornerRadius="3" BorderThickness="2" BorderBrush="{DynamicResource Brush.Swarm.Highlight}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding ShownFindingText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="{DynamicResource Type.Body}" />
        <Button Grid.Column="2" Theme="{StaticResource ToolButton}" ToolTip.Tip="Stop outlining" Command="{Binding ClearFindingCommand}">
          <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="13" />
        </Button>
      </Grid>
    </Border>

    <Panel>
      <ScrollViewer x:Name="TilesScroller" HorizontalScrollBarVisibility="Auto">
        <ItemsControl x:Name="TilesList" ItemsSource="{Binding Tiles}" Margin="16,16,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ScreenTileViewModel">
              <Border Classes="tile" Classes.focused="{Binding IsFocused}">
                <StackPanel Spacing="10">
                  <!-- Header: the profile, and the layout issues found on it -->
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel VerticalAlignment="Top" Margin="0,2,10,0">
                      <controls:StrokeIcon Data="{StaticResource Icon.Phone}" Size="18" Foreground="{DynamicResource Brush.AccentText}" IsVisible="{Binding IsPhoneSized}" />
                      <controls:StrokeIcon Data="{StaticResource Icon.Tablet}" Size="18" Foreground="{DynamicResource Brush.AccentText}" IsVisible="{Binding !IsPhoneSized}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted small" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted small" Text="{Binding KindText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="issueBadge" Classes.error="{Binding HasErrors}" Classes.warning="{Binding HasWarningsOnly}"
                            ToolTip.Tip="Layout issues on this screen" Margin="8,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="13" Foreground="{DynamicResource Brush.Error}" IsVisible="{Binding HasErrors}" />
                        <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="13" Foreground="{DynamicResource Brush.Warning}" IsVisible="{Binding HasWarningsOnly}" />
                        <controls:StrokeIcon Data="{StaticResource Icon.Check}" Size="13" Foreground="{DynamicResource Brush.Success}" IsVisible="{Binding IsClean}" />
                        <TextBlock Classes="small" Text="{Binding IssuesText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Actions: a virtual device can be changed; any screen can be shown at full size -->
                  <StackPanel Orientation="Horizontal">
                    <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Rotate" Command="{Binding RotateCommand}" IsVisible="{Binding IsVirtual}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Rotate}" Size="17" />
                    </Button>
                    <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Dark theme" Classes.selected="{Binding IsDark}" Command="{Binding ToggleThemeCommand}" IsVisible="{Binding IsVirtual}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Theme}" Size="16" />
                    </Button>
                    <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Right to left" Classes.selected="{Binding IsRightToLeft}" Command="{Binding ToggleDirectionCommand}" IsVisible="{Binding IsVirtual}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Direction}" Size="17" />
                    </Button>
                    <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Large text (130%)" Classes.selected="{Binding HasLargeText}" Command="{Binding ToggleFontScaleCommand}" IsVisible="{Binding IsVirtual}">
                      <controls:StrokeIcon Data="{StaticResource Icon.FontScale}" Size="17" />
                    </Button>
                    <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Full size" Command="{Binding ShowFullSizeCommand}">
                      <controls:StrokeIcon Data="{StaticResource Icon.FullSize}" Size="16" />
                    </Button>
                    <Button Theme="{StaticResource ToolButton}" ToolTip.Tip="Remove this device" Command="{Binding RemoveCommand}" IsVisible="{Binding IsVirtual}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="14" />
                    </Button>
                  </StackPanel>

                  <!-- The screen, in a device's bezel -->
                  <Border Classes="bezel">
                    <Panel>
                      <views:ScreenTileContent Tile="{Binding}" />
                      <Border IsVisible="{Binding HasStatus}" Background="{DynamicResource Brush.Window}">
                        <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
                      </Border>
                      <!-- A short notice, such as a tap mirrored from another screen that found no element here. -->
                      <Border Theme="{StaticResource SwarmNotice}" Margin="8,0,8,10" Padding="10,7" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                              IsVisible="{Binding HasNotice}">
                        <Grid ColumnDefinitions="Auto,*">
                          <controls:StrokeIcon Data="{StaticResource Icon.Info}" Size="13" Margin="0,1,7,0" Foreground="{DynamicResource Brush.Info}" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Classes="small" Foreground="{DynamicResource Brush.TextBright}" TextWrapping="Wrap" Text="{Binding Notice}" />
                        </Grid>
                      </Border>
                    </Panel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- One screen at full size, over the others -->
      <DockPanel x:Name="FullSizePanel" IsVisible="{Binding IsFullSize}" Background="{DynamicResource Brush.Window}">
        <Border DockPanel.Dock="Top" MinHeight="52" Padding="14,4,8,4" Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Panel VerticalAlignment="Center" Margin="0,0,10,0">
              <controls:StrokeIcon Data="{StaticResource Icon.Phone}" Size="18" Foreground="{DynamicResource Brush.AccentText}" IsVisible="{Binding FullSizeTile.IsPhoneSized, FallbackValue=False}" />
              <controls:StrokeIcon Data="{StaticResource Icon.Tablet}" Size="18" Foreground="{DynamicResource Brush.AccentText}" IsVisible="{Binding !FullSizeTile.IsPhoneSized, FallbackValue=False}" />
            </Panel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="header" Text="{Binding FullSizeTile.Title, FallbackValue={x:Null}}" />
              <TextBlock Classes="muted small" Text="{Binding FullSizeTile.Details, FallbackValue={x:Null}}" />
            </StackPanel>
            <Button Grid.Column="2" Theme="{StaticResource ToolButton}" ToolTip.Tip="Back to every screen (Esc)" Command="{Binding CloseFullSizeCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="13" />
                <TextBlock Text="Close" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <ScrollViewer x:Name="FullSizeScroller" HorizontalScrollBarVisibility="Auto">
          <Border Classes="bezel" Margin="24" VerticalAlignment="Top">
            <views:ScreenTileContent x:Name="FullSizeContent" Tile="{Binding FullSizeTile}" Zoom="1" />
          </Border>
        </ScrollViewer>
      </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>
