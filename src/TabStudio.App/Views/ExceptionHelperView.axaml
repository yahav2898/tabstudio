<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.ExceptionHelperView"
             x:DataType="vm:ExceptionHelperViewModel">
  <!-- Visual Studio's exception helper: shown at the line that threw an unhandled exception. -->
  <Border Width="480" IsVisible="{Binding IsOpen}" Margin="0,4,0,0"
          Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.Error}" BorderThickness="1"
          CornerRadius="8" ClipToBounds="True" BoxShadow="{DynamicResource Shadow.Dialog}">
    <DockPanel>
      <!-- Header -->
      <Border DockPanel.Dock="Top" MinHeight="38" Background="{DynamicResource Brush.ExceptionHeader}" Padding="12,0,4,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="17" Foreground="{DynamicResource Brush.Error}" />
          <TextBlock Grid.Column="1" Classes="h2" Text="Exception Unhandled" Margin="9,0,0,0" VerticalAlignment="Center" />
          <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Padding="0"
                  ToolTip.Tip="Close" Command="{Binding CloseCommand}">
            <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="12" />
          </Button>
        </Grid>
      </Border>

      <!-- Actions -->
      <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <Button Theme="{StaticResource ToolButton}" Padding="8,0" Command="{Binding ToggleDetailsCommand}">
            <TextBlock Classes="link" FontSize="{DynamicResource Type.Body}" Text="View Details" />
          </Button>
          <Button x:Name="CopyDetails" Grid.Column="1" Theme="{StaticResource ToolButton}" Padding="8,0">
            <TextBlock Classes="link" FontSize="{DynamicResource Type.Body}" Text="Copy Details" />
          </Button>
          <Button Grid.Column="3" Theme="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,8,0"
                  Content="Stop Debugging" Command="{Binding StopCommand}" />
          <Button Grid.Column="4" Theme="{StaticResource AccentButton}" Padding="14,0"
                  Content="Continue" ToolTip.Tip="Continue (F5): the program ends with this exception"
                  Command="{Binding ContinueCommand}" />
        </Grid>
      </Border>

      <StackPanel Margin="14,12,14,10" Spacing="6">
        <TextBlock Text="{Binding ExceptionType}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}"
                   TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding QuotedMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
        <Border IsVisible="{Binding IsDetailsVisible}" Margin="0,6,0,0" Padding="10,8" CornerRadius="6"
                Background="{DynamicResource Brush.Window}">
          <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock Text="{Binding Details}" FontFamily="{DynamicResource CodeFont}" FontSize="{DynamicResource Type.Small}"
                                 TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
          </ScrollViewer>
        </Border>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
