<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabStudio.App.ViewModels"
             xmlns:svd="using:TabStudio.Toolchains.Embedded.Peripherals"
             x:Class="TabStudio.App.Views.EmbeddedPeripheralsView"
             x:DataType="vm:WorkspaceViewModel">
  <!--
    One scrolling column: in the bottom panel's 200 pixels the device's buttons, pickers and snapshot took all the
    height, and the register's fields, with their header cut in half, got none. The buttons wrap on a narrow window.
  -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10,6" Spacing="6">
      <TextBlock Text="{Binding EmbeddedPeripheralDevice}" TextWrapping="Wrap" />
      <WrapPanel Orientation="Horizontal">
        <Button Margin="0,0,6,6" Content="Load SVD" Command="{Binding LoadEmbeddedSvdCommand}" />
        <Button Margin="0,0,6,6" Content="Read selected register" Command="{Binding ReadSelectedEmbeddedRegisterCommand}" />
        <Button Margin="0,0,6,6" Content="Edit field…" Command="{Binding EditSelectedEmbeddedRegisterCommand}" />
      </WrapPanel>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <ComboBox ItemsSource="{Binding EmbeddedPeripheralCatalog}" SelectedItem="{Binding SelectedEmbeddedPeripheral}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Device peripheral">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="svd:SvdPeripheral"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="1" ItemsSource="{Binding EmbeddedRegisterCatalog}" SelectedItem="{Binding SelectedEmbeddedRegister}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Device register">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="svd:SvdRegister"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
      <TextBlock Classes="muted small" Text="{Binding EmbeddedPeripheralDescription}" TextWrapping="Wrap" />
      <TextBlock Classes="small" Text="{Binding EmbeddedPeripheralSnapshot}" TextWrapping="Wrap" />
      <!-- The fields scroll sideways together with their header. -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel MinWidth="520">
          <Grid ColumnDefinitions="150,55,130,*" Margin="4,3,4,0">
            <TextBlock Text="Field" /><TextBlock Grid.Column="1" Text="Bits" /><TextBlock Grid.Column="2" Text="Value" /><TextBlock Grid.Column="3" Text="Description" />
          </Grid>
          <ItemsControl ItemsSource="{Binding EmbeddedRegisterFields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EmbeddedRegisterFieldRow">
                <Grid ColumnDefinitions="150,55,130,*" Margin="4,4">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Bits}" />
                  <TextBlock Grid.Column="2" Text="{Binding Value}" />
                  <TextBlock Grid.Column="3" Text="{Binding Description}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </StackPanel>
  </ScrollViewer>
</UserControl>
