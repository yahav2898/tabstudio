<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.DataTipView"
             x:DataType="vm:VariableTreeViewModel">
  <!-- A DataTip: the value under the pointer while the program is paused; tap a row to see its members. -->
  <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
          CornerRadius="6" Padding="2" BoxShadow="0 6 18 0 #59000000" MinWidth="160" MaxWidth="640">
    <ListBox x:Name="Rows" ItemsSource="{Binding Rows}" ItemContainerTheme="{StaticResource ListRow}" MaxHeight="320"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:VariableViewModel">
          <StackPanel Orientation="Horizontal" Height="30" Background="Transparent" ToolTip.Tip="{Binding Type}">
            <Border Width="{Binding IndentWidth}" />
            <Panel Width="18">
              <Panel IsVisible="{Binding IsExpandable}">
                <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="13"
                                     Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding !IsExpanded}" />
                <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="13"
                                     Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding IsExpanded}" />
              </Panel>
            </Panel>
            <TextBlock VerticalAlignment="Center" Margin="2,0,10,0" FontFamily="{DynamicResource CodeFont}" FontSize="12.5"
                       TextTrimming="CharacterEllipsis" MaxWidth="580">
              <Run Text="{Binding Name}" Foreground="{DynamicResource Brush.Link}" />
              <Run Text=" = " Foreground="{DynamicResource Brush.TextMuted}" />
              <Run Text="{Binding Value}" Foreground="{DynamicResource Brush.TextBright}" />
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Border>
</UserControl>
