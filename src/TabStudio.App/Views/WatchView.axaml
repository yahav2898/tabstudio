<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:views="using:TabStudio.App.Views"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.WatchView"
             x:DataType="vm:WatchViewModel">
  <DockPanel>
    <!-- Add item to watch -->
    <Border DockPanel.Dock="Bottom" Padding="10,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <controls:StrokeIcon Data="{StaticResource Icon.Watch}" Size="16" Margin="2,0,10,0"
                             Foreground="{DynamicResource Brush.AccentText}" />
        <TextBox x:Name="NewExpressionBox" Grid.Column="1" Classes="mono"
                 Watermark="Add item to watch, such as order.Items[0].Price"
                 Text="{Binding NewExpression}" />
        <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,0"
                Content="Add" Command="{Binding AddNewExpressionCommand}" />
      </Grid>
    </Border>
    <Panel>
      <views:VariableListView DataContext="{Binding Tree}" />
      <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,26,0,0"
                 Text="Watch a variable, member or item: type its path below."
                 IsVisible="{Binding !Tree.Rows.Count}" />
    </Panel>
  </DockPanel>
</UserControl>
