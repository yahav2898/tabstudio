<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:live="using:TabStudio.App.ViewModels.Live"
             x:Class="TabStudio.App.Views.Live.LivePanelView"
             x:DataType="live:LivePanelViewModel">

  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="MinWidth" Value="{DynamicResource Target.Size}" />
      <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{DynamicResource Type.Small}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextLabel}" />
    </Style>
    <Style Selector="Border.participant">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Brush.Control}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.participant.followed">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Border.participant.hand">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
    </Style>
    <Style Selector="Border.avatar">
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Border.avatar > TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Type.Small}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Title, whose session it is, and the session's commands. -->
    <Border DockPanel.Dock="Top" MinHeight="36" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0,2,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="header" Text="Live Share" />
          <Border Classes="pill success" IsVisible="{Binding IsHost}">
            <TextBlock Text="Sharing" />
          </Border>
          <Border Classes="pill ready" IsVisible="{Binding IsGuest}">
            <TextBlock Text="Joined" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Theme="{StaticResource ToolButton}" Classes="tool" ToolTip.Tip="Show the session's code" Command="{Binding ShareCommand}" IsVisible="{Binding IsHost}">
            <controls:StrokeIcon Data="{StaticResource Icon.Plus}" Size="15" />
          </Button>
          <Button Theme="{StaticResource ToolButton}" Classes="tool" ToolTip.Tip="More">
            <controls:StrokeIcon Data="{StaticResource Icon.More}" Size="15" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Share Session…" Command="{Binding ShareCommand}" IsVisible="{Binding !IsGuest}" />
                <MenuItem Header="Join Live Session…" Command="{Binding JoinCommand}" IsVisible="{Binding IsOff}" />
                <Separator IsVisible="{Binding IsInSession}" />
                <MenuItem Header="End the Session" Command="{Binding EndCommand}" IsVisible="{Binding IsHost}" />
                <MenuItem Header="Leave the Session" Command="{Binding EndCommand}" IsVisible="{Binding IsGuest}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12" Spacing="12">

        <!-- No session: what Live Share is, and how to start or join one. -->
        <Border Padding="16,14" CornerRadius="10" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                IsVisible="{Binding IsOff}">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:StrokeIcon Data="{StaticResource Icon.Live}" Size="20" Foreground="{DynamicResource Brush.AccentText}" />
              <TextBlock Classes="h2" Text="Code together on this Wi-Fi" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Share this workspace and other devices with TabStudio join by a scan: everyone types in the same files at once, sees each other's carets, and follows this device's run and debugging. No account, no cloud and no internet; the connection is end-to-end encrypted." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Theme="{StaticResource AccentButton}" Padding="16,0" Command="{Binding ShareCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:StrokeIcon Data="{StaticResource Icon.Live}" Size="14" />
                  <TextBlock Text="Share session" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Theme="{StaticResource SecondaryButton}" Padding="16,0" Content="Join a session" Command="{Binding JoinCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- The session: its name, and for the host what guests may do. -->
        <StackPanel Spacing="8" IsVisible="{Binding IsInSession}">
          <TextBlock Classes="muted small" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          <Border Padding="12,10" CornerRadius="8" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  IsVisible="{Binding IsHost}">
            <StackPanel Spacing="4">
              <CheckBox Content="Guests can edit" IsChecked="{Binding GuestsCanEdit}"
                        ToolTip.Tip="Off, guests who join only watch; each guest's role can still be changed below" />
              <CheckBox Content="Classroom: everyone follows the presenter" IsChecked="{Binding IsClassroom}" />
              <CheckBox Content="Let no one else join" IsChecked="{Binding IsLocked}" />
              <Button Theme="{StaticResource SecondaryButton}" Padding="16,0" HorizontalAlignment="Left" Margin="0,4,0,0"
                      Content="Take control back" Command="{Binding TakeControlCommand}" IsVisible="{Binding IsClassroom}" />
            </StackPanel>
          </Border>

          <!-- A guest: raise a hand, follow the presenter. -->
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsGuest}">
            <Button Theme="{StaticResource SecondaryButton}" Padding="14,0" Command="{Binding ToggleHandCommand}"
                    ToolTip.Tip="Ask the host for attention, or for control in a class">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:StrokeIcon Data="{StaticResource Icon.Hand}" Size="15" />
                <TextBlock Text="{Binding HandText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource SecondaryButton}" Padding="14,0" Command="{Binding FollowPresenterCommand}"
                    IsVisible="{Binding IsInClass}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:StrokeIcon Data="{StaticResource Icon.Follow}" Size="15" />
                <TextBlock Text="Follow the presenter" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding IsViewer}"
                     Text="You watch this session: the host has not let you edit." />

          <TextBlock Classes="section" Text="Participants" Margin="0,4,0,0" />
          <ItemsControl ItemsSource="{Binding Participants}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="live:LiveParticipantRowViewModel">
                <Border Classes="participant" Classes.followed="{Binding IsFollowed}" Classes.hand="{Binding HandRaised}" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Classes="avatar" Background="{Binding Avatar.Background}" Margin="0,0,10,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Avatar.Initials}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <controls:StrokeIcon Grid.Column="1" Data="{StaticResource Icon.Hand}" Size="14" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Warning}" IsVisible="{Binding HandRaised}" VerticalAlignment="Center" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="pill" VerticalAlignment="Center">
                          <TextBlock Text="{Binding RoleText}" />
                        </Border>
                        <TextBlock Grid.Column="1" Classes="muted small" Margin="6,0,0,0" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding HasDetail}" />
                      </Grid>
                    </StackPanel>
                    <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Padding="12,0" Margin="8,0,0,0"
                            VerticalAlignment="Center" Command="{Binding FollowCommand}" IsVisible="{Binding CanFollow}"
                            ToolTip.Tip="Show what they show: their file, where they are and how far they scrolled">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StrokeIcon Data="{StaticResource Icon.Follow}" Size="14" />
                        <TextBlock Text="{Binding FollowText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Theme="{StaticResource ToolButton}" Padding="0" Margin="4,0,0,0"
                            VerticalAlignment="Center" IsVisible="{Binding CanManage}" ToolTip.Tip="What they may do">
                      <controls:StrokeIcon Data="{StaticResource Icon.More}" Size="15" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="Let Them Edit" Command="{Binding MakeEditorCommand}" />
                          <MenuItem Header="Let Them Only Watch" Command="{Binding MakeViewerCommand}" />
                          <MenuItem Header="{Binding SteppingText}" Command="{Binding ToggleSteppingCommand}" />
                          <MenuItem Header="{Binding TerminalText}" Command="{Binding ToggleTerminalCommand}" />
                          <MenuItem Header="Hand Them Control" Command="{Binding HandControlCommand}" IsVisible="{Binding CanHandControl}" />
                          <MenuItem Header="Lower Their Hand" Command="{Binding LowerHandCommand}" IsVisible="{Binding HandRaised}" />
                          <Separator />
                          <MenuItem Header="Remove from the Session" Command="{Binding RemoveCommand}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Theme="{StaticResource SecondaryButton}" Padding="16,0" Content="End the session" Command="{Binding EndCommand}" IsVisible="{Binding IsHost}" />
            <Button Theme="{StaticResource SecondaryButton}" Padding="16,0" Content="Leave the session" Command="{Binding EndCommand}" IsVisible="{Binding IsGuest}" />
          </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*">
          <controls:StrokeIcon Data="{StaticResource Icon.Lock}" Size="15" Margin="0,2,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.AccentText}" />
          <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap"
                     Text="Guests see only the shared workspace, over a connection encrypted end to end. The host decides who edits, who steps the debugger and who types in the Terminal, and can remove anyone at any time." />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
