<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:live="using:TabStudio.App.ViewModels.Live"
             x:Class="TabStudio.App.Views.Live.LiveJoinView"
             x:DataType="live:LiveJoinViewModel"
             IsVisible="{Binding IsOpen, FallbackValue=False}">

  <!-- Join Live Session: scan or type another device's session code, drawn over the start screen or the IDE. -->
  <Panel Background="{DynamicResource Brush.Scrim}">
    <Border MaxWidth="640" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12"
            Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
            BoxShadow="{DynamicResource Shadow.Dialog}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="22,18,14,14">
          <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
            <controls:StrokeIcon Data="{StaticResource Icon.Live}" Size="18" Foreground="{DynamicResource Brush.AccentText}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="h2" FontSize="{DynamicResource Type.Subtitle}" Text="Join a Live session" />
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="Edit another device's workspace with it, in real time, over this Wi-Fi. Its files are copied here for IntelliSense and deleted when the session ends." />
          </StackPanel>
          <Button Grid.Column="2" Theme="{StaticResource ToolButton}" VerticalAlignment="Top" Command="{Binding CancelCommand}" ToolTip.Tip="Close">
            <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="16" />
          </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Divider}" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="22,10,16,12">
          <TextBlock Classes="muted small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DeviceText}" />
          <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Padding="20,0" Content="Cancel" Command="{Binding CancelCommand}" />
        </Grid>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Brush.Divider}" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
          <StackPanel Margin="22,18" Spacing="12">
            <TextBlock Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="On the other device, choose File > Share Session. Both devices must be on the same Wi-Fi." />
            <Button Theme="{StaticResource AccentButton}" Height="44" Padding="18,0" HorizontalAlignment="Left"
                    Command="{Binding ScanCommand}" IsVisible="{Binding CanScan}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:StrokeIcon Data="{StaticResource Icon.Camera}" Size="16" />
                <TextBlock Text="Scan the session's code" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Or type the address and the code it shows under the QR code:" />
            <!-- The address and the code in one row on a tablet, the code under the address on a phone (see the code-behind). -->
            <Grid x:Name="JoinGrid" ColumnDefinitions="*,12,190" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock x:Name="AddressLabel" Classes="label" Text="Address" Margin="2,0,0,6" />
              <TextBlock x:Name="CodeLabel" Grid.Column="2" Classes="label" Text="Code" Margin="2,0,0,6" />
              <TextBox x:Name="AddressBox" Grid.Row="1" Classes="large mono" Watermark="192.168.1.23" Text="{Binding AddressText}" />
              <TextBox x:Name="CodeBox" Grid.Row="1" Grid.Column="2" Classes="large mono" Watermark="XXXX-XXXX" MaxLength="10" Text="{Binding CodeText}" />
              <Button x:Name="JoinButton" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Theme="{StaticResource AccentButton}" Height="44" Padding="22,0" HorizontalAlignment="Left" Command="{Binding JoinCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:StrokeIcon Data="{StaticResource Icon.Live}" Size="16" />
                  <TextBlock Text="Join the session" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsBusy}">
              <ProgressBar IsIndeterminate="True" Width="96" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="muted" TextWrapping="Wrap" Text="{Binding ProgressText}" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <controls:StrokeIcon Data="{StaticResource Icon.Lock}" Size="15" Margin="0,2,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.AccentText}" />
              <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap"
                         Text="The code proves it is the right device; then everything is encrypted end to end. No account and no cloud." />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
