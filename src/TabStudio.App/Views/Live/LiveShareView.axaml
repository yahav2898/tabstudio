<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:live="using:TabStudio.App.ViewModels.Live"
             x:Class="TabStudio.App.Views.Live.LiveShareView"
             x:DataType="live:LivePanelViewModel"
             IsVisible="{Binding IsShareOpen, FallbackValue=False}">

  <!-- Share Session: the QR code another TabStudio scans to join, drawn over the IDE. -->
  <Panel Background="{DynamicResource Brush.Scrim}">
    <Border MaxWidth="720" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12"
            Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
            BoxShadow="{DynamicResource Shadow.Dialog}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="22,18,14,14">
          <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
            <controls:StrokeIcon Data="{StaticResource Icon.Live}" Size="18" Foreground="{DynamicResource Brush.AccentText}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="h2" FontSize="{DynamicResource Type.Subtitle}" Text="Share this session" />
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="Another tablet or phone with TabStudio joins over this Wi-Fi and edits with you in real time. No cloud and no account; the connection is end-to-end encrypted." />
          </StackPanel>
          <Button Grid.Column="2" Theme="{StaticResource ToolButton}" VerticalAlignment="Top" Command="{Binding CloseShareCommand}" ToolTip.Tip="Close">
            <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="16" />
          </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Divider}" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="22,10,16,12">
          <TextBlock Classes="muted small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
          <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Padding="20,0" Content="Done" Command="{Binding CloseShareCommand}" />
        </Grid>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Brush.Divider}" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
          <StackPanel Margin="22,18" Spacing="14">
            <TextBlock Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- The QR code beside its instructions, or above them on a narrow screen (see the code-behind). -->
            <Grid x:Name="CodeGrid" ColumnDefinitions="Auto,22,*" RowDefinitions="Auto,Auto" IsVisible="{Binding HasNetwork}">
              <Border Width="236" Height="236" CornerRadius="10" Background="{DynamicResource Brush.QrCode.Light}" VerticalAlignment="Top">
                <controls:QrCodeView Code="{Binding Code}" />
              </Border>
              <StackPanel x:Name="CodeText" Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="Scan this with TabStudio on the other device" TextWrapping="Wrap" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="On the other device: File > Join Live Session, or Join Live on the start screen, then Scan the session's code. Without a camera, type these instead:" />
                <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,6,Auto" Margin="0,4,0,0">
                  <TextBlock Classes="label" Text="Address" VerticalAlignment="Center" />
                  <SelectableTextBlock Grid.Column="2" FontFamily="{DynamicResource CodeFont}" FontSize="{DynamicResource Type.Title}" Foreground="{DynamicResource Brush.TextBright}" Text="{Binding AddressText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Classes="label" Text="Code" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <SelectableTextBlock FontFamily="{DynamicResource CodeFont}" FontSize="{DynamicResource Type.Display}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding CodeText}" VerticalAlignment="Center" />
                    <Button Theme="{StaticResource ToolButton}" Padding="10,0" Command="{Binding NewCodeCommand}" ToolTip.Tip="Draw a new code; the shown one stops working for devices that have not joined">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="14" />
                        <TextBlock Text="New code" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="The code lets a whole class join, for ten minutes; five wrong tries draw a new one. Devices that joined rejoin by themselves after Wi-Fi drops." />
              </StackPanel>
            </Grid>

            <Border Padding="14,12" CornerRadius="8" Background="{DynamicResource Brush.Control}" IsVisible="{Binding !HasNetwork}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="16" Foreground="{DynamicResource Brush.Warning}" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="This device is not on a network another device can reach. Connect both to the same Wi-Fi." />
              </StackPanel>
            </Border>

            <!-- What guests may do, chosen before they join. -->
            <WrapPanel Orientation="Horizontal">
              <CheckBox Margin="0,0,16,0" Content="Guests can edit" IsChecked="{Binding GuestsCanEdit}" />
              <CheckBox Content="Classroom: everyone follows me" IsChecked="{Binding IsClassroom}" />
            </WrapPanel>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,8,Auto">
              <controls:StrokeIcon Data="{StaticResource Icon.Lock}" Size="15" Margin="0,2,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.AccentText}" />
              <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap"
                         Text="Only devices with this code join; each checks the other's certificate, and everything between them is encrypted with TLS. Guests see only this workspace." />
              <controls:StrokeIcon Grid.Row="2" Data="{StaticResource Icon.Warning}" Size="15" Margin="0,2,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Warning}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="small" TextWrapping="Wrap"
                         Text="Guests who edit change your files, and your program runs their code, so share the code only with people you trust." />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
