<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             xmlns:remote="using:TabStudio.Remote"
             x:Class="TabStudio.App.Views.RemoteExplorerView"
             x:DataType="vm:RemoteExplorerViewModel"
             Background="{DynamicResource Brush.Panel}">
  <!--
    Remote Explorer (SSH), a tool window as docs/design/README.md builds one: its header with Refresh and More; the hosts;
    the folder to open, with Open Folder, the one primary action; the forms that add a host, find in the remote files,
    set the server's build and run commands and import an SSH config, folded until needed; and the status.
  -->
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="MinWidth" Value="{DynamicResource Target.Size}" />
      <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <controls:PanelHeader DockPanel.Dock="Top" Title="Remote Explorer" Subtitle="SSH">
      <controls:PanelHeader.Actions>
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Theme="{StaticResource ToolButton}" Classes="icon" ToolTip.Tip="Refresh the remote folder" Command="{Binding RefreshCommand}">
            <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="16" />
          </Button>
          <Button Theme="{StaticResource ToolButton}" Classes="icon" ToolTip.Tip="More">
            <controls:StrokeIcon Data="{StaticResource Icon.Overflow}" Size="16" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Reload File from Server…" Command="{Binding ReloadFileCommand}" />
                <MenuItem Header="Disconnect" Command="{Binding DisconnectHostCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </controls:PanelHeader.Actions>
    </controls:PanelHeader>

    <!-- What Remote Explorer is doing, or its last message. -->
    <Border DockPanel.Dock="Bottom" MinHeight="34" Padding="12,6,6,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="small muted" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding !IsBusy}" />
        <controls:LoadingState IsInline="True" Message="{Binding Status}" IsVisible="{Binding IsBusy}" HorizontalAlignment="Left" />
        <Button Grid.Column="1" Theme="{StaticResource ToolButton}" Classes="action" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,8,0,12" Spacing="8">
        <TextBlock Classes="h2" Text="Hosts" Margin="12,0" />
        <ListBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" ItemContainerTheme="{StaticResource ListRow}" MaxHeight="200"
                 IsVisible="{Binding HasHosts}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="remote:SshHost">
              <StackPanel Margin="12,6" Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <TextBlock Text="{Binding Address}" Classes="small muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Address}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <controls:EmptyState Icon="{StaticResource Icon.Remote}" Title="No hosts yet" IsCompact="True"
                             Message="Add a server below, or import your SSH config. TabStudio makes a key for this device to sign in with."
                             IsVisible="{Binding !HasHosts}" />

        <StackPanel Margin="12,8,12,0" Spacing="8">
          <TextBlock Classes="label" Text="Folder on the server" />
          <TextBox Text="{Binding RemoteFolder}" Classes="mono" Watermark="/home/user/project" AutomationProperties.Name="Folder on the server" />
          <Button Theme="{StaticResource AccentButton}" Classes="action" HorizontalAlignment="Left" Content="Open Folder" Command="{Binding OpenFolderCommand}" />
        </StackPanel>

        <Expander Header="Add or edit a host" IsExpanded="{Binding !HasHosts, Mode=OneWay}" Margin="12,8,12,0">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="Name" />
            <TextBox Text="{Binding Alias}" Watermark="Development server" AutomationProperties.Name="Name" />
            <TextBlock Classes="label" Text="Host name or IP address" />
            <TextBox Text="{Binding HostName}" Watermark="dev.example.com" AutomationProperties.Name="Host name or IP address" />
            <Grid ColumnDefinitions="*,88" ColumnSpacing="8">
              <StackPanel Spacing="8">
                <TextBlock Classes="label" Text="User" />
                <TextBox Text="{Binding User}" Watermark="deploy" AutomationProperties.Name="User" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Classes="label" Text="Port" />
                <TextBox Text="{Binding Port}" Watermark="22" AutomationProperties.Name="Port" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="label" Text="Identity file (optional)" />
            <TextBox Text="{Binding IdentityFile}" Classes="mono" Watermark="~/.ssh/id_ed25519" AutomationProperties.Name="Identity file" />
            <WrapPanel>
              <Button Theme="{StaticResource SecondaryButton}" Classes="action" Content="Save Host" Command="{Binding SaveHostCommand}" Margin="0,0,8,8" />
              <Button Theme="{StaticResource SecondaryButton}" Classes="action" Content="Make a Device Key" Command="{Binding GenerateKeyCommand}" Margin="0,0,8,8" />
              <Button Theme="{StaticResource SecondaryButton}" Classes="action" Content="Remove Host" Command="{Binding RemoveHostCommand}" Margin="0,0,0,8"
                      ToolTip.Tip="Removes the selected host and forgets its server key" />
            </WrapPanel>
            <Border Padding="10,8" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Control}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" IsVisible="{Binding HasPublicKey}">
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock Text="{Binding PublicKey}" TextWrapping="Wrap" FontFamily="{DynamicResource CodeFont}" FontSize="{DynamicResource Type.Caption}"
                                     MaxHeight="110" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource ToolButton}" Classes="icon" ToolTip.Tip="Copy the public key" Click="CopyPublicKey"
                        VerticalAlignment="Top" Margin="8,0,0,0">
                  <controls:StrokeIcon Data="{StaticResource Icon.Copy}" Size="16" />
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </Expander>

        <Expander Header="Find in remote files" Margin="12,0">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding SearchQuery}" Watermark="Find in the source cache" AutomationProperties.Name="Find in remote files" />
              <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Classes="action" Content="Find All" Command="{Binding SearchFilesCommand}" />
            </Grid>
            <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}" ItemContainerTheme="{StaticResource ListRow}" MaxHeight="220">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="remote:RemoteSearchHit">
                  <StackPanel Margin="8,6" Spacing="2">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                    <TextBlock Text="{Binding Preview}" Classes="small muted mono" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Preview}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Theme="{StaticResource SecondaryButton}" Classes="action" HorizontalAlignment="Left" Content="Open Match" Command="{Binding OpenResultCommand}" />
          </StackPanel>
        </Expander>

        <Expander Header="Build and run on the server" Margin="12,0">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="Build command" />
            <TextBox Text="{Binding BuildScript}" Classes="mono" AcceptsReturn="True" MinHeight="60" AutomationProperties.Name="Build command" />
            <TextBlock Classes="label" Text="Run command (F5)" />
            <TextBox Text="{Binding RunScript}" Classes="mono" AcceptsReturn="True" MinHeight="60" AutomationProperties.Name="Run command" />
            <Button Theme="{StaticResource SecondaryButton}" Classes="action" HorizontalAlignment="Left" Content="Save Run Configuration" Command="{Binding SaveProfileCommand}" />
            <TextBlock Classes="label" Text="Web port to forward" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="88,*" ColumnSpacing="8">
              <TextBox Text="{Binding PreviewPort}" AutomationProperties.Name="Web port to forward" />
              <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Classes="action" HorizontalAlignment="Left" Content="Open in Preview" Command="{Binding ForwardCommand}" />
            </Grid>
          </StackPanel>
        </Expander>

        <Expander Header="Import an SSH config" Margin="12,0">
          <StackPanel Spacing="8">
            <TextBlock Classes="small muted" TextWrapping="Wrap" Text="Paste a config, or leave it empty to read this device's ~/.ssh/config." />
            <TextBox Text="{Binding ConfigText}" Classes="mono" AcceptsReturn="True" MinHeight="100" AutomationProperties.Name="SSH config"
                     Watermark="Host development&#10;  HostName server.example.com&#10;  User deploy" />
            <Button Theme="{StaticResource SecondaryButton}" Classes="action" HorizontalAlignment="Left" Content="Import Hosts" Command="{Binding ImportConfigCommand}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
