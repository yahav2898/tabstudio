<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabStudio.App.ViewModels"
             xmlns:remote="using:TabStudio.Remote"
             x:Class="TabStudio.App.Views.RemoteExplorerView"
             x:DataType="vm:RemoteExplorerViewModel">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource Brush.Panel}">
    <Border Padding="16,12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <TextBlock Text="REMOTE EXPLORER" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Text="Develop on a server over SSH" FontSize="12" Opacity="0.7" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="SSH hosts" FontWeight="SemiBold" />
        <ListBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" MinHeight="72" MaxHeight="160">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="remote:SshHost"><StackPanel Margin="2,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding DisplayName}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Expander Header="Add or edit host" IsExpanded="True" HorizontalAlignment="Stretch">
          <StackPanel Spacing="7" Margin="0,8,0,0">
            <TextBox Text="{Binding Alias}" Watermark="Alias, e.g. development" />
            <TextBox Text="{Binding HostName}" Watermark="Host name or IP address" />
            <Grid ColumnDefinitions="*,80"><TextBox Text="{Binding User}" Watermark="SSH user" Margin="0,0,6,0" /><TextBox Grid.Column="1" Text="{Binding Port}" Watermark="22" /></Grid>
            <TextBox Text="{Binding IdentityFile}" Watermark="IdentityFile (optional)" />
            <WrapPanel Orientation="Horizontal"><Button Content="Save host" Command="{Binding SaveHostCommand}" Margin="0,0,6,6" /><Button Content="Generate device key" Command="{Binding GenerateKeyCommand}" Margin="0,0,0,6" /></WrapPanel>
            <SelectableTextBlock Text="{Binding PublicKey}" TextWrapping="Wrap" FontSize="11" MaxHeight="110" />
          </StackPanel>
        </Expander>
        <TextBlock Text="Remote folder" FontWeight="SemiBold" />
        <TextBox Text="{Binding RemoteFolder}" Watermark="/home/user/project" />
        <WrapPanel><Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,6" /><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,6" /><Button Content="Disconnect" Command="{Binding DisconnectHostCommand}" Margin="0,0,0,6" /></WrapPanel>
        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" HorizontalAlignment="Left" />
        <Expander Header="Find in remote files" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBox Text="{Binding SearchQuery}" Watermark="Find text in the source cache" />
            <Button Content="Find all" Command="{Binding SearchFilesCommand}" />
            <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}" MaxHeight="220">
              <ListBox.ItemTemplate><DataTemplate x:DataType="remote:RemoteSearchHit"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Open match" Command="{Binding OpenResultCommand}" />
          </StackPanel>
        </Expander>
        <Expander Header="Run and build on host" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Build command" FontSize="12" /><TextBox Text="{Binding BuildScript}" AcceptsReturn="True" MinHeight="60" />
            <TextBlock Text="Run command (F5)" FontSize="12" /><TextBox Text="{Binding RunScript}" AcceptsReturn="True" MinHeight="60" />
            <Button Content="Save run configuration" Command="{Binding SaveProfileCommand}" />
            <TextBlock Text="Forward a remote web port" FontSize="12" />
            <Grid ColumnDefinitions="80,*"><TextBox Text="{Binding PreviewPort}" Margin="0,0,6,0" /><Button Grid.Column="1" Content="Open in preview" Command="{Binding ForwardCommand}" /></Grid>
          </StackPanel>
        </Expander>
        <Expander Header="Import ~/.ssh/config" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="Paste a config, or leave blank to read this device's ~/.ssh/config." TextWrapping="Wrap" FontSize="12" />
            <TextBox Text="{Binding ConfigText}" AcceptsReturn="True" MinHeight="100" Watermark="Host development&#10;  HostName server.example.com&#10;  User deploy" />
            <Button Content="Import hosts" Command="{Binding ImportConfigCommand}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
