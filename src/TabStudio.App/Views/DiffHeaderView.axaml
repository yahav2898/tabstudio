<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.DiffHeaderView"
             x:DataType="vm:FileComparison">

  <!-- Above a comparison: which file, which versions, and how many lines were added and removed. -->
  <Border Height="32" Padding="12,0" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <controls:StrokeIcon Data="{StaticResource Icon.Commit}" Size="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextMuted}" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5">
        <Run Text="{Binding RelativePath}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" />
        <Run Text="   Unmodified (" Foreground="{DynamicResource Brush.TextMuted}" />
        <Run Text="{Binding BaseLabel}" Foreground="{DynamicResource Brush.TextSecondary}" />
        <Run Text=") vs. working copy" Foreground="{DynamicResource Brush.TextMuted}" />
      </TextBlock>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0">
        <TextBlock Text="{Binding Diff.AddedCount, StringFormat='+{0}'}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Success}" />
        <TextBlock Text="{Binding Diff.RemovedCount, StringFormat='−{0}'}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Error}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
