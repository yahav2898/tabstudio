<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels"
             x:Class="TabStudio.App.Views.DiffHeaderView"
             x:DataType="vm:FileComparison">

  <!-- Above a comparison: which file, which versions, how many lines changed, and buttons to go from change to change. -->
  <Border Height="36" Padding="12,0,4,0" Background="{DynamicResource Brush.Toolbar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
      <controls:StrokeIcon Data="{StaticResource Icon.Commit}" Size="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.TextMuted}" />
      <!-- Runs on one line: whitespace between them would show as spaces. -->
      <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource Type.Body}"><Run
        Text="{Binding RelativePath}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}" /><Run
        Text="{Binding BaseName, Mode=OneWay, StringFormat='    {0} ('}" Foreground="{DynamicResource Brush.TextMuted}" /><Run
        Text="{Binding BaseLabel}" Foreground="{DynamicResource Brush.TextSecondary}" /><Run
        Text="{Binding HeadName, Mode=OneWay, StringFormat=') vs. {0}'}" Foreground="{DynamicResource Brush.TextMuted}" /></TextBlock>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="12,0,8,0">
        <TextBlock Text="{Binding Diff.AddedCount, StringFormat='+{0}'}" FontSize="{DynamicResource Type.Body}" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Success}" />
        <TextBlock Text="{Binding Diff.RemovedCount, StringFormat='−{0}'}" FontSize="{DynamicResource Type.Body}" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Error}" />
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button Theme="{StaticResource ToolButton}" Width="34" Height="34" MinWidth="34" MinHeight="34" Padding="0"
                ToolTip.Tip="Previous Change (Shift+F8)" Click="OnPreviousClick">
          <controls:StrokeIcon Data="{StaticResource Icon.ChevronUp}" Size="15" />
        </Button>
        <Button Theme="{StaticResource ToolButton}" Width="34" Height="34" MinWidth="34" MinHeight="34" Padding="0"
                ToolTip.Tip="Next Change (F8)" Click="OnNextClick">
          <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Size="15" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
