<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:conv="using:TabStudio.App.Converters"
             xmlns:vm="using:TabStudio.App.ViewModels.Search"
             xmlns:sys="using:System"
             x:Class="TabStudio.App.Views.Search.UnifiedSearchView"
             x:DataType="vm:UnifiedSearchViewModel"
             IsVisible="{Binding IsOpen}">

  <!--
    One search for everything (Ctrl+Q): the query box, the scope chips, and the results in groups with their matched
    letters, locations and key gestures. Rows are 44 pixels high, the best match 52, so every result is a touch target.
  -->

  <UserControl.Styles>
    <Style Selector="TextBlock.searchGroup">
      <Setter Property="FontSize" Value="{DynamicResource Type.Fine}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
      <Setter Property="Margin" Value="12,12,12,4" />
    </Style>
    <Style Selector="Border.keycap">
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{DynamicResource Brush.Control}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="TextElement.FontSize" Value="{DynamicResource Type.Caption}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Grid.result.disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.scopeChip">
      <Setter Property="MinHeight" Value="{DynamicResource Target.Size}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Pill}" />
    </Style>
    <Style Selector="Button.scopeChip.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.scopeChip.selected">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- Tapping outside closes. -->
    <Border x:Name="Scrim" Background="{DynamicResource Brush.Extensions.Scrim}" />

    <Border x:Name="Card" MaxWidth="680" MaxHeight="620" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,48,16,16"
            CornerRadius="12" Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
            BoxShadow="{DynamicResource Shadow.Dialog}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,12,8,8">
          <TextBox x:Name="QueryBox" Classes="large" Text="{Binding Query}" Watermark="Search files, commands, settings, symbols and templates">
            <TextBox.InnerLeftContent>
              <controls:StrokeIcon Data="{StaticResource Icon.Search}" Size="16" Margin="12,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Panel Margin="0,0,10,0">
                <controls:StrokeIcon Classes="spinning" Data="{StaticResource Icon.Spinner}" Size="16" StrokeThickness="2.2"
                                     Foreground="{DynamicResource Brush.AccentText}" IsVisible="{Binding IsSearching}" />
                <Border Classes="keycap" IsVisible="{Binding !IsSearching}" VerticalAlignment="Center">
                  <TextBlock Text="Ctrl+Q" VerticalAlignment="Center" />
                </Border>
              </Panel>
            </TextBox.InnerRightContent>
          </TextBox>
          <Button Grid.Column="1" Theme="{StaticResource ToolButton}" Margin="4,0,0,0" Command="{Binding CloseCommand}"
                  ToolTip.Tip="Close (Esc)">
            <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="16" />
          </Button>
        </Grid>

        <!-- Scopes: everything, or one kind; ">" and "#" typed first choose Commands and Symbols. -->
        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="12,0,12,10">
          <ItemsControl ItemsSource="{Binding Scopes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SearchScopeChip">
                <Button Theme="{StaticResource ToolButton}" Classes="scopeChip" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].((vm:UnifiedSearchViewModel)DataContext).ChooseScopeCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CountText}" Classes="muted" FontSize="{DynamicResource Type.Fine}" VerticalAlignment="Center"
                               IsVisible="{Binding CountText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Divider}" />

        <Panel>
          <controls:EmptyState IsVisible="{Binding IsEmpty}" IsCompact="True" Margin="16,28,16,32"
                               Icon="{StaticResource Icon.Search}" Title="{Binding EmptyTitle}" Message="{Binding EmptyMessage}" />

          <ListBox x:Name="ResultList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Padding="6,0,6,6"
                   ItemContainerTheme="{StaticResource ListRow}" IsVisible="{Binding !IsEmpty}">
            <ListBox.DataTemplates>
              <DataTemplate DataType="vm:SearchResultRow">
                <StackPanel Background="Transparent">
                  <TextBlock Classes="searchGroup" Text="{Binding Group}" IsVisible="{Binding StartsGroup}" />
                  <Grid Classes="result" Classes.disabled="{Binding IsDisabled}" ColumnDefinitions="36,*,Auto"
                        MinHeight="44" Margin="6,0,10,0">
                    <Panel Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                      <controls:StrokeIcon Data="{Binding Item.IconKey, Converter={x:Static conv:ShellConverters.IconByKey}}" Size="18"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           IsVisible="{Binding !HasGlyph}" />
                      <controls:SymbolGlyphIcon Kind="{Binding Glyph}" Size="18" IsVisible="{Binding HasGlyph}" />
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,7" Spacing="1">
                      <controls:HighlightedText Text="{Binding Title}" Highlights="{Binding Highlights}" FontSize="{DynamicResource Type.Lead}"
                                                Foreground="{DynamicResource Brush.TextBright}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource Type.Small}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDetail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0">
                      <Border Classes="pill ready" IsVisible="{Binding HasNote}">
                        <TextBlock Text="{Binding Item.Note}" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding KindName}" Classes="muted" FontSize="{DynamicResource Type.Fine}" VerticalAlignment="Center" Margin="0,0,4,0"
                                 IsVisible="{Binding IsBestMatch}" />
                      <ItemsControl ItemsSource="{Binding Keys}" IsVisible="{Binding HasKeys}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="3" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sys:String">
                            <Border Classes="keycap">
                              <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="vm:SearchMoreRow">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="48,0,12,0" MinHeight="40" Background="Transparent">
                  <TextBlock Text="{Binding Text}" Classes="link" FontSize="{DynamicResource Type.Body}" VerticalAlignment="Center" />
                  <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Size="14" Foreground="{DynamicResource Brush.Link}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
