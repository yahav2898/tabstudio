<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:controls="using:TabStudio.App.Controls"
             xmlns:vm="using:TabStudio.App.ViewModels.Extensions"
             xmlns:views="using:TabStudio.App.Views.Extensions"
             x:Class="TabStudio.App.Views.Extensions.ExtensionsView"
             x:DataType="vm:ExtensionsViewModel"
             Background="{DynamicResource Brush.Window}">

  <UserControl.Resources>
    <!-- An extension in a list: icon, name, publisher, description, downloads, rating, and Install or its state. -->
    <DataTemplate x:Key="ExtensionRow" x:DataType="vm:ExtensionItemViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,10,10,10" Background="Transparent">
        <Panel Width="42" Height="42" VerticalAlignment="Top" Margin="0,1,12,0">
          <Border Classes="extensionIcon" Background="{Binding IconTint}" IsVisible="{Binding !HasIcon}">
            <TextBlock Text="{Binding Initials}" FontSize="{DynamicResource Type.Subtitle}" />
          </Border>
          <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Stretch="Uniform" />
        </Panel>

        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
          <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Type.Lead}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextBright}"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Publisher}" Classes="muted small" TextTrimming="CharacterEllipsis" />
            <controls:StrokeIcon Data="{StaticResource Icon.Verified}" Size="13" StrokeThickness="1.6"
                                 Foreground="{DynamicResource Brush.Extensions.Verified}" IsVisible="{Binding IsVerified}"
                                 ToolTip.Tip="The registry verified this publisher" />
            <Border Classes="pill" Height="18" IsVisible="{Binding IsDeprecated}">
              <TextBlock Text="Deprecated" FontSize="{DynamicResource Type.Micro}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Description}" Classes="muted small" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                     Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="7" Margin="10,0,0,0" VerticalAlignment="Top" MinWidth="76">
          <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right" IsVisible="{Binding HasStatistics}">
            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding DownloadsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="Downloads">
              <controls:StrokeIcon Data="{StaticResource Icon.Download}" Size="12" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Text="{Binding DownloadsText}" Classes="muted" FontSize="{DynamicResource Type.Fine}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasRating}" ToolTip.Tip="Average rating">
              <controls:StrokeIcon Data="{StaticResource Icon.Star}" Size="12" IsFilled="True" Foreground="{DynamicResource Brush.Extensions.Star}" />
              <TextBlock Text="{Binding RatingText}" Classes="muted" FontSize="{DynamicResource Type.Fine}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <Button Theme="{StaticResource AccentButton}" Classes="rowAction" HorizontalAlignment="Right" Content="Install"
                  Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
          <Button Theme="{StaticResource AccentButton}" Classes="rowAction" HorizontalAlignment="Right" Content="Update"
                  Command="{Binding UpdateCommand}" IsVisible="{Binding CanUpdate}" />
          <Border Classes="extensionState" IsVisible="{Binding HasState}">
            <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
          </Border>
          <ProgressBar Width="76" Height="4" MinHeight="4" HorizontalAlignment="Right" Minimum="0" Maximum="1"
                       Value="{Binding Progress}" IsVisible="{Binding IsBusy}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="Root" ColumnDefinitions="400,*">

    <!-- The lists -->
    <DockPanel x:Name="ListColumn" Background="{DynamicResource Brush.Extensions.ListBackground}">

      <!-- Browse, Installed, Updates, and the window's actions -->
      <Border DockPanel.Dock="Top" Height="44" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,0">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BrowseTab" Theme="{StaticResource PanelTabButton}" Content="Browse" Classes.selected="{Binding IsBrowseSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:ExtensionsTab.Browse}" />
            <Button x:Name="InstalledTab" Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsInstalledSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:ExtensionsTab.Installed}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Installed" VerticalAlignment="Center" />
                <Border Classes="pill" Height="18" IsVisible="{Binding HasInstalled}">
                  <TextBlock Text="{Binding InstalledCount}" FontSize="{DynamicResource Type.Micro}" />
                </Border>
              </StackPanel>
            </Button>
            <Button x:Name="UpdatesTab" Theme="{StaticResource PanelTabButton}" Classes.selected="{Binding IsUpdatesSelected}"
                    Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:ExtensionsTab.Updates}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Updates" VerticalAlignment="Center" />
                <Border Classes="pill ready" Height="18" IsVisible="{Binding HasUpdates}">
                  <TextBlock Text="{Binding UpdateCount}" FontSize="{DynamicResource Type.Micro}" />
                </Border>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Theme="{StaticResource ToolButton}" Classes="iconButton" ToolTip.Tip="Install from VSIX…" Command="{Binding InstallFromFileCommand}">
              <controls:StrokeIcon Data="{StaticResource Icon.Package}" Size="16" />
            </Button>
            <Button Theme="{StaticResource ToolButton}" Classes="iconButton" ToolTip.Tip="Check for Updates" Command="{Binding CheckForUpdatesCommand}">
              <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Size="16" />
            </Button>
            <Button Theme="{StaticResource ToolButton}" Classes="iconButton" Classes.selected="{Binding IsSettingsOpen}" ToolTip.Tip="Registry"
                    Command="{Binding ToggleSettingsCommand}">
              <controls:StrokeIcon Data="{StaticResource Icon.Gear}" Size="16" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Where extensions come from -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding IsSettingsOpen}" Padding="12,10,12,12"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Panel}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Registry" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Extensions come from this Open VSX server. Companies that run their own can use theirs." />
          <TextBox x:Name="RegistryBox" Classes="mono" Text="{Binding RegistryText}" />
          <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" Text="{Binding RegistryError}"
                     IsVisible="{Binding HasRegistryError}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Theme="{StaticResource SecondaryButton}" Padding="14,0" Content="Use open-vsx.org" Command="{Binding ResetRegistryCommand}" />
            <Button Theme="{StaticResource AccentButton}" Content="Use This Registry" Command="{Binding ApplyRegistryCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Search -->
      <Border DockPanel.Dock="Top" Padding="10,10,10,8">
        <TextBox x:Name="SearchBox" Text="{Binding SearchText}" Watermark="{Binding SearchWatermark}">
          <TextBox.InnerLeftContent>
            <controls:StrokeIcon Data="{StaticResource Icon.Search}" Size="15" Margin="10,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
          </TextBox.InnerLeftContent>
        </TextBox>
      </Border>

      <!-- Categories of Browse -->
      <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding IsBrowseSelected}">
        <ItemsControl ItemsSource="{Binding Categories}" Margin="10,0,10,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ExtensionCategoryViewModel">
              <Button Theme="{StaticResource ToolButton}" Classes="categoryChip" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                      Command="{Binding SelectCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- What the last action did -->
      <Border DockPanel.Dock="Top" Classes="extensionNotice" Classes.error="{Binding IsNoticeError}" Margin="10,0,10,8" IsVisible="{Binding HasNotice}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <controls:StrokeIcon Data="{StaticResource Icon.Check}" Size="15" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Success}"
                               IsVisible="{Binding !IsNoticeError}" />
          <controls:StrokeIcon Data="{StaticResource Icon.Error}" Size="15" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Error}"
                               IsVisible="{Binding IsNoticeError}" />
          <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"
                     Text="{Binding Notice}" />
          <Button Grid.Column="2" Theme="{StaticResource ToolButton}" Padding="10,0" FontSize="{DynamicResource Type.Body}"
                  Foreground="{DynamicResource Brush.Link}" Content="{Binding NoticeActionText}" Command="{Binding RunNoticeActionCommand}"
                  IsVisible="{Binding HasNoticeAction}" />
          <Button Grid.Column="3" Theme="{StaticResource ToolButton}" Classes="iconButton" ToolTip.Tip="Dismiss" Command="{Binding DismissNoticeCommand}">
            <controls:StrokeIcon Data="{StaticResource Icon.Close}" Size="12" />
          </Button>
        </Grid>
      </Border>

      <Panel>
        <!-- Browse -->
        <DockPanel IsVisible="{Binding IsBrowseSelected}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,0,14,4" MinHeight="22">
            <TextBlock Classes="section" Text="{Binding ResultsHeading}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" IsVisible="{Binding IsOffline}"
                        ToolTip.Tip="The registry cannot be reached; these are the results it gave last time.">
              <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="13" Foreground="{DynamicResource Brush.Warning}" />
              <TextBlock Classes="muted" FontSize="{DynamicResource Type.Fine}" Text="Offline: saved results" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Button DockPanel.Dock="Bottom" Theme="{StaticResource SecondaryButton}" Margin="10,6,10,10" HorizontalAlignment="Stretch"
                  Content="Load More" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" />
          <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" Margin="10,0" IsVisible="{Binding IsSearching}" />
          <Panel>
            <ListBox x:Name="BrowseList" ItemsSource="{Binding BrowseResults}" SelectedItem="{Binding SelectedBrowseItem}"
                     ItemContainerTheme="{StaticResource ListRow}" ItemTemplate="{StaticResource ExtensionRow}" />
            <StackPanel Spacing="10" Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding HasBrowseMessage}">
              <controls:StrokeIcon Data="{StaticResource Icon.Extensions}" Size="34" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Text="{Binding BrowseMessage}" />
              <Button Theme="{StaticResource SecondaryButton}" Padding="16,0" HorizontalAlignment="Center" Content="Try Again"
                      Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
            </StackPanel>
          </Panel>
        </DockPanel>

        <!-- Installed, with what cannot be used -->
        <DockPanel IsVisible="{Binding IsInstalledSelected}">
          <Border DockPanel.Dock="Top" Classes="extensionWarning" Margin="10,0,10,8" IsVisible="{Binding HasProblems}">
            <Grid ColumnDefinitions="Auto,*">
              <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Size="15" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Warning}" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Problems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <TextBlock Classes="small" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource Brush.Text}" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
          <Panel>
            <ListBox x:Name="InstalledList" ItemsSource="{Binding InstalledItems}" SelectedItem="{Binding SelectedInstalledItem}"
                     ItemContainerTheme="{StaticResource ListRow}" ItemTemplate="{StaticResource ExtensionRow}" />
            <StackPanel Spacing="10" Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding HasInstalledMessage}">
              <controls:StrokeIcon Data="{StaticResource Icon.Extensions}" Size="34" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Text="{Binding InstalledMessage}" />
              <Button Theme="{StaticResource SecondaryButton}" Padding="16,0" HorizontalAlignment="Center" Content="Install from VSIX…"
                      Command="{Binding InstallFromFileCommand}" IsVisible="{Binding !HasInstalled}" />
            </StackPanel>
          </Panel>
        </DockPanel>

        <!-- Updates -->
        <DockPanel IsVisible="{Binding IsUpdatesSelected}">
          <Button DockPanel.Dock="Top" Theme="{StaticResource AccentButton}" Margin="10,0,10,6" HorizontalAlignment="Stretch"
                  Content="Update All" Command="{Binding UpdateAllCommand}" IsVisible="{Binding HasUpdates}" />
          <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" Margin="10,0" IsVisible="{Binding IsCheckingUpdates}" />
          <Panel>
            <ListBox x:Name="UpdatesList" ItemsSource="{Binding UpdateItems}" SelectedItem="{Binding SelectedUpdateItem}"
                     ItemContainerTheme="{StaticResource ListRow}" ItemTemplate="{StaticResource ExtensionRow}" />
            <StackPanel Spacing="10" Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding !HasUpdates}">
              <controls:StrokeIcon Data="{StaticResource Icon.Check}" Size="30" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Text="{Binding UpdatesMessage}" />
            </StackPanel>
          </Panel>
        </DockPanel>
      </Panel>
    </DockPanel>

    <Border x:Name="ColumnDivider" Width="1" HorizontalAlignment="Right" Background="{DynamicResource Brush.Border}" />

    <!-- The selected extension -->
    <DockPanel x:Name="DetailsColumn" Grid.Column="1">
      <Border x:Name="BackBar" DockPanel.Dock="Top" Height="44" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" IsVisible="False">
        <Button Theme="{StaticResource ToolButton}" Padding="8,0" Margin="4,0" HorizontalAlignment="Left" Command="{Binding CloseDetailsCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:StrokeIcon Data="{StaticResource Icon.Back}" Size="16" />
            <TextBlock Text="Extensions" VerticalAlignment="Center" FontSize="{DynamicResource Type.Section}" />
          </StackPanel>
        </Button>
      </Border>
      <Panel>
        <Panel IsVisible="{Binding HasDetails}">
          <views:ExtensionDetailsView DataContext="{Binding Details}" />
        </Panel>
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasDetails}" Margin="24">
          <controls:StrokeIcon Data="{StaticResource Icon.Extensions}" Size="48" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
          <TextBlock Classes="h2" FontSize="{DynamicResource Type.Subtitle}" HorizontalAlignment="Center" Text="VS Code extensions from Open VSX" />
          <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"
                     Text="Languages, color themes, file icon themes and snippets work in TabStudio's editor. Select an extension to see what it adds." />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
