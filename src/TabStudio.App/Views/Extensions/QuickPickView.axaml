<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TabStudio.App.ViewModels.Extensions"
             x:Class="TabStudio.App.Views.Extensions.QuickPickView"
             x:DataType="vm:QuickPickViewModel"
             IsVisible="{Binding IsOpen}">

  <Panel>
    <!-- Tapping outside cancels. -->
    <Border x:Name="Scrim" Background="{DynamicResource Brush.Extensions.Scrim}" />

    <Border x:Name="Card" MaxWidth="580" MaxHeight="560" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,56,16,16" Padding="6"
            CornerRadius="10" Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderPopup}" BorderThickness="1"
            BoxShadow="{DynamicResource Shadow.Dialog}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8,6,8,8" Spacing="8">
          <TextBlock Classes="h2" FontSize="{DynamicResource Type.Large}" Text="{Binding Title}" />
          <TextBox x:Name="FilterBox" Height="40" Text="{Binding FilterText}" Watermark="{Binding Placeholder}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="12,8,12,12" Text="Nothing matches." IsVisible="{Binding IsEmpty}" />
        <ListBox x:Name="ItemList" Classes="quickPick" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 ItemContainerTheme="{StaticResource ListRow}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:QuickPickItem">
              <StackPanel Background="Transparent">
                <Border IsVisible="{Binding StartsGroup}" Margin="10,8,10,2" Padding="0,6,0,0"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
                  <TextBlock Text="{Binding Group}" Classes="section" FontSize="{DynamicResource Type.Caption}" />
                </Border>
                <StackPanel Margin="12,7,12,7" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Type.Lead}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Description}" Classes="muted small" VerticalAlignment="Center" IsVisible="{Binding HasDescription}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Detail}" Classes="muted small" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDetail}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
