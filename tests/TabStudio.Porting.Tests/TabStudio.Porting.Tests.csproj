<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TabStudio.Porting\TabStudio.Porting.csproj" />
    <ProjectReference Include="..\TabStudio.Testing\TabStudio.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The projects the converter is proven on, with the Avalonia projects it makes of them: Visual Studio's WPF and
    Windows Forms templates and two realistic apps. They are data for the tests, never compiled here.
  -->
  <ItemGroup>
    <Compile Remove="Samples\**" />
    <None Remove="Samples\**" />
    <None Include="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
