<Project Sdk="Microsoft.NET.Sdk">

  <!-- Helpers shared by every test project. Not a test project itself. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Answers recorded from open-vsx.org for the fake registry, and the real package of vscode.perl (VS Code's built-in
      Perl grammar, MIT licensed, see its LICENSE-vscode.txt) with its Open VSX signature.
    -->
    <EmbeddedResource Include="Extensions\Recorded\*" LogicalName="Recorded/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
