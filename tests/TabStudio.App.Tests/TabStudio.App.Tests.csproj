<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the IDE: services, view models, and the real views rendered headlessly with Skia.
    Screenshots of the rendered views are written to the folder in TABSTUDIO_SCREENSHOTS (CI publishes them).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <!--
      EF Core's design package brings Microsoft.Build.Framework 18.0.2. Utilities.Core, which OpenSilver's XAML compiler
      loads, must be at the same version, or its TaskItem does not implement the Framework's interfaces and WPF projects
      do not build in the tests.
    -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" VersionOverride="18.0.2" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" VersionOverride="3.119.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TabStudio.App\TabStudio.App.csproj" />
    <ProjectReference Include="..\..\src\TabStudio.WindowsBridge.Windows\TabStudio.WindowsBridge.Windows.csproj" />
    <ProjectReference Include="..\TabStudio.Testing\TabStudio.Testing.csproj" />
    <ProjectReference Include="..\TabStudio.Services.Tests\TabStudio.Services.Tests.csproj" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Avalonia publishes its frame metrics (layout, render and compositor passes) and layout activities only with its
    diagnostics on; the editor's scrolling benchmarks read them. Nothing listens in the other tests.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Avalonia.Diagnostics.Diagnostic.IsEnabled" Value="true" />
  </ItemGroup>

  <!-- The toolchain library's fakes: a tablet with a fake Alpine mirror, for the Toolchain Store's tests. -->
  <ItemGroup>
    <Compile Include="..\TabStudio.Toolchains.Tests\Fakes\*.cs" LinkBase="Toolchains\Fakes" />
    <Compile Include="..\TabStudio.Remote.Tests\SshTestServer.cs" LinkBase="RemoteSsh" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\TabStudio.Porting.Tests\Samples\**\Input\**\*" LinkBase="PortingSamples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
