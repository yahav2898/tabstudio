<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Not used by these tests directly: they put NUnit's and MSTest's assemblies on disk, so the tests can
         compile NUnit and MSTest projects in memory and run them with TabStudio's runner. -->
    <PackageReference Include="NUnit" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TabStudio.TestRunner\TabStudio.TestRunner.csproj" />
    <ProjectReference Include="..\TabStudio.Testing\TabStudio.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
