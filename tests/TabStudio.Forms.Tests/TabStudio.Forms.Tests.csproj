<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the Windows Forms layer: layout, events, controls and the message loop, run on a Forms thread of their
    own as apps are, with Avalonia's headless platform measuring and drawing text. Screenshots of rendered forms are
    written to TABSTUDIO_SCREENSHOTS, or to ci-out/forms-screenshots at the repository root, which CI publishes.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TabStudio.Forms\TabStudio.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
