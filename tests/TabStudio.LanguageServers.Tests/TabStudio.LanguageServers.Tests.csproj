<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the language server and debug adapter clients: against scripted servers and adapters in the same
    process, and, when they are installed (as on CI), against real ones: Pyright, typescript-language-server and
    debugpy.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TabStudio.LanguageServers\TabStudio.LanguageServers.csproj" />
    <ProjectReference Include="..\TabStudio.Testing\TabStudio.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
