<Project>

  <!--
    Settings shared by every project in the repository.
    Package versions live in Directory.Packages.props (central package management).
  -->

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Quality">
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Runtime">
    <!-- .NET 10 disables this feature switch in Release hosts. The optimized IDE and Release test hosts must
         still be able to update the user's dynamically emitted Debug assemblies (Android Mono checks it too). -->
    <MetadataUpdaterSupport>true</MetadataUpdaterSupport>
  </PropertyGroup>

  <PropertyGroup Label="Product">
    <Product>TabStudio</Product>
    <Authors>TabStudio contributors</Authors>
    <Copyright>Copyright © TabStudio contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yahav2898/tabstudio</RepositoryUrl>
    <Version>0.20.1</Version>
  </PropertyGroup>

  <PropertyGroup Label="Projects">
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Libraries document their public surface; a missing XML comment is a warning there. -->
  <PropertyGroup>
    <TabStudioDocumentedLibraries>TabStudio.Core;TabStudio.Compilation;TabStudio.Packages;TabStudio.TestRunner;TabStudio.Debugging;TabStudio.LiveTesting;TabStudio.Notebooks;TabStudio.SourceControl;TabStudio.Agent;TabStudio.Link;TabStudio.LanguageServers;TabStudio.Web;TabStudio.Wpf;TabStudio.Swarm;TabStudio.Live;TabStudio.WindowsBridge;TabStudio.WindowsBridge.Windows;TabStudio.Uno;TabStudio.Porting</TabStudioDocumentedLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsTestProject)' != 'true' AND $([System.String]::Copy(';$(TabStudioDocumentedLibraries);').Contains(';$(MSBuildProjectName);'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
